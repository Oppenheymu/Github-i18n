		"settings/expires-on-nov": "$<year> 年 11 月 $<day> 日",
		"settings/expires-on-dec": "$<year> 年 12 月 $<day> 日",
		// 屏蔽用户备注框的剩余字数与「离开组织」确认弹窗（组织名按原样带回）
		"settings/characters-remaining": "剩余 $1 个字符。",
		"settings/leave-organization-confirm": "你确定要离开 $1 吗？你将失去对所有仓库和团队的访问权限。",
		// 代码空间设置页的仓库选择器计数（数字按原样带回）
		"settings/selected-repositories-count": "已选择 $1 个仓库。",
		// 软件包设置页的空状态（用户名按原样带回）
		"settings/no-recoverable-packages": "未找到 $1 的可恢复软件包。",
		// Copilot 功能设置页的用量百分比
		"settings/copilot-usage-percent": "已使用 $1%",
		// 安全与分析页的私密漏洞报告确认句（账户名按原样带回）
		"settings/enable-private-vulnerability-reporting-all": "你即将在 $1 的所有公开仓库中启用私密漏洞报告。",
		"settings/disable-private-vulnerability-reporting-all": "你即将在 $1 的所有公开仓库中禁用私密漏洞报告。",
		// 已授权应用列表（应用名按原样带回）
		"settings/applications-count": "$1 个应用",
		"settings/report-application": "举报 $1",
		"settings/revoke-application": "撤销 $1",
		"settings/reporting-application-abuse": "举报 $1 将就应用上的滥用行为联系支持团队。",
		"settings/application-account-revoke-notice": "$1 将无法再访问你的 GitHub 账户。此操作无法撤销。",
		"settings/application-api-revoke-notice": "$1 将无法再访问 GitHub API。此操作无法撤销。",
		// 安全日志页的事件行 2（应用名按原样带回）
		"settings/audit-removed-oauth-authorization": "已移除对 OAuth 应用（$1）的授权",
		// —— 账单页（/account/billing）的动态用量说明 ——
		// 区间按月全展开（与 insights/range-long-* 同一形态）：pattern 里写死英文月份
		// 全称，模板里写死对应中文月份。之所以逐组合展开、而不是用捕获组，是因为
		// 模板引用月名会渲染出英文 September，而引擎的替换模板不支持函数映射。
		// 同月区间只写一次月份（9 月 1 日 – 30 日）；跨月区间两个月份都写。
