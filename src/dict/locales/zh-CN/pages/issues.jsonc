// 议题模块：/owner/repo/issues（列表与详情页）专属词条
// 模块头即路由说明：两段仓库路径下的 issues 子树
// 注：查询语法 token（is:open、sort:comments-desc 等）不收录；
// 「View X profile」「N comments」等含动态值的属性也不收录
// （属性值只查静态词条、不应用正则规则，见 src/content/walker.ts）
// 简体中文 · 模块 pages/issues（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— 列表行元信息（状态徽标与打开时间）——
		"opened": "打开",
		"Status: Open.": "状态：打开。",
		"Status: Closed (completed).": "状态：已关闭（已完成）。",
		"More information available below.": "更多信息见下方。",
		"new release": "新版本",
		// —— 侧栏导航与保存视图 ——
		"Assigned to me": "指派给我的",
		"Created by me": "我创建的",
		"Mentioned": "提及我的",
		"Recent activity": "最近动态",
		"Views": "视图",
		"Types": "类型",
		"Open Issues sidebar navigation": "打开议题侧栏导航",
		"Issues sidebar navigation": "议题侧栏导航",
		"Collapse sidebar": "收起侧栏",
		// —— 搜索与筛选 ——
		"Search Issues": "搜索议题",
		"Suggestions": "建议",
		"Issue filters": "议题筛选器",
		"Filter all issues": "筛选全部议题",
		"Filter by author": "按作者筛选",
		"Filter by milestones": "按里程碑筛选",
		"Filter by projects": "按项目筛选",
		"Filter by assignees": "按指派人筛选",
		"Filter by issue type": "按议题类型筛选",
		"Filter by labels": "按标签筛选",
		", descending": "，降序",
		// —— 新版 React 筛选面板（2026-10-23 维护者实机 DOM）——
		"Filter authors": "筛选作者",
		"Filter labels": "筛选标签",
		"Filter by label": "按标签筛选",
		"Recent": "最近",
		"Filter by project": "按项目筛选",
		"Filter projects": "筛选项目",
		"Items will be filtered as you type": "输入时将筛选条目",
		"No projects were found": "未找到项目",
		"Please try a different search query.": "请尝试其他搜索查询。",
		"Filter by milestone": "按里程碑筛选",
		"Filter milestones": "筛选里程碑",
		"No milestone": "无里程碑",
		"Milestone results": "里程碑结果",
		"Filter assignees": "筛选指派人",
		"No assignees": "无指派人",
		// —— 新版排序菜单（按创建时间 / 最后更新 / 评论数 / 匹配度 / 回应排序）——
		"Created on": "创建时间",
		"Last updated": "最近更新",
		"Total comments": "评论总数",
		"Best match": "最佳匹配",
		"Reactions": "回应",
		// —— 空结果态（React Blankslate）——
		"No results matched your search": "没有与你的搜索匹配的结果",
		"Try a different search query.": "请尝试其他搜索查询。",
		"Learn more about searching and filtering issues and pull requests.": "详细了解如何搜索和筛选议题与拉取请求。",
		// —— 上一行帮助链接的新版拆节点形态（2026-10-24 实机：链接内拆成三段，
		// 句号是独立纯符号节点不收录）。译文按拼接语义拆分，前段尾随空格由引擎保留，
		// 拼接结果「详细了解如何搜索和筛选 议题与拉取请求.」；整句键保留给旧版渲染 ——
		"Learn more about searching and filtering": "详细了解如何搜索和筛选",
		"issues and pull requests": "议题与拉取请求",
		// —— 列表排序菜单与新建入口（既有词条，恢复保留）——
		"Newest": "最新",
		"Oldest": "最早",
		"Most commented": "评论最多",
		"Least commented": "评论最少",
		"Recently updated": "最近更新",
		"Least recently updated": "最早更新",
		"New label": "新建标签",
		"New milestone": "新建里程碑",
		// —— 详情页操作按钮（既有词条，恢复保留）——
