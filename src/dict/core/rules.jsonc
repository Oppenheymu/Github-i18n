// 共享正则规则（运行时）：pattern 与语言无关，只有替换模板分语言——
// 模板在 locales/<语言>/rules.jsonc 里按 id 对应（缺 id = 该语言尚未翻译该规则，规则不生效）。
//
// 顺序即语义：pattern 对整段已 trim 文本 test，首条命中生效。模块分组顺序与
// core/modules.jsonc 一致（global 兜底在最后）；模块内顺序由本文件定。
// 规则不得带 flags 字段（g / y 的 lastIndex 会跨节点累积导致漏翻）。
// JSONC 转义：正则 \d 在此写作 \\d（写漏一层 Bun 直接报 Syntax Error，不会静默变义）。
{
	"$schema": "../types/dict.schema.json",
	"modules": [
		{
			"name": "pages/issues",
			"rules": [
				// 列表行归属与文档标题（仓库名保留原文）
				{
					"id": "issues/in-repo",
					"pattern": "^In ([^/]+\\/[^/]+);$"
				},
				{
					"id": "issues/page-title",
					"pattern": "^Issues \\u00B7 (.+) \\u00B7 GitHub$"
				},
				// 「opened on <日期>」日期段，月份缩写保留原文（与 search.jsonc 同款）
				{
					"id": "issues/on-date",
					"pattern": "^on ([A-Z][a-z]{2} \\d{1,2}, \\d{4})$"
				},
				// 列表行「N linked PRs」关联拉取请求计数（单复数折叠；
				// 仅覆盖文本节点，属性值不应用正则规则，见模块头注释）
				{
					"id": "issues/linked-prs-count",
					"pattern": "^(\\d+) linked PRs?$"
				}
			]
		},
		{
			"name": "pages/pulls",
			"rules": [
				// 合并横幅（计数可变）：wants to merge N commit(s) into <基线分支>
				{
					"id": "pulls/merge-commits-into",
					"pattern": "^wants to merge (\\d+) commits? into$"
				},
				// 折叠时间线与侧栏参与者计数
				{
					"id": "pulls/hidden-items-count",
					"pattern": "^(\\d+) hidden items?$"
				},
				{
					"id": "pulls/participants-count",
					"pattern": "^(\\d+) participants?$"
				},
				// 页面文档标题：列表页与详情页（仓库名 / PR 标题保留原文）
				{
					"id": "pulls/page-title",
					"pattern": "^Pull requests \\u00B7 (.+) \\u00B7 GitHub$"
				},
				{
					"id": "pulls/pull-request-title-with-number",
					"pattern": "^(?<title>.+) \\u00B7 Pull Request #(?<number>\\d+) \\u00B7 (?<repo>[^/]+\\/[^/]+) \\u00B7 GitHub$"
				},
				{
					"id": "pulls/pull-request-title-with-number-plain",
					"pattern": "^(?<title>.+) \\u00B7 Pull Request #(?<number>\\d+) \\u00B7 (?<repo>[^/]+\\/[^/]+)$"
				}
			]
		},
		{
			"name": "pages/settings-security",
			"rules": [
				// —— 通行密钥（/settings/security）——
				// 密钥名是用户自命名的动态值（实机形如 `CanoKey Main`），含它的整句只能靠规则。
				// 反引号是 GitHub 文案自带的字符（不是 <code> 元素：实机里整句是单个文本节点；
				// 若哪天改成 <code> 包裹，整句会被拆成多节点、这些规则自然失效，届时按节点重收）。
				// 单捕获组按约定用 $1（命名组约定见 docs/guides/development.md）。
				{
					"id": "settings/passkey-delete-confirm",
					"pattern": "^Are you sure you want to delete your `(.+)` passkey\\?$"
				},
				{
					"id": "settings/passkey-delete-cancel",
					"pattern": "^Cancel `(.+)` passkey delete$"
				},
				{
					"id": "settings/passkey-delete-confirm-button",
					"pattern": "^Confirm delete `(.+)` passkey$"
				},
				{
					"id": "settings/passkey-delete-confirm-of",
					"pattern": "^Confirm delete of `(.+)` passkey$"
				},
				{
					"id": "settings/passkey-delete-label",
					"pattern": "^Delete `(.+)` passkey$"
				},
				// —— 通行密钥 / 邮箱 / 账户 / 设备的计数（各区块的摘要行）——
				// 单捕获组按约定用 $1，不命名。
				{
					"id": "settings/passkeys-configured-count",
					"pattern": "^(\\d+) passkeys? configured$"
				},
				{
					"id": "settings/verified-emails-configured-count",
					"pattern": "^(\\d+) verified emails? configured$"
				},
				{
					"id": "settings/connected-accounts-count",
					"pattern": "^(\\d+) accounts? connected$"
				},
				{
					"id": "settings/devices-count",
					"pattern": "^(\\d+) devices?$"
				},
				// —— 通行密钥行的「添加于 <日期> | 上次使用 <相对时间>」——
				// 实机是**单个文本节点**，形如
				//   "Added on Mar 6, 2026\n        | Last used\n        6 days ago"
				// （自带源码换行与缩进，引擎先折叠空白再匹配，故 pattern 里是单空格）。
				// 两句都含动态值，而**月份与相对时间都无法用捕获组映射成中文**（模板引用捕获组
				// 只会渲染出英文 Mar / 6 days ago），因此只能按月 × 相对时间形态全展开：
				// 12 个月份缩写 × 10 种相对时间 = 120 条。未覆盖的形态（last week、绝对日期等）
				// 整节点保留英文——规则以 ^…$ 锚定、不做部分替换，故不会产出中英残句。
				// **「about」前缀**（2026-09 补丁）：GitHub 小时档的相对时间渲染成
				// "about 1 hour ago"（漏翻导出在 /settings/security 抓到
				// "Added on Mar 6, 2026 | Last used about 1 hour ago"），故 hours 形态的
				// pattern 统一放宽为 `(?:about )?(?<count>\\d+) hours? ago`——只改 pattern、
				// 各语言模板不动（模板只引用 $<count>）。分钟 / 天等档位没有 about 形态的
				// 实证，保持原样；若哪天抓到，按同一手法放宽对应档位即可。
				// 这批规则也正是本页单独成模块的原因（挂在 pages/settings 下会让 /settings 的
				// 其余探针各自背上一百多条永不使用的 id，见 core/modules.jsonc）。
				// 形态之间互不重叠，故组内顺序不影响结果；分组只为可读性。
				{
					"id": "settings/passkey-added-last-used-jan-now",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used just now$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-lt-minute",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than a minute ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-minutes",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) minutes? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-lt-hour",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than an hour ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-hours",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?:about )?(?<count>\\d+) hours? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-yesterday",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used yesterday$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-days",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) days? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-weeks",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) weeks? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-months",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) months? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jan-years",
					"pattern": "^Added on Jan (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) years? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-now",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used just now$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-lt-minute",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than a minute ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-minutes",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) minutes? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-lt-hour",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than an hour ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-hours",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?:about )?(?<count>\\d+) hours? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-yesterday",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used yesterday$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-days",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) days? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-weeks",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) weeks? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-months",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) months? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-feb-years",
					"pattern": "^Added on Feb (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) years? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-now",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used just now$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-lt-minute",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than a minute ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-minutes",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) minutes? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-lt-hour",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than an hour ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-hours",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?:about )?(?<count>\\d+) hours? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-yesterday",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used yesterday$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-days",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) days? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-weeks",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) weeks? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-months",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) months? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-mar-years",
					"pattern": "^Added on Mar (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) years? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-now",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used just now$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-lt-minute",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than a minute ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-minutes",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) minutes? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-lt-hour",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than an hour ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-hours",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?:about )?(?<count>\\d+) hours? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-yesterday",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used yesterday$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-days",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) days? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-weeks",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) weeks? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-months",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) months? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-apr-years",
					"pattern": "^Added on Apr (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) years? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-now",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used just now$"
				},
				{
					"id": "settings/passkey-added-last-used-may-lt-minute",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than a minute ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-minutes",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) minutes? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-lt-hour",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than an hour ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-hours",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?:about )?(?<count>\\d+) hours? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-yesterday",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used yesterday$"
				},
				{
					"id": "settings/passkey-added-last-used-may-days",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) days? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-weeks",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) weeks? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-months",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) months? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-may-years",
					"pattern": "^Added on May (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) years? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-now",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used just now$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-lt-minute",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than a minute ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-minutes",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) minutes? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-lt-hour",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used less than an hour ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-hours",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?:about )?(?<count>\\d+) hours? ago$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-yesterday",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used yesterday$"
				},
				{
					"id": "settings/passkey-added-last-used-jun-days",
					"pattern": "^Added on Jun (?<day>\\d{1,2}), (?<year>\\d{4}) [|] Last used (?<count>\\d+) days? ago$"
				},
				{
