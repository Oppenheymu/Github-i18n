// リポジトリのセキュリティセンターモジュール：/owner/repo/security とそのサブパス
// （advisories / code-scanning / dependabot / malware / policy / quality / secret-scanning）
// 日本語 · モジュール pages/security（ルートは core/modules.jsonc、キーの分割コメントは
// core/canonical.jsonc を参照）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— 左側ナビ（全サブページ共通）；Dependabot / CodeQL と言語名は翻訳しない ——
		"Advisories": "アドバイザリ",
		"Code scanning": "コードスキャン",
		"Code quality": "コード品質",
		"Malware": "マルウェア",
		"Secret scanning": "シークレットスキャン",
		"Vulnerabilities": "脆弱性",
		"Findings": "検出結果",
		"Reporting": "レポート",
		// pages/actions の同名キーと同一訳（agents タブ）
		"Agents": "エージェント",
		// リポジトリ切替メニューの sr-only 末尾；pages/profile、pages/queue と同一訳
		"items": "件",
		// —— セキュリティ概要・品質ページの Code Quality 空状態 ——
		"Checking code scanning status...": "コードスキャンの状態を確認しています…",
		"Code Quality is not enabled for this repository": "このリポジトリではコード品質が有効になっていません",
		"Enable Code Quality": "コード品質を有効にする",
		"Enable Code Quality to start identifying and fixing code quality issues in your repository.": "コード品質を有効にして、リポジトリ内のコード品質の問題の特定と修正を始めましょう。",
		"Learn more about Code Quality": "コード品質について詳しく見る",
		// —— セキュリティアドバイザリページ ——
		"Security Advisories": "セキュリティアドバイザリ",
		"New draft security advisory": "新しいセキュリティアドバイザリの下書き",
		"Privately discuss, fix, and publish information about security vulnerabilities in your repository's code.": "リポジトリのコードにおけるセキュリティ脆弱性の情報を、非公開で議論・修正・公開します。",
		"Sort advisories": "アドバイザリを並べ替え",
		"There aren't any published security advisories": "公開済みのセキュリティアドバイザリはありません",
		"Edit this file": "このファイルを編集",
		// —— アラート一覧（コードスキャン / Dependabot / マルウェア / シークレットスキャン共通）——
		"Loading tools": "ツールを読み込み中",
		"Tools": "ツール",
		"Tool": "ツール",
		"All alerts are resolved.": "すべてのアラートは解決済みです。",
		// dismiss はアラート処置の慣例に従い「無視」と訳す
		"Dismiss alerts": "アラートを無視",
		// 重要度の選択肢：insights の Critical 重大 / High 高 体系に合わせて残りを補完
		"Error": "エラー",
		"Warning": "警告",
		"Note": "注意",
		"Medium": "中",
		"Low": "低",
		"Other": "その他",
		"Most important": "最重要",
		"Filter alerts": "アラートをフィルター",
		"Filter by language": "言語でフィルター",
		"Filter by rule": "ルールでフィルター",
		"Filter by severity": "重要度でフィルター",
		"Filter by tool": "ツールでフィルター",
		"Keep up the good work!": "この調子で続けましょう！",
		// 並べ替えメニュー：pages/issues、pages/search と同一訳
		"Newest": "新しい順",
		"Oldest": "古い順",
		"Least recently updated": "更新が古い順",
		"Rule": "ルール",
		"Severity": "重要度",
		// 複数選択後の sr-only 状態語（小文字の汎用語につき本モジュールでのみ有効）
		"selected": "選択済み",
		"Clear filter": "フィルターをクリア",
		"Dependabot alerts": "Dependabot アラート",
		"Malware alerts": "マルウェアアラート",
		// ページ見出し。隣接する日付ノード（global の日付ルールで翻訳）が続く
		"Dependency files checked": "依存関係ファイルを確認済み",
		"Filter alerts by state": "状態でアラートをフィルター",
		"Filter and sort alerts": "アラートをフィルターして並べ替え",
		"No open alerts": "オープンなアラートはありません",
		// ProTip 説明文の断片：リンク（scope:development / resolution:auto-dismissed）は
		// クエリ構文につき未収録、句点は独立した記号ノードにつき未収録。
		// 前段は結合語順に合わせて意訳
		"Find alerts on your dev dependencies using": "開発依存関係のアラートを見つけるには",
		"See auto-dismissed alerts with": "自動的に無視されたアラートを表示するには",
		"Search or filter alerts": "アラートの検索またはフィルター",
		"Suggestions": "提案",
		// pages/notifications などの同名キーと同一訳
		"ProTip!": "プロのヒント！",
		"The libraries and queries that power CodeQL are open-source.": "CodeQL を支えるライブラリとクエリはオープンソースです。",
		"You can configure CodeQL to run with additional queries.": "追加のクエリで CodeQL を実行するように設定できます。",
		"There are no open Dependabot alerts for this repository.": "このリポジトリにオープンな Dependabot アラートはありません。",
		"There are no open Malware alerts for this repository.": "このリポジトリにオープンなマルウェアアラートはありません。",
		// —— シークレットスキャン（secret-scanning と policy ページで共通）——
		"No secrets found.": "シークレットが見つかりません。",
		"Secret scanning alerts": "シークレットスキャンアラート",
		"Validity": "有効性",
		"Secret type": "シークレットの種類",
		"Provider": "プロバイダー",
		"Select all alerts": "すべてのアラートを選択",
		"Select provider option": "プロバイダーのオプションを選択",
		"Select secret type option": "シークレットの種類のオプションを選択",
		"Select sort option": "並べ替えのオプションを選択",
		"Select validity option": "有効性のオプションを選択",
		"Search or filter": "検索またはフィルター",
		"Your repository doesn't have any unresolved secrets.": "このリポジトリに未解決のシークレットはありません。",
		// シークレット有効性の選択肢：Active=検証して有効、Unknown=検証できない
		"Active": "有効",
		"Unknown": "不明",
		"Custom Patterns": "カスタムパターン",
		"Service Providers": "サービスプロバイダー",
		"Filter provider": "プロバイダーをフィルター",
		"Filter secret type": "シークレットの種類をフィルター",
		// —— 2026-10-25 の2回目の書き出しで補完（フィルターバー、アドバイザリ 4 タブの
		// 空状態、ダイアログとページ見出しメニュー）——
		"Available filters": "利用可能なフィルター",
		"Clear current search query, filters, and sorts": "現在の検索クエリ、フィルター、並べ替えをクリア",
		"Clear filters": "フィルターをクリア",
		// アドバイザリ 4 タブの空状態見出し（公開済みは上で収録済み）
		"There aren't any triage security advisories": "トリアージのセキュリティアドバイザリはありません",
		"There aren't any draft security advisories": "下書きのセキュリティアドバイザリはありません",
		"There aren't any closed security advisories": "クローズ済みのセキュリティアドバイザリはありません",
		// 件数なし形の aria-label。「: N valid filter」付きはルールで処理
		"Advanced filter dialog": "詳細フィルターダイアログ",
		// SelectPanel 絞り込みダイアログ（パッケージ / マニフェスト / エコシステム / 重要度で共通）
		"Filter items": "項目をフィルター",
		"Items will be filtered as you type": "入力すると項目が絞り込まれます",
		"No options available": "利用できるオプションがありません",
		// 「Refresh Dependabot alerts」メニュー項目は Refresh / <製品名> / alerts の 3 ノードに
		// 分割；「alerts」は小文字の汎用語につき本モジュールでのみ有効
		"Refresh": "更新",
		"alerts": "アラート",
		"Reprocess your project's current dependency files.": "プロジェクトの現在の依存関係ファイルを再処理します。",
		// ページ見出しのオーバーフローメニュー
		"Give feedback": "フィードバック",
		"Manage Advanced Security": "Advanced Security を管理",
		"Manage Dependabot rules": "Dependabot ルールを管理",
		"Manage account notifications": "アカウントの通知を管理",
		"Opens in a new tab": "新しいタブで開きます",
		"Filter by manifest": "マニフェストでフィルター",
		"Filter by package": "パッケージでフィルター",
		"Filter by ecosystem": "エコシステムでフィルター",
		"Search manifest options": "マニフェストのオプションを検索",
		"Search package options": "パッケージのオプションを検索",
		"Search ecosystem options": "エコシステムのオプションを検索",
		"Search severity options": "重要度のオプションを検索",
		"Manifest": "マニフェスト",
		"Package": "パッケージ",
		"Manifest path": "マニフェストパス",
		"Package name": "パッケージ名",
		// ProTip 断片：「Add -has:patch to see…」の 3 ノード結合（リンクはクエリ構文につき未収録）
		"Add": "追加",
		"to see alerts without an available fix.": "すると、利用可能な修正のないアラートが表示されます。",
		// アラート一覧 section の aria-label（クエリ構文と同形だが本モジュールでのみ有効）
		"open alerts": "オープンなアラート",
		// —— 2026-10-25 三次エクスポートの補漏（アラート空状態、「Closed as」
		// フィルターグループ、Dependabot / マルウェアの空状態）——「GitHub」
		// （<link title> のメタデータ）、ブランド名と言語名の裸語（Dependabot /
		// CodeQL / Shell / TypeScript）、クエリ構文（is:open / scope:development /
		// resolution:auto-dismissed）、CodeQL のアラートタイトルとルール ID、
		// アバター alt、relative-time の動的な日付 title は未収録
		// —— アラート空状態（コードスキャンの骨格、他のアラート頁でも事前描画）——
		"There aren't any code scanning alerts yet": "コードスキャンのアラートはまだありません",
		"As alerts are created, they'll appear here.": "アラートが作成されると、ここに表示されます。",
		// pages/issues の句点なし版と同じ訳（このキーは句点を含む）
		"No results matched your search.": "検索に一致する結果がありません。",
		"You can upload code scanning analyses from other third-party tools using GitHub Actions.": "GitHub Actions を使用して、他のサードパーティツールによるコードスキャン解析をアップロードできます。",
		"You can run CodeQL locally using Visual Studio Code.": "Visual Studio Code を使用して、ローカルで CodeQL を実行できます。",
		"You can run CodeQL locally from the command line.": "コマンドラインからローカルで CodeQL を実行できます。",
		// —— 「Closed as」フィルターグループ（4 つのアラート一覧頁で共用の React
		// フィルターパネル）——
		"Closed as": "クローズ理由",
		"Filter by closed as": "クローズ理由でフィルター",
		"Filter by closure reason": "クローズ理由でフィルター",
		"Select closed as option": "クローズ理由のオプションを選択",
		"Search closed as options": "クローズ理由のオプションを検索",
		// コードスキャンのクローズ理由オプション
		"All dismissed": "すべて無視",
		"False positive": "誤検知",
		"Used in tests": "テストで使用",
		"Won't fix": "修正しない",
		"Mitigated": "緩和済み",
		// Dependabot アラートのクローズ理由オプション
		"Auto-dismissed": "自動的に無視",
		"Fix started": "修正を開始",
		"Inaccurate": "不正確",
		"No bandwidth": "対応できない",
		"Not used": "未使用",
		"Tolerable risk": "許容できるリスク",
		// 「Fixed」は裸語だが security ルートでのみ有効
		"Fixed": "修正済み",
		"Reopen": "再オープン",
		"Some selected alerts have been fixed and cannot be reopened.": "選択したアラートの一部は修正済みのため、再オープンできません。",
		// —— クローズ済みアラートの空状態（Dependabot / マルウェアで共用）——
		"No closed alerts": "クローズされたアラートはありません",
		"There are no closed Dependabot alerts for this repository.": "このリポジトリにクローズされた Dependabot アラートはありません。",
		"closed alerts": "クローズされたアラート",
		// マルウェアアラート無効時の空状態とメニュー説明。説明文の「in」の後ろに
		// リンクノードが続く結合で、末尾の句点は独立ノードにつき未収録のため、
		// 前段はコロンで終える
		"Malware alerts are disabled.": "マルウェアアラートは無効です。",
		"To receive Malware alerts, you must first enable Malware alerts in": "マルウェアアラートを受け取るには、まず次の場所でマルウェアアラートを有効にする必要があります：",
		"this repository's settings": "このリポジトリの設定",
		"alerts are not enabled.": "アラートが有効になっていません。",
		"Refresh is unavailable.": "更新は利用できません。",
		// シークレットスキャン空状態の Try 文の 3 ノード結合（リンクはノード 2、
		// ノード間の空白はエンジンが保持）
		"Try": "試しに",
		"clearing filters": "フィルターをクリアする",
		"to view all of this repository's secret alerts.": "と、このリポジトリのすべてのシークレットアラートが表示されます。"
	}
}
