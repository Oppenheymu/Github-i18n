#!/bin/sh
# 署名纪律（见 AGENTS.md「git 提交流程」）：提交信息缺失 Co-authored-by 时自动补一行。
# 已有署名、或消息含 git commit -v 的裁剪行（追加也会被裁掉）时不动，交由提交者自查。

COAUTHOR="Co-authored-by: PaperKoi001 <337530007+PaperKoi001@users.noreply.github.com>"

# $2 是提交来源：merge 与 rebase 的 squash 提交不属于工作提交，不加署名
case "$2" in
	merge | squash | commit-template) exit 0 ;;
esac

[ -f "$1" ] || exit 0
grep -qi "^co-authored-by: paperkoi001" "$1" && exit 0
grep -q "^# ------------------------ >8" "$1" && exit 0

# 消息以换行结尾，再空一行接 trailer，Git 才会把它解析为 trailer 而非正文
[ -n "$(tail -c 1 "$1")" ] && printf '\n' >> "$1"
printf '\n%s\n' "$COAUTHOR" >> "$1"
