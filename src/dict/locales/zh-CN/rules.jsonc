		"settings/usage-range-cross-dec-oct": "$<year> 年 12 月 $<startDay> 日 – 10 月 $<endDay> 日",
		"settings/usage-range-cross-dec-nov": "$<year> 年 12 月 $<startDay> 日 – 11 月 $<endDay> 日",
		// 账单卡片上的计费周期后缀。实机（2026-09 实录）把「per month」渲染成两个文本节点
		// ——`per `（带尾随空格）+ `month`——故拆两条碎片规则：per-word 的模板是**空串**
		// （「该节点在目标语言里整个消失」，引擎会连同它的首尾空白一起清空，不留空格），
		// billing-period-word 把 `month` 译「每月」。净效果就是卡片上的「每月」。
		// pattern 只能是 `^per$` / `^month$`：规则是对**归一化后**的文本匹配，尾随空白已被 trim
		"settings/per-word": "",
		"settings/billing-period-word": "每月",
		// 旧斜杠形态（`$20 /month`）的兜底，实机已不用；确认上游弃用后可删
		"settings/per-month": "每月",
		"settings/per-year": "每年",
		"settings/per-day": "每天",
		// 付款信息页组织提示句里被链接切出来的独立冠词节点 `the`：中文没有冠词，
		// 空模板让该节点整个消失（连同首尾空白），与 settings/per-word 同一手法
		"settings/article-the": "",
		// 额度摘要：两处单位恒相同，pattern 用 \k<unit> 反向引用，模板引用同一个命名组
		"settings/storage-used-included": "已用 $<used> $<unit> / 包含 $<included> $<unit>",
		"settings/minutes-used-included": "已用 $<used> 分钟 / 包含 $<included> 分钟",
