				},
				// —— 强制启用 2FA 的提示横幅（第三段含动态截止日）——
				// 实机节点边界：`Some GitHub users are` + <a>now required</a> +
				// ` to enable two-factor authentication … before April 30, 2026, otherwise … on that date.`
				// 前两段是静态词条，第三段跨两行且含动态截止日，故按月全称全展开 12 条。
				{
					"id": "settings/two-factor-deadline-january",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before January (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-february",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before February (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-march",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before March (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-april",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before April (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-may",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before May (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-june",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before June (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-july",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before July (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-august",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before August (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-september",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before September (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-october",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before October (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-november",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before November (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				},
				{
					"id": "settings/two-factor-deadline-december",
					"pattern": "^to enable two-factor authentication as an additional security measure\\. Your activity on GitHub includes you in this requirement\\. You will need to re-enable two-factor authentication on your account before December (?<day>\\d{1,2}), (?<year>\\d{4}), otherwise your account will be restricted on that date\\.$"
				}
			]
		},
		{
			"name": "pages/settings",
			"rules": [
				// 导出数据的可用天数。实机节点边界：句号属于用户名链接节点，
				// 故本句所在文本节点的值形如 ".\n      Exports will be available for 7 days."，
				// pattern 必须容忍可选的前导 ". "（纯句号节点翻译不了，跳过即可）
				{
					"id": "settings/export-available",
					"pattern": "^[.]?\\s*Exports will be available for (\\d+) days?\\.$"
				},
				// 删除账号区块：「你的账户目前是以下组织的所有者：」这个句子节点不含清单
				// （清单是同级 <strong>），故冒号后允许为空；组织名保留原文
				{
					"id": "settings/owner-organizations",
					"pattern": "^Your account is currently an owner in these organizations:(?: (.+))?$"
				},
				// 会话页（/settings/sessions）会话卡的「曾出现地区」：实机是**单个文本节点**，
				// 形如 "Seen in US, KR, CN"——国家码是动态值（条数不定），静态键只能覆盖
				// 见过的组合，故整句交给规则，国家码按原样带回（单捕获组用 $1，不命名）。
				// pattern 以 ^…$ 锚定：不含 "Seen in " 前缀的节点一律不动，不会产出残句。
				{
					"id": "settings/session-seen-in",
					"pattern": "^Seen in (.+)$"
				},
				// —— 凭据 / 开发者设置一族（/settings/credentials、apps、developers、tokens、
				// personal-access-tokens）——
				// 凭据总览卡片的计数行：实机是**单个文本节点**（"0 keys" / "3 tokens" /
				// "18 OAuth apps" / "4 GitHub Apps"），数字是动态值，故各形态一条规则；
				// 单捕获组用 $1，不命名（命名组约定见 docs/guides/development.md）。
				// 注意 "GitHub Apps" 的 A 在实机里是大写（产品名），"OAuth apps" 是小写 a。
				{
					"id": "settings/credentials-keys-count",
					"pattern": "^(\\d+) keys?$"
				},
				{
					"id": "settings/credentials-tokens-count",
					"pattern": "^(\\d+) tokens?$"
				},
				{
					"id": "settings/credentials-oauth-apps-count",
					"pattern": "^(\\d+) OAuth apps?$"
				},
				{
					"id": "settings/credentials-github-apps-count",
					"pattern": "^(\\d+) GitHub Apps?$"
				},
				// 经典令牌行的过期日期：实机节点形如 "on Fri, Nov 27 2026" / "on Wed, Sep  2 2026"
				// （周几缩写 + 月份缩写 + **空格补齐的日**，年份前无逗号）。月份无法经捕获组映射成
				// 中文，故按 12 个月份全展开；周几用 [A-Za-z]{3} 吃掉、中文里不体现
				// （「2026 年 11 月 27 日」已足够表达，且周几与日期绑定无歧义）。
				// 日与月之间的多个空格用 + 容忍（实机 "Sep  2" 是两个空格）。
				{
					"id": "settings/expires-on-jan",
					"pattern": "^on [A-Za-z]{3}, Jan +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-feb",
					"pattern": "^on [A-Za-z]{3}, Feb +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-mar",
					"pattern": "^on [A-Za-z]{3}, Mar +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-apr",
					"pattern": "^on [A-Za-z]{3}, Apr +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-may",
					"pattern": "^on [A-Za-z]{3}, May +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-jun",
					"pattern": "^on [A-Za-z]{3}, Jun +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-jul",
					"pattern": "^on [A-Za-z]{3}, Jul +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-aug",
					"pattern": "^on [A-Za-z]{3}, Aug +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-sep",
					"pattern": "^on [A-Za-z]{3}, Sep +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-oct",
					"pattern": "^on [A-Za-z]{3}, Oct +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-nov",
					"pattern": "^on [A-Za-z]{3}, Nov +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				{
					"id": "settings/expires-on-dec",
					"pattern": "^on [A-Za-z]{3}, Dec +(?<day>\\d{1,2}) (?<year>\\d{4})$"
				},
				// —— 交互限制 / 已屏蔽用户 / 组织（同属本模块的四条路径）——
				// 屏蔽用户的备注框下方会实时更新剩余字数，实机形如 "250 characters remaining."
				// （数字动态，单数 / 复数同形），单捕获组用 $1。
				{
					"id": "settings/characters-remaining",
					"pattern": "^(\\d+) characters? remaining\\.$"
				},
				// 组织列表的「离开组织」确认弹窗：整句含动态组织名（实机节点是单个文本节点），
				// 组织名按原样带回。注意 `Settings for <组织名>` 那条是 **aria-label**——
				// 属性不适用规则，故它只能保留英文（见 canonical 的同页注释）。
				{
					"id": "settings/leave-organization-confirm",
					"pattern": "^Are you positive you want to leave (.+)\\? You will lose access to all repositories and teams\\.$"
				},
				// 代码空间设置页（/settings/codespaces）的仓库选择器：实机是**单个文本节点**，
				// 形如 "Selected 0 repositories."（数量动态），单捕获组用 $1。
				// 单复数必须写成 repositor(?:y|ies)：`repositories?` 只折叠末尾的 s，
				// 匹配不到单数 "repository"（这是本次实测踩到的坑，用例已锁住两种形态）。
				{
					"id": "settings/selected-repositories-count",
					"pattern": "^Selected (\\d+) repositor(?:y|ies)\\.$"
				},
				// 软件包设置页（/settings/packages）已删除软件包区块的空状态：整句含动态用户名
				// （实机是单个文本节点），用户名按原样带回；单捕获组用 $1。
				{
					"id": "settings/no-recoverable-packages",
					"pattern": "^No recoverable packages were found for (.+)\\.$"
				},
				// Copilot 功能设置页（/settings/copilot/features）的用量摘要：实机形如 "14% used"
				// （百分比动态），单捕获组用 $1。
				{
					"id": "settings/copilot-usage-percent",
					"pattern": "^(\\d+)% used$"
				},
				// 安全与分析页（/settings/security_analysis）的「全部启用 / 全部禁用」确认句：
				// 只有私密漏洞报告那一对含**动态账户名**（实机形如
				// "…on all public repositories in Oppenheymu."），故整句走规则、账户名按原样带回。
				// 动词不能做成捕获组（模板不支持值映射），因此启用 / 禁用各一条规则。
				{
					"id": "settings/enable-private-vulnerability-reporting-all",
					"pattern": "^You're about to enable private vulnerability reporting on all public repositories in (.+)\\.$"
				},
				{
					"id": "settings/disable-private-vulnerability-reporting-all",
					"pattern": "^You're about to disable private vulnerability reporting on all public repositories in (.+)\\.$"
				},
				// —— /settings/applications 与 /settings/apps/authorizations ——
				// 已授权应用列表：应用名是用户内容（`Cloudflare` / `gitee.com` / `npm account link` …），
				// 含它的整句只能靠规则、名字按原样带回（单捕获组用 $1）。
				// 注意词典先于规则命中，所以 `Report abuse` / `Revoke all` 这类**同前缀的静态文案**
				// 已在词条里收好，不会被这两条规则截走。
				{
					"id": "settings/applications-count",
					"pattern": "^(\\d+) applications?$"
				},
				{
					"id": "settings/report-application",
					"pattern": "^Report (.+)$"
				},
				{
					"id": "settings/revoke-application",
					"pattern": "^Revoke (.+)$"
				},
				{
					"id": "settings/reporting-application-abuse",
					"pattern": "^Reporting (.+) will contact Support about abuse on the application\\.$"
				},
				// 撤销确认句：OAuth 应用走「访问你的 GitHub 账户」，GitHub App 走「访问 GitHub API」
				{
					"id": "settings/application-account-revoke-notice",
					"pattern": "^(.+) will no longer be able to access your GitHub account\\. You cannot undo this action\\.$"
				},
				{
					"id": "settings/application-api-revoke-notice",
					"pattern": "^(.+) will no longer be able to access the GitHub API\\. You cannot undo this action\\.$"
				}
			]
		},
		{
			"name": "pages/settings-billing",
			"rules": [
				// 账单页（/account/billing）的用量表格：说明句与时间范围常被拆成两个节点
				// （"Gross metered usage for " + 区间），区间本身又是动态的，故按月全展开：
				// 12 条同月 + 132 条跨月，与 insights/range-long-* 同一形态。之所以逐组合
				// 写死月份，是因为替换模板不支持函数映射——把英文月名捕获进模板，中文里
				// 就会渲染出 September（见 src/content/__tests__/settings-billing.test.ts）。
				//
				// 顺序即语义：同月的 12 条以月份字面量锚定，先吃掉「September 1 - September
				// 30, 2026」这类；跨月的 132 条各自写死起止月份，收尾的 (?:\\.)? 同时覆盖
				// 「裸区间」与「带句号」，故两类互不顶替。
				//
				// 另注意：裸区间必须排在 global 的 long-date-* 之前 —— 那些规则以 ^ 锚定
				// 但未以 $ 收尾，会给「September 1 - September 30, 2026」做部分替换，
				// 产出中英混合的残句。
				{
					"id": "settings/usage-range-same-month-jan",
					"pattern": "^January (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-feb",
					"pattern": "^February (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-mar",
					"pattern": "^March (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-apr",
					"pattern": "^April (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-may",
					"pattern": "^May (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
