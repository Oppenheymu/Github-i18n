				},
				{
					"id": "settings/usage-range-cross-dec-sep",
					"pattern": "^December (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-dec-oct",
					"pattern": "^December (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-dec-nov",
					"pattern": "^December (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				// 计费周期后缀。实机形态在 2026-09 期间变过两次，故这里按「由具体到泛化」排：
				//
				//   ① 现在（2026-09 实录，Console 取的节点原文）——PlanCard 把后缀渲染成
				//      **两个文本节点**：`"per "`（码点 70 65 72 20，尾随空格在第一个节点里）
				//      与 `"month"`。引擎逐节点整串精确匹配，所以「整短语 per month」这种键
				//      在实机上永不命中（收集时 textContent 看着是 "per month"，childNodes
				//      却是 2 个，正是这个陷阱）。
				//      修法用两条碎片规则，其中 per-word 的模板是**空串**（表达「该节点在
				//      目标语言里整个消失」，本项目的空模板语义就为此而设）：
				//      per-word 把 `per ` 清空（归一化后是 `per`，故 pattern 写 `^per$`），
				//      billing-period-word 把 `month` 译「每月」。两节点合起来就是卡片上的
				//      「每月」——`"per "` 命中空串后由引擎整节点清空（见 walker.applyTextNode
				//      的 erased 分支），不会留下孤零零的空格。
				//
				//      **pattern 只能写 `^per$`，不能写 `^per\s+$`**：pattern 是对
				//      normalizeKey 之后的文本执行（trim + 折叠空白），尾随空白早就没了，
				//      带 `\s+` 的 pattern 永不命中（与「词典键必须是归一化形态」同源的坑）。
				//      代价：本模块路由内**孤立**的 `per` 节点也会被清空（`per developer`
				//      若被拆成两个节点就会丢掉 per）。2026-09 实机只在计费周期卡上见到
				//      该节点，故接受；真要区分得让引擎把原文空白带进规则匹配，那是引擎
				//      语义改动，不在此处顺手做。
				//
				//   ② 更早——整短语单节点 `per month`（由 pages/settings-billing 的静态键
				//      覆盖，不进规则）。
				//
				//   ③ 最早——斜杠形态 `/month`、`/year`、`/day`：2026-09 实测已不命中任何已知
				//      页面，保留作旧形态 / 回退兜底；确认上游彻底弃用后可删（同时删各语言
				//      模板并 bun run check:view --update）。
				{
					"id": "settings/per-word",
					"pattern": "^per$"
				},
				{
					"id": "settings/billing-period-word",
					"pattern": "^month$"
				},
				{
					"id": "settings/per-month",
					"pattern": "^/month$"
				},
				{
					"id": "settings/per-year",
					"pattern": "^/year$"
				},
				{
					"id": "settings/per-day",
					"pattern": "^/day$"
				},
				// 付款信息页组织提示句（2026-10-07 实机 HTML）被两个链接切成五段，其中
				// ` the ` 是**独立文本节点**：
				//   `… billing information by <a>signing</a> the <a>GitHub Customer Agreement</a>.`
				// 中文没有冠词，该节点应当整个消失——与 settings/per-word 同一手法（空模板，
				// 引擎连同它的首尾空白一起清空）。**代价如实记在此处**：这是本模块覆盖面最广的
				// 短规则（账单 / 许可路由上任何独立节点 `the` 都会被清空），中文里删掉冠词不会
				// 读反，故接受；一旦实机出现删错的地方就删这条规则（同时删各语言模板并
				// `bun run check:view --update` 快照），别加白名单（词典没有白名单）。
				// 副作用：被清空的节点连尾随空格一起消失，故「签署」与后面的链接文字之间
				// 少一个空格（实机渲染「…方法是 签署GitHub 客户协议.」，用例锁住这个形态）
				{
					"id": "settings/article-the",
					"pattern": "^the$"
				},
				// 额度摘要「N GB used / N GB included」「N min used / N min included」：
				// 数字随用量变化。实机上是独立节点，故键不在静态词条里。
				// 两处单位恒相同，故只声明一个命名组 —— JS 正则不允许多个同名的命名组
				// （「Duplicate capture group name」），模板里引用同一个 $<unit> 两次即可
				{
					"id": "settings/storage-used-included",
					"pattern": "^(?<used>[\\d.,]+) (?<unit>GB|MB|TB|KB) used / (?<included>[\\d.,]+) \\k<unit> included$"
				},
				{
					"id": "settings/minutes-used-included",
					"pattern": "^(?<used>[\\d.,]+) min used / (?<included>[\\d.,]+) min included$"
				},
				// —— 「More details」弹窗（所含用量与点数明细）——
				// 弹窗行是「<数量> included <产品> <资源>」，数量随额度变化；产品与资源名
				// 固定，故按资源逐条锚定。折扣列（"~$12.00 off*"）与金额无需翻译。
				{
					"id": "settings/included-actions-minutes",
					"pattern": "^(?<count>[\\d,]+) included Actions minutes$"
				},
				{
					"id": "settings/included-actions-storage",
					"pattern": "^(?<count>[\\d.,]+) (?<unit>GB|MB|TB|KB) included Actions storage$"
				},
				{
					"id": "settings/included-git-lfs-bandwidth",
					"pattern": "^(?<count>[\\d.,]+) (?<unit>GB|MB|TB|KB) included Git LFS bandwidth$"
				},
				{
					"id": "settings/included-git-lfs-storage",
					"pattern": "^(?<count>[\\d.,]+) (?<unit>GB|MB|TB|KB) included Git LFS storage$"
				},
				{
					"id": "settings/included-packages-transfer",
					"pattern": "^(?<count>[\\d.,]+) (?<unit>GB|MB|TB|KB) included Packages data transfer$"
				},
				{
					"id": "settings/included-packages-storage",
					"pattern": "^(?<count>[\\d.,]+) (?<unit>GB|MB|TB|KB) included Packages storage$"
				},
				{
					"id": "settings/included-codespaces-storage",
					"pattern": "^(?<count>[\\d.,]+) (?<unit>GB|MB|TB|KB) included Codespaces storage$"
				},
				{
					"id": "settings/included-codespaces-core-hours",
					"pattern": "^(?<count>[\\d,]+) included Codespaces core hours$"
				},
				// 折扣列：「~$12.00 off」→「约 12.00 抵扣」。金额原样保留，只把 off 译出
				// （纯金额节点翻不了也不必翻）。刻意不给「~」单独开捕获组：可选组未参与
				// 匹配时，模板里的 $<name> 会被当成字面量原样输出（引擎语义），
				// 故用两支把前缀写死进模板。也不吞掉行尾的「*」——它是注解标记，
				// 在实机里常独立成节点，留给它自己更稳
				{
					"id": "settings/discount-approx",
					"pattern": "^~\\$(?<amount>[\\d.,]+) off\\*?$"
				},
				{
					"id": "settings/discount-exact",
					"pattern": "^\\$(?<amount>[\\d.,]+) off\\*?$"
				},
				// —— 用量页（/account/billing/usage）的图表卡片副标题 ——
				// 用量页把账期写成**短月份**形态（截图实证：「Sep 1 - Sep 30, 2026」），
				// 与账单总览的长月份形态是两套写法，故必须另收一组 pattern；同月只写一次月份。
				// 跨月形态（如「Sep 1 - Oct 1, 2026」）暂无实证，未收：global 的 short-date-*
				// 两端都以 ^…$ 锚定，不做部分替换，故未命中只是保留英文，不会产出中英残句。
				{
					"id": "settings/usage-range-short-same-month-jan",
					"pattern": "^Jan (?<startDay>\\d{1,2}) - Jan (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-feb",
					"pattern": "^Feb (?<startDay>\\d{1,2}) - Feb (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-mar",
					"pattern": "^Mar (?<startDay>\\d{1,2}) - Mar (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-apr",
					"pattern": "^Apr (?<startDay>\\d{1,2}) - Apr (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				// May 的缩写与全称同形（都是 May），pattern 会与上方
				// settings/usage-range-same-month-may 逐字符重复。同模块内首条命中生效，
				// 再建一条只会是永不生效的死规则——与 global 里刻意不收 long-date-may 同理
				// （check:dict 现在会拦下同模块内的重复 pattern）。
				{
					"id": "settings/usage-range-short-same-month-jun",
					"pattern": "^Jun (?<startDay>\\d{1,2}) - Jun (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-jul",
					"pattern": "^Jul (?<startDay>\\d{1,2}) - Jul (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-aug",
					"pattern": "^Aug (?<startDay>\\d{1,2}) - Aug (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-sep",
					"pattern": "^Sep (?<startDay>\\d{1,2}) - Sep (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-oct",
					"pattern": "^Oct (?<startDay>\\d{1,2}) - Oct (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-nov",
					"pattern": "^Nov (?<startDay>\\d{1,2}) - Nov (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-short-same-month-dec",
					"pattern": "^Dec (?<startDay>\\d{1,2}) - Dec (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				// —— 用量明细说明句（整节点：句子里带着区间）——
				// 实机原文（Console 实测，2026-09）：`"Usage for Sep 1 - Sep 30, 2026. "` 整段
				// 是一个文本节点（span.UsageTable-module__hintText__*），**不是**「片段 + 区间」
				// 两节点——静态键「Usage for」与上面的裸区间规则都套不上，只能整句锚定。
				// 区间随所选时间范围变化，故按月份逐条展开；句点在节点内，pattern 匹配它、
				// 模板补回「。」（句点写在 year 组**之外**，否则会被渲染成「2026. 年」）。
				{
					"id": "settings/usage-hint-same-month-jan",
					"pattern": "^Usage for Jan (?<startDay>\\d{1,2}) - Jan (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-feb",
					"pattern": "^Usage for Feb (?<startDay>\\d{1,2}) - Feb (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-mar",
					"pattern": "^Usage for Mar (?<startDay>\\d{1,2}) - Mar (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-apr",
					"pattern": "^Usage for Apr (?<startDay>\\d{1,2}) - Apr (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-may",
					"pattern": "^Usage for May (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-jun",
					"pattern": "^Usage for Jun (?<startDay>\\d{1,2}) - Jun (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-jul",
					"pattern": "^Usage for Jul (?<startDay>\\d{1,2}) - Jul (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-aug",
					"pattern": "^Usage for Aug (?<startDay>\\d{1,2}) - Aug (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-sep",
					"pattern": "^Usage for Sep (?<startDay>\\d{1,2}) - Sep (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-oct",
					"pattern": "^Usage for Oct (?<startDay>\\d{1,2}) - Oct (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-nov",
					"pattern": "^Usage for Nov (?<startDay>\\d{1,2}) - Nov (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/usage-hint-same-month-dec",
					"pattern": "^Usage for Dec (?<startDay>\\d{1,2}) - Dec (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				// —— 用量页的两个下拉 ——
				// 未展开时是「标签: 当前值」，值的候选固定（分组：None / Repository / Product；
				// 时间范围：本月 / 上个月 / 近 3 个月 / 近 6 个月 / 近 12 个月），逐值展开，
				// 与 usage-range-* 同一形态：模板引用捕获组会渲染出英文值，故写死进模板。
				// 顺序：先分组、后时间范围，与页面上的先后一致
				// （"Timeframe: …" 在任何 group-by 规则里都不可能命中，两组之间不存在顶替）
				{
					"id": "settings/group-by-none",
					"pattern": "^Group by: None$"
				},
				{
					"id": "settings/group-by-repository",
					"pattern": "^Group by: Repository$"
				},
				{
					"id": "settings/group-by-product",
					"pattern": "^Group by: Product$"
				},
				// AI 用量页的分组切换器只有 Days / Models 两个取值（2026-09 截图的选中态是
				// Days，2026-10-07 实机 HTML 的选中态是 Models），与用量页共用同一族规则
				{
					"id": "settings/group-by-days",
					"pattern": "^Group by: Days$"
				},
				{
					"id": "settings/group-by-models",
					"pattern": "^Group by: Models$"
				},
				{
					"id": "settings/timeframe-current-month",
					"pattern": "^Timeframe: Current month$"
				},
				{
					"id": "settings/timeframe-last-month",
					"pattern": "^Timeframe: Last month$"
				},
				{
					"id": "settings/timeframe-last-3-months",
					"pattern": "^Timeframe: Last 3 months$"
				},
				{
					"id": "settings/timeframe-last-6-months",
					"pattern": "^Timeframe: Last 6 months$"
				},
				{
					"id": "settings/timeframe-last-12-months",
					"pattern": "^Timeframe: Last 12 months$"
				},
				// —— AI 用量页（/account/billing/ai_usage）的账期选择器 ——
				// 未展开时是「月份 年份」（截图实证：「Sep 2026」），year 随所选月份变化。
				// 与 insights/month-year-* 是同一形态，但那是 insights 模块的规则（路由
				// ^/[^/]+/[^/]+/(pulse|graphs|…)），在 /account/billing/ai_usage 下不生效，
				// 故本模块必须自带一组；月份写死进 pattern 与模板是替换模板不支持
				// 「捕获组 → 中文月份」映射的老问题（见上面的账期区间说明）。
				// 与上面的账期规则不冲突：那些短语都以「日」或「-」分隔，这里的形态是月份缩写 + 空格 + 年份
				{
					"id": "settings/month-year-jan",
					"pattern": "^Jan (\\d{4})$"
				},
				{
					"id": "settings/month-year-feb",
					"pattern": "^Feb (\\d{4})$"
				},
				{
					"id": "settings/month-year-mar",
					"pattern": "^Mar (\\d{4})$"
				},
				{
					"id": "settings/month-year-apr",
					"pattern": "^Apr (\\d{4})$"
				},
				{
					"id": "settings/month-year-may",
					"pattern": "^May (\\d{4})$"
				},
				{
					"id": "settings/month-year-jun",
					"pattern": "^Jun (\\d{4})$"
				},
				{
					"id": "settings/month-year-jul",
					"pattern": "^Jul (\\d{4})$"
				},
				{
					"id": "settings/month-year-aug",
					"pattern": "^Aug (\\d{4})$"
				},
				{
					"id": "settings/month-year-sep",
					"pattern": "^Sep (\\d{4})$"
				},
				{
					"id": "settings/month-year-oct",
					"pattern": "^Oct (\\d{4})$"
				},
				{
					"id": "settings/month-year-nov",
					"pattern": "^Nov (\\d{4})$"
				},
				{
					"id": "settings/month-year-dec",
					"pattern": "^Dec (\\d{4})$"
				},
				// AI 点数单价脚注（金额随定价变化，故不宜写成静态词条）。
				// 金额连同美元符号一起捕获，美元符号写成字符类「[$]」：模板里**不能**出现
				// 紧跟组引用的字面 $——那种写法必须写成「$$<amount>」，而引擎会把 $$ 折成
				// 一个 $ 并让组引用原样输出（实测，见 locales/zh-CN/rules.jsonc 折扣列的同类
				// 说明），所以美元符号只能来自捕获组本身。字符类同时也绕开了 JSONC 转义：
				// 「\\$」交给正则是「字面反斜杠 + 串尾」（永不命中），「\$」则会被 Bun 的
				// JSONC 解析器当成非法转义直接报 Syntax Error
				{
					"id": "settings/ai-credit-cost",
					"pattern": "^Each GitHub AI credit costs (?<amount>[$][\\d.,]+)\\.$"
				},
				// —— AI 用量页的新版汇总卡（2026-10-07 组织路由实机 HTML）——
				// 「所含点数」卡把「已用 / 总额」渲染成卡片值节点 + 独立节点「/ 0 AI credits」：
				// 数字随额度变化，「AI credits」是产品计量单位（本模块一律译「AI 点数」）。
				// 两种可能的切分各收一条：整句成节点（带前导「/ 」）与「/ 」被切成纯符号节点后的
				// 裸计数（纯符号节点不含拉丁字母、引擎按设计跳过它——那正是留下「/ 」的形态）
				{
					"id": "settings/ai-usage-credits-entitlement",
					"pattern": "^\\/ (?<count>[\\d,]+) AI credits?$"
				},
				{
					"id": "settings/ai-usage-credits-entitlement-bare",
					"pattern": "^(?<count>[\\d,]+) AI credits?$"
				},
				// 额度卡的说明句：「Included AI credits consumed by users in your account. Monthly
				// limit resets in 25 days on 2026年11月1日.」——日期由 GitHub 按浏览器语言在**客户端**
				// 格式化（实机已是中文），故这句必然是**含拉丁字母的混合节点**：引擎的脚本守卫只拦
				// 「整段非拉丁」，混合节点照常进规则。outerHTML 把相邻文本节点拼在一起、看不出切分，
				// 故按「整句 / 第二句 / 第二句前半 / N days on / days on」五种粒度各收一条；
				// 纯数字节点（25）与纯符号节点（.）按设计翻不了。
				// 凡是要求日期在场的形态都**只认「不含拉丁字母」的日期**（`[^A-Za-z]+`）：门禁禁止
				// pattern 里出现非拉丁字母（输入恒为英文原文），故不能直接写「年 / 月 / 日」；
				// 这个字符类同时排除掉英文日期（November 1, 2026）——真让它进来就会产出中英残句
				//（宁可整句保留英文，取舍同 usage-range-* 的跨月组合）
				{
					"id": "settings/ai-usage-credits-description",
					"pattern": "^Included AI credits consumed by users in your account\\. Monthly limit resets in (?<days>\\d+) days? on (?<date>[^A-Za-z]+)\\.$"
				},
				{
					"id": "settings/ai-usage-credits-description-head",
					"pattern": "^Included AI credits consumed by users in your account\\. Monthly limit resets in$"
				},
				{
					"id": "settings/ai-usage-credits-reset",
					"pattern": "^Monthly limit resets in (?<days>\\d+) days? on (?<date>[^A-Za-z]+)\\.$"
				},
				{
					"id": "settings/ai-usage-credits-reset-days-on",
					"pattern": "^Monthly limit resets in (?<days>\\d+) days? on$"
				},
				{
					"id": "settings/ai-usage-credits-reset-head",
					"pattern": "^Monthly limit resets in$"
				},
				{
					"id": "settings/ai-usage-credits-days-on",
					"pattern": "^(?<days>\\d+) days? on$"
				},
				{
					"id": "settings/ai-usage-credits-days-on-word",
					"pattern": "^days? on$"
				},
				// —— 预算与提醒页（/account/billing/budgets）——
				// 标题行「5 Account budgets」：数字随预算条数变化
				{
					"id": "settings/budget-count",
					"pattern": "^(?<count>\\d+) Account budgets?$"
				},
				// 同一条计数在组织路由下说「Organization budgets」（2026-10-07 实机 HTML）：
				// 归属词写死在 pattern 与模板里（模板不支持「捕获组 → 中文」映射）
				{
					"id": "settings/budget-count-org",
					"pattern": "^(?<count>\\d+) Organization budgets?$"
				},
				// 预算行的进度文案：「$0 spent」与「$0 budget」两种形态（金额变化，符号写进模板）。
				// 同 ai-credit-cost：金额连同 $ 一起捕获，模板里不写「$<amount>」前面紧跟字面 $ 的形态
				{
					"id": "settings/budget-amount-spent",
					"pattern": "^(?<amount>[$][\\d.,]+) spent$"
				},
				{
					"id": "settings/budget-amount-limit",
					"pattern": "^(?<amount>[$][\\d.,]+) budget$"
				},
				// —— 许可页（/account/billing/licensing）的「包含 / 不包含」清单 ——
				// 含数量的四条按形态各锚一条（数量随方案变化）：数值与单位原样保留，
				// 只把英文结构换成中文语序
				{
					"id": "settings/licensing-actions-minutes-per-month",
					"pattern": "^(?<count>[\\d,]+) Actions minutes\\/month$"
				},
				{
					"id": "settings/licensing-packages-storage",
					"pattern": "^(?<count>[\\d.,]+)(?<unit>GB|MB|TB|KB) of Packages storage$"
				},
				{
					"id": "settings/licensing-codespaces-compute",
					"pattern": "^(?<count>[\\d,]+) core-hours of Codespaces compute per developer$"
				},
				{
					"id": "settings/licensing-codespaces-storage",
					"pattern": "^(?<count>[\\d.,]+)(?<unit>GB|MB|TB|KB) of Codespaces storage per developer$"
				},
				// —— 账单说明句里的**整句日期区间**（组织账单页与个人账单页共用同一套组件）——
				// 实机节点边界：说明句与日期区间都在**同一个文本节点**里（开发者模式导出的
				// 漏翻清单记录的就是整句原文），故区间规则（settings/usage-range-*）永远
				// 吃不到它——那条只覆盖「区间单独成节点」的形态。这里按整句展开：同月 12 条，
				// 跨月只展开 January → 各月 11 条，因为本页的时间范围下拉只有四个选项
				//（Current month / Last month / This year / Last year），能产生跨月的只有
				// 后两者、起点恒为 1 月；其余跨月组合（如 September 15 - October 14）
				// 在本页不可达，未收：未命中只是保留英文，不会产出中英残句。
				// 模板写死中文月份：把英文月名捕获进模板只会渲染出 October（同 usage-range-*）

				// —— 所含用量限额的重置天数 ——
				// 实机形如「Included usage limits reset in 29 days.」：天数动态。三种可能的
				// 节点切分都被覆盖——① 整句一个节点（主规则）；② 前缀 + 天数（尾节点规则）；
				// ③ 前缀与天数间再插一层（head 规则 + 尾节点规则）。
				// 前缀词条「Included usage limits reset in」已在静态词典里（第一段单独成节点时生效）
				{
					"id": "settings/gross-metered-usage-same-month-jan",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-feb",
					"pattern": "^Gross metered usage for February (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-mar",
					"pattern": "^Gross metered usage for March (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-apr",
					"pattern": "^Gross metered usage for April (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-may",
					"pattern": "^Gross metered usage for May (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-jun",
					"pattern": "^Gross metered usage for June (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-jul",
					"pattern": "^Gross metered usage for July (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-aug",
					"pattern": "^Gross metered usage for August (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-sep",
					"pattern": "^Gross metered usage for September (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-oct",
					"pattern": "^Gross metered usage for October (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-nov",
					"pattern": "^Gross metered usage for November (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-same-month-dec",
					"pattern": "^Gross metered usage for December (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-feb",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-mar",
