		"Members": "メンバー",
		"can access this repository.": "がこのリポジトリにアクセスできます。",
		"Set base role.": "ベースロールを設定。",
		"Set base role": "ベースロールを設定",
		"Organization access": "組織のアクセス",
		"Manage.": "管理。",
		"Manage": "管理",
		// 数値リンクが文を分割した中間ノード「…users and…」
