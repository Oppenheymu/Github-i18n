// 简体中文替换模板：键是 core/rules.jsonc 的规则 id，值是该规则的替换模板。
// pattern 与捕获组定义都在 core/rules.jsonc（语言无关、顺序即语义），这里只管译文；
// $1 / $<name> 引用的是对应 pattern 的捕获组，改模板前先看那边的 pattern。
// 值必须含简体中文的文字系统（门禁强制，防替换循环）。
{
	"$schema": "../../types/dict.schema.json",
	"replacements": {
		"issues/in-repo": "位于 $1；",
		"issues/page-title": "议题 · $1 · GitHub",
		"issues/on-date": "于 $1",
		"issues/linked-prs-count": "$1 个关联拉取请求",
		"pulls/merge-commits-into": "想要将 $1 次提交合并到",
		"pulls/hidden-items-count": "已隐藏 $1 项",
		"pulls/participants-count": "$1 位参与者",
		"pulls/page-title": "拉取请求 · $1 · GitHub",
		"pulls/pull-request-title-with-number": "$1 · 拉取请求 #$2 · $3 · GitHub",
		"pulls/pull-request-title-with-number-plain": "$1 · 拉取请求 #$2 · $3",
		// —— 账号安全页（/settings/security）——
		// 规则 id 与 pattern 见 core/rules.jsonc 的 pages/settings-security 分组：
		// 密钥名与动态日期由捕获组原样带回（$1 / $<day> / $<year>），
		// 月份与相对时间只能写死在模板里（模板不支持函数映射）。
		"settings/passkey-delete-confirm": "确定要删除你的 `$1` 通行密钥吗？",
