// 洞察模块：/owner/repo 下的洞察与工具类子页专属词条
// 覆盖 pulse / graphs / forks / security / projects 子树
// 注：用户名 / 仓库名 / GHSA 编号 / 公告标题属内容，不收录；
// 绝对日期（Sep 23, 2026 等）为全站动态格式，交全站规则处理；
// 图表轴刻度（Aug 2026 / Aug 10）与同月区间为洞察图表专属格式；
// 页标题中的仓库名与读屏属性里的用户名同样原样保留
// 简体中文 · 模块 pages/insights（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— Pulse 动态页 ——
		// 小写 `merged` 已下沉到 global（状态徽标组）：它是跨页共用的状态标签，
		// 留在本模块就成了同键异译的死登记（global 在模块顺序里更靠后，永远被本模块压过），
		// 且其它页面的同名标签依旧翻不了。
		"Period:": "时间段：",
		"Open pull requests": "打开的拉取请求",
		"commits": "次提交",
		// —— 洞察侧栏 ——
		"Code frequency": "代码频率",
		"Community standards": "社区标准",
		// —— Forks 复刻列表 ——
		"Created": "创建于",
		"Recently updated": "最近更新",
		"Most starred": "星标最多",
		"Open issues": "打开的议题",
		"Starred": "已星标",
		"Sort:": "排序：",
		"Filter by period": "按时间段筛选",
		"Filter by repository type": "按仓库类型筛选",
		"Repository type:": "仓库类型：",
		"Archived repositories": "已归档仓库",
		"Forks of other forks": "其他复刻的复刻",
		"Inactive": "不活跃",
		"Repositories with push activity": "有推送活动的仓库",
		"Repositories with no push activity": "无推送活动的仓库",
		"Repositories with at least 1 star": "至少有 1 个星标的仓库",
		"Switch to tree view": "切换到树状视图",
		// 键写归一化后的单空格形态（源码里的换行缩进由 normalizeKey 折叠，键里的换行永不命中）
		"Any repository that has not been created or updated during this period will be excluded.": "在此期间未创建或未更新的仓库将被排除。",
		// —— graphs 图表（contributors 等）——
		"Contributions": "贡献",
		"Period": "时间段",
		"Last 3 months": "最近 3 个月",
		"Crunching the latest data, just for you. Hang tight…": "正在为你整理最新数据，请稍候…",
		"End of interactive chart.": "交互式图表结束。",
		"View as data table, Chart": "以数据表查看，图表",
		"Interactive chart": "交互式图表",
		"Interactive chart.": "交互式图表。",
		"Contributions per week to": "对以下分支的每周贡献：",
		", line counts have been omitted because commit count exceeds 10,000.": "（因提交数超过 10,000，行数统计已省略）",
		"Chart": "图表",
		"Chart options": "图表选项",
		"Customization settings": "自定义设置",
		"commit": "次提交",
		"'s Commits": " 的提交",
		"Weekly from": "每周，自",
		"over time": "随时间变化",
		// —— 图表读屏属性（属性只做整串精确匹配，不带规则）——
		"Axis zoom": "坐标轴缩放",
		"Start, percent": "起点，百分比",
		"End, percent": "终点，百分比",
		"Commits over time Axis zoom": "随时间变化的提交 坐标轴缩放",
		// —— Security 安全公告 ——
		"published": "已发布",
		"Published advisory": "已发布的安全公告",
		"GitHub Advisory Database": "GitHub 安全公告数据库",
		"High": "高危",
		"Moderate": "中危",
		"Critical": "严重",
		"Severity: high": "严重程度：高危",
		"Severity: moderate": "严重程度：中危",
		"Severity: critical": "严重程度：严重",
		"Learn more about advisories related to": "进一步了解与",
		"in the": "相关的安全公告，收录于",
		// —— Security 概览页（/owner/repo/security）——
		// 顶部横幅与 pages/repo-settings 同串同译（那里的 Code scanning 横幅）；
		// 标题节点内部带项目符号 `•`，译文原样保留，渲染成「安全策略 • 启用」。
		// View alerts 这类短链接在实机是「链接独占一个节点」，与说明句各自成条。
		"Code scanning: one or more analysis tools are reporting problems": "代码扫描：一个或多个分析工具正在报告问题",
		"Scorecard is reporting warnings. Check the": "Scorecard 正在报告警告。请查看",
		"status page": "状态页面",
		"for help.": "以获取帮助。",
		"Security policy •": "安全策略 •",
		"Enabled": "启用",
		"View how to securely report security vulnerabilities for this repository": "查看如何安全地报告此仓库的安全漏洞",
		"View security policy": "查看安全策略",
		"Security advisories •": "安全公告 •",
		"View or disclose security advisories for this repository": "查看或披露此仓库的安全公告",
		"View security advisories": "查看安全公告",
		"Private vulnerability reporting •": "私密漏洞报告 •",
		"Allow users to privately report potential security vulnerabilities": "允许用户私下报告潜在的安全漏洞",
		"See reported vulnerabilities": "查看已报告的漏洞",
		"Dependabot alerts •": "Dependabot 警报 •",
		"Get notified when one of your dependencies has a vulnerability": "当你的某个依赖项存在漏洞时就会收到通知",
		"View Dependabot alerts": "查看 Dependabot 警报",
		"Code scanning alerts •": "代码扫描警报 •",
		"Automatically detect common vulnerability and coding errors": "自动检测常见漏洞与编码错误",
		"View alerts": "查看警报",
		"Secret scanning alerts •": "机密扫描警报 •",
		"Get notified when a secret is pushed to this repository": "当有机密被推送到此仓库时就会收到通知",
		"View detected secrets": "查看检测到的机密",
		"Code quality findings •": "代码质量问题 •",
		"Disabled": "禁用",
		"Automatically detect code quality issues in your codebase": "自动检测你的代码库中的代码质量问题",
		"Enable code quality": "启用代码质量",
		// —— Projects 项目 ——
		"Templates": "模板",
		"Repository projects": "仓库项目",
		"Filter projects by state": "按状态筛选项目",
		"Loading projects": "正在加载项目",
		"Search projects": "搜索项目",
		"Search by name…": "按名称搜索…",
		"updated": "更新于"
	}
}
