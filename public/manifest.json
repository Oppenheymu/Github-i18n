{
	"manifest_version": 3,
	"default_locale": "en",
	"name": "__MSG_appName__",
	"version": "1.0.0",
	"description": "__MSG_appDesc__",
	"homepage_url": "https://github.com/Oppenheymu/Github-i18n",
	"permissions": ["storage"],
	"icons": {
		"16": "icons/logo-16.jpg",
		"32": "icons/logo-32.jpg",
		"48": "icons/logo-48.jpg",
		"128": "icons/logo-128.jpg"
	},
	"action": {
		"default_title": "__MSG_appName__",
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": [
				"https://github.com/*",
				"https://gist.github.com/*"
			],
			"js": ["content.js"],
			"run_at": "document_start"
		}
	]
}
