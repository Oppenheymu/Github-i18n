				},
				{
					"id": "settings/gross-metered-usage-cross-jan-apr",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-may",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
