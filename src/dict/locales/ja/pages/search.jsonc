// 日本語・モジュール pages/search：サイト全体の検索とトピックページ。
// 対象は /search と /topics の 2 つのトップレベルパス。
// 鍵は core/canonical.jsonc にある英語原文との完全一致（綴り違いは門禁が弾く）。
// 値には日本語の文字体系（漢字 / ひらがな / カタカナ）が必要。
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— 結果の並べ替え（「〜が多い順 / 少ない順」は issues モジュールの並べ替えメニューと同じ語調）——
		"Best match": "ベストマッチ",
		"Most stars": "スターが多い順",
		"Fewest stars": "スターが少ない順",
		"Most forks": "フォークが多い順",
		"Fewest forks": "フォークが少ない順",
		"Least recently updated": "更新が古い順",
		"Sort by:": "並べ替え：",
		"Sort options": "並べ替えオプション",
		// —— 絞り込みサイドバー ——
		"Filter:": "フィルター：",
		"Filter by": "絞り込み",
		"Filter by type": "種類で絞り込む",
		"Filter by language": "言語で絞り込む",
		"Open column options": "列のオプションを開く",
		"Advanced": "詳細",
		"Advanced search": "詳細検索",
		"Date created": "作成日",
		"Date pushed": "プッシュ日",
		"Number of followers": "フォロワー数",
		"Number of forks": "フォーク数",
		"Number of stars": "スター数",
		"Size": "サイズ",
		"Topic": "トピック",
		"Users": "ユーザー",
		"More languages...": "その他の言語…",
		// —— 言語フィルターの項目（言語名そのものは固有名詞なので原文のまま）——
		"Python language": "Python 言語",
		"Java language": "Java 言語",
		"TypeScript language": "TypeScript 言語",
		"CSS language": "CSS 言語",
		"JavaScript language": "JavaScript 言語",
		// —— ProTip のショートカット案内（実機では 1 文が複数ノードに分割されるため、断片ごとに収録）——
		// ノード順は「Press the」→ <kbd>/</kbd> → 「key to …」で固定なので、
		// 日本語は前段を「…するには」、後段を「キーを押します。」にして語順を合わせる。
		"ProTip!": "プロのヒント！",
		"Press the": "検索入力フィールドを再度有効にしてクエリを調整するには",
		"key to activate the search input again and adjust your query.": "キーを押します。",
		// —— スポンサーのプロモーションカード ——
		"Sponsor open source projects you depend on": "依存しているオープンソースプロジェクトをスポンサーしよう",
		"Contributors are working behind the scenes to make open source better for everyone—give them the help and recognition they deserve.": "コントリビューターは縁の下で、オープンソースを誰にとってもより良いものにしようと尽力しています。ぜひ、ふさわしい支援と評価を贈りましょう。",
		"Explore sponsorable projects": "スポンサー可能なプロジェクトを探す",
		"Package icon": "パッケージのアイコン",
		// —— トピックページの関連トピックリンクの title ヒント ——
		// トピック名は既存の取り決めどおり原文のまま（rules の「Topic: X」と同じ描画）；
		// 属性には正規表現ルールが効かないため、実際に描画される文字列を 1 件ずつ収録する
		"Topic: angular": "トピック：angular",
		"Topic: ant-design": "トピック：ant-design",
		"Topic: antd": "トピック：antd",
		"Topic: apis": "トピック：apis",
		"Topic: artificial-intelligence": "トピック：artificial-intelligence",
		"Topic: automation": "トピック：automation",
