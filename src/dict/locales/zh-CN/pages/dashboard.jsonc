// 仪表板模块：根路径（登录后首页）
// 简体中文 · 模块 pages/dashboard（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Home": "主页",
		"For you": "为你推荐",
		"Top repositories": "热门仓库",
		"Find a repository…": "查找仓库…",
		"Recent activity": "最近动态",
		"Latest changes": "最新变更",
		"Create repository": "创建仓库",
		// —— Copilot 对话区（问候语含用户名与时段，走 dashboard/greeting 规则）——
		"Ask anything or type @ to add context": "问点什么，或输入 @ 用 Copilot 添加上下文",
		"Ask anything or type @ to add context with Copilot": "问点什么，或输入 @ 用 Copilot 添加上下文",
		"Ask": "提问",
		"Select repositories to attach to conversation": "选择要附加到对话的仓库",
		// 「All repositories」由 global 覆盖（同名同译），此处不重复登记
		"Add files, and spaces": "添加文件与空间",
		"Auto": "自动",
		"Model:": "模型：",
		// —— AutoTierPicker 展开后的三档（档位名 + 说明各是一条词条）——
		"Efficiency": "效率",
		"Prioritizes speed and efficiency": "优先考虑速度与效率",
		"Balance": "均衡",
		"Balances speed and intelligence": "在速度与智能之间取得平衡",
		"Intelligence": "智能",
		"Prioritizes intelligence": "优先考虑智能",
		// 触发按钮整串（英文界面形态）：中文界面下的「Optimized for: 均衡」是混合节点，
		// 由 dashboard/optimized-for 规则换上中文前缀，档位名沿用 GitHub 自己给出的译名
		"Optimized for: Efficiency": "优化目标：效率",
		"Optimized for: Balance": "优化目标：均衡",
		"Optimized for: Intelligence": "优化目标：智能",
		"Send now": "立即发送",
		"Debug": "调试",
		"Agent": "智能代理",
		"Create issue": "创建议题",
		"Write code": "编写代码",
		// —— Copilot 对话区的动作菜单与提示词库（与 core/canonical.jsonc 同序）——
		"Create a profile README": "创建个人资料 README",
		"Generate a simple calculator": "生成一个简单计算器",
		"Make a Pong game": "做一个 Pong 游戏",
		"Design a Mermaid architecture overview": "设计一个 Mermaid 架构概览",
		"My open pull requests": "我打开的拉取请求",
		"Summarize my latest PR": "总结我最新的 PR",
		// —— /create-issue 命令列表的两条说明句（行首的 `/create-issue` 标签是另一个节点）——
		"First, create a new draft issue. Then ask for additional information to fill out the issue.": "先创建一个草稿议题，然后补充信息把议题填完整。",
		"First, create an issue with sub issues. Then ask for additional information to fill out these issues.": "先创建一个带子议题的议题，然后补充信息把这些议题填完整。",
		// 「Git」启动器按 AGENTS.md 硬性约束 3 的做法**不收录**：它是纯专名
		// （与 global 里的键同名同形），收录只会被门禁判为「译文与键同形」的循环风险。
		// 未命中即保留英文，这是正确行为。
		// —— Copilot 应用宣传横幅 ——
		"The GitHub Copilot app": "GitHub Copilot 应用",
		"An agent-driven desktop experience built natively on GitHub.": "原生构建于 GitHub 的智能代理桌面体验。",
		"Download for Windows": "下载 Windows 版",
		"Dismiss banner": "关闭横幅",
		"The GitHub Copilot app, New": "GitHub Copilot 应用，新建",
		// —— 议题列表的「查看全部」链接（可见文本 + sr-only 后缀两个节点）——
		"View all": "查看全部",
		"issues": "议题"
	}
}
