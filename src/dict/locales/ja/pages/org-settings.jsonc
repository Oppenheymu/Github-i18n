// 日本語・モジュール pages/org-settings：組織設定（/organizations/<org>/settings/** と
// /orgs/<org>/settings/**、および /orgs/<org>/topics）。
// プロフィール、設定サイドバー、ロールと権限、メンバー特権、インタラクション制限、
// リポジトリ既定、ルールセット、カスタムプロパティ、Codespaces / サンドボックス / プロジェクト、
// Copilot、Actions、Webhook、ディスカッション、パッケージ、2 要素認証の強制、
// Advanced Security、コード品質までを覆う。
// 鍵は core/canonical.jsonc の pages/org-settings と同一（ノード境界と根拠は zh-CN 側を参照）。
// ロール名は pages/repo-settings と同じ（読み取り / トリアージ / 書き込み / メンテナンス / 管理者）。
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— 設定シェル（サイドバー、コンテキスト切り替え、組織ナビゲーション）——
		"Organization settings": "組織の設定",
		"Organization": "組織",
		"Organization navigation": "組織のナビゲーション",
		"General Organization Settings": "組織の一般設定",
		"Settings menu": "設定メニュー",
		"Menu": "メニュー",
		"Select settings context": "設定のコンテキストを選択",
		"Switch": "切り替え",
		"context": "コンテキスト",
		// 設定コンテキストの切り替え：`切り替え <span>settings </span>コンテキスト`。小文字の汎用語だが、
		// モジュールが組織設定ページにルート限定されているため収録（pages/settings も同じ文で同じキーを既に収録）
		"settings": "設定",
		"People": "メンバー",
		"Insights": "インサイト",
		// —— 組織設定のサイドバー ——
		"Member privileges": "メンバー権限",
		"Repository policies": "リポジトリポリシー",
		"Repository roles": "リポジトリロール",
		"Organization roles": "組織ロール",
		"Role assignments": "ロールの割り当て",
		"Role management": "ロールの管理",
		"Repository properties": "リポジトリのプロパティ",
		"Custom properties": "カスタムプロパティ",
		"Projects": "プロジェクト",
		"Configurations": "構成",
		"Caches": "キャッシュ",
		"Code review": "コードレビュー",
		"Issue fields": "イシューフィールド",
		"Issue types": "イシューの種類",
		"Ruleset dashboard": "ルールセットダッシュボード",
		"Ruleset insights": "ルールセットのインサイト",
		"Runner groups": "ランナーグループ",
		"Authentication security": "認証のセキュリティ",
		"Compliance": "コンプライアンス",
		"Moderators": "モデレーター",
		"Logs": "ログ",
		"Audit log": "監査ログ",
		"Active tokens": "アクティブなトークン",
		"Pending requests": "保留中のリクエスト",
		"Private registries": "プライベートレジストリ",
		"Deleted repositories": "削除されたリポジトリ",
		"OAuth app policy": "OAuth アプリのポリシー",
		"OAuth Apps": "OAuth アプリ",
		"Personal access tokens": "個人アクセストークン",
		"Third-party Access": "サードパーティのアクセス",
		"GitHub Apps": "GitHub アプリ",
		"Publisher Verification": "パブリッシャーの検証",
		"Verified and approved domains": "検証済みかつ承認済みのドメイン",
		"Sandboxes": "サンドボックス",
		"Import/Export": "インポート/エクスポート",
		"Scheduled reminders": "スケジュールされたリマインダー",
		"Global settings": "グローバル設定",
		"Billing and licensing": "請求とライセンス",
		"Payment information": "支払い情報",
		"Payment history": "支払い履歴",
		"Additional billing details": "追加の請求詳細",
		"Budgets and alerts": "予算とアラート",
		"AI usage": "AI 使用量",
		"Sponsorship log": "スポンサーシップの記録",
		"Licensing": "ライセンス",
		"Usage": "使用量",
		"Blocked users": "ブロックしたユーザー",
		"Developer settings": "開発者設定",
		// —— 組織設定サイドバーのグループ見出しと残りの項目（根拠：2026-10-03 にメンテナーが貼った Layout-sidebar）——
		// `Pages` 以外はすべて pages/settings と pages/repo-settings の既存の表現を踏襲：
		// 同じサイドバー項目が両方のモジュールに現れるため、文言を変えるときは両方そろえて変える。
		"General": "一般",
		"Policies": "ポリシー",
		"Access": "アクセス",
		"Moderation": "モデレーション",
		"Interaction limits": "インタラクションの制限",
		"Code review limits": "コードレビューの制限",
		"Code, planning, and automation": "コード、計画、自動化",
		"Rulesets": "ルールセット",
		"Planning": "プランニング",
		"Cloud agent": "クラウドエージェント",
		"Internet access": "インターネットアクセス",
		"Runner type": "ランナーの種類",
		"Policy insights": "ポリシーのインサイト",
		"Runners": "ランナー",
		"Webhooks": "ウェブフック",
		"Packages": "パッケージ",
		// global は GitHub Pages の `Pages` を「ページ番号」として収録しているが、本モジュールは自ルートで「ページ」に訂正
		"Pages": "ページ",
		"Security and quality": "セキュリティと品質",
		"Advanced Security": "高度なセキュリティ",
		"Code quality": "コード品質",
		"Deploy keys": "デプロイキー",
		"Secrets and variables": "シークレットと変数",
		"Agents": "エージェント",
		"Integrations": "インテグレーション",
		"Archive": "アーカイブ",
		// 組織ページの `Actions` はリポジトリ設定と同じ表現（同じサイドバー項目）。注入を除外したうえで本モジュールが自前で提供
		"Actions": "アクション",
		// —— 組織のデプロイキーポリシーページ：説明文はリンクの位置で分割、無効化の注意は組織名ノードで分割 ——
		"Deploy keys use an SSH key to grant readonly or write access to a single repository. If you have a more complex project or want more fine-grain control over permissions, consider using a GitHub App instead. For more information, see": "デプロイキーは SSH キーを使用して、単一のリポジトリへの読み取り専用または書き込みアクセスを許可します。より複雑なプロジェクトの場合や、権限をより細かく制御したい場合は、代わりに GitHub App の使用を検討してください。詳細については、次のドキュメントをご参照ください：",
		"the GitHub Apps documentation": "GitHub Apps のドキュメント",
		". Please note that deploy keys are not protected by a passphrase and can be a security risk if your server is compromised. For more information on deploy keys, see": "。デプロイキーはパスフレーズで保護されていないため、サーバーが侵害された場合にはセキュリティリスクとなる可能性があります。デプロイキーの詳細については、次のガイドをご参照ください：",
		"managing deploy keys": "デプロイキーの管理",
		"Deploy keys are not allowed to be created and used within this organization. Cloning public repositories will be unaffected by this policy.": "この組織ではデプロイキーの作成と使用が許可されていません。このポリシーは公開リポジトリのクローンには影響しません。",
		"Deploy keys are allowed to be created and used within this organization.": "この組織ではデプロイキーの作成と使用が許可されています。",
		"use deploy keys. Disabling deploy keys may break existing workflows.": "デプロイキーを使用しています。デプロイキーを無効にすると、既存のワークフローが動作しなくなる可能性があります。",
		"Are you sure you want to disable deploy keys?": "デプロイキーを無効にしてもよろしいですか？",
		"Existing deploy keys in": "既存のデプロイキー（",
		"will disabled.": "）は無効になります。",
		// —— 組織プロフィールのフォーム ——
		"Organization display name": "組織の表示名",
		"Email (will be public)": "メールアドレス（公開されます）",
		"Location": "場所",
		"URL": "ウェブサイト",
		"Social accounts": "ソーシャルアカウント",
		"Social account": "ソーシャルアカウント",
		// Location 検索ボックスのプレースホルダー（属性は完全一致のみ。半角の省略記号をキーと同じ形で保つ）
		"Find a location...": "場所を検索…",
		"Link to social profile 1": "ソーシャルプロフィールへのリンク 1",
		"Link to social profile 2": "ソーシャルプロフィールへのリンク 2",
		"Link to social profile 3": "ソーシャルプロフィールへのリンク 3",
		"Link to social profile 4": "ソーシャルプロフィールへのリンク 4",
		"Feature Release Label: Preview": "機能リリースラベル：プレビュー",
		"Feature Release Label: Public preview": "機能リリースラベル：パブリックプレビュー",
		// —— 請求用メールアドレスとアバターのブロック（根拠：2026-10-03 にメンテナーが貼った実機 HTML）——
		"Billing email": "請求用メールアドレス",
		// `<small>(Private)</small>` は独立したノードで、ラベルのテキストとは分かれている
		"(Private)": "（非公開）",
		// 説明文は `<a>billing page</a>` で分割：リンクは「〜へ移動」の後にあり、リンク外の句点は記号だけのノード
		// （エンジンでは翻訳できない）。実機では「請求用メールアドレスの受信者を追加するには、請求ページ .」と連結される
		"Add more billing email recipients in the": "請求用メールアドレスの受信者を追加するには、",
		"billing page": "請求ページ",
		"Gravatar email": "Gravatar メールアドレス",
		"Sponsors update email": "スポンサー更新メールアドレス",
		"The developers and organizations that your organization sponsors can send you updates to this email.": "あなたの組織がスポンサーしている開発者や組織は、このメールアドレスに更新情報を送信できます。",
		// アバターのアップローダー（pages/settings の同じキーの訳文と一致させる。両モジュールのパスは排他）
		"Update profile": "プロフィールを更新",
		"Profile picture": "プロフィール画像",
		"Upload new picture": "新しい画像をアップロード",
		"Uploading...": "アップロード中…",
		"Note: To apply for a publisher verification your organization's profile picture should not be irrelevant, abusive or vulgar. It should not be a default image provided by GitHub.": "注意：パブリッシャーの検証を申請するには、組織のプロフィール画像が組織と無関係なもの、虐待的なもの、わいせつなものであってはなりません。また、GitHub が提供するデフォルトの画像であってはなりません。",
		"This file is empty.": "このファイルは空です。",
		"Please upload a picture smaller than 1 MB.": "1 MB 未満の画像をアップロードしてください。",
		"Please upload a picture smaller than 10,000x10,000.": "10,000×10,000 未満の画像をアップロードしてください。",
		"We only support PNG, GIF, or JPG pictures.": "PNG、GIF、JPG 形式の画像のみに対応しています。",
		"Something went really wrong and we can’t process that picture.": "重大な問題が発生し、この画像を処理できません。",
		"File contents don’t match the file extension.": "ファイルの内容が拡張子と一致しません。",
		"Clear Location": "場所をクリア",
		// —— 製品内メッセージ（In-product messages）——
		// 根拠：2026-10-03 にメンテナーが貼った下半分の実機 HTML（拡張機能を入れた後の描画結果。
		// ページ内でまだ英語のノードが補完対象）。オン/オフの状態は pages/settings と同じ表現。
		"In-product messages": "製品内メッセージ",
		"Promotions": "プロモーション",
		"Notify account admins about exclusive GitHub products, services, offers, and events.": "GitHub 限定の製品、サービス、オファー、イベントについてアカウント管理者に通知します。",
		"Member requests": "メンバーリクエスト",
		"Allow members in your organization to request access to products, budget, or features.": "組織のメンバーが製品、予算、機能へのアクセスをリクエストできるようにします。",
		"Tips": "ヒント",
		"Show your organization members tips about enabled products and features.": "組織のメンバーに、有効になっている製品と機能に関するヒントを表示します。",
		"Customer Research": "顧客リサーチ",
		"Allow GitHub to contact members in your organization for research and feedback surveys.": "GitHub が調査やフィードバックのアンケートのために組織のメンバーへ連絡することを許可します。",
		"On": "オン",
		"Off": "オフ",
		// —— Patreon と GitHub Developer Program ——
		"Link Patreon account": "Patreon アカウントを連携",
		"Connect with Patreon": "Patreon と連携",
		// 説明文は `<strong>@組織名</strong>` で分割：最初の断片は前置詞だけが残り、
		// 組織名の後に第 2 の断片が続く。連結すると「@組織名 の Patreon アカウントを連携してメンテナーをスポンサーするために。…」と読める
		"Connect a Patreon account for": "メンテナーをスポンサーするために、",
		"to sponsor maintainers with. Get recognition on GitHub for sponsorships made on Patreon when the sponsored person has linked Patreon and GitHub, too, and has a public GitHub Sponsors profile.": "の Patreon アカウントを連携します。Patreon で行ったスポンサーシップについて、スポンサーされた相手も Patreon と GitHub を連携していて、公開の GitHub Sponsors プロフィールを持っている場合は、GitHub で認定を受けられます。",
		"GitHub Developer Program": "GitHub 開発者プログラム",
		"Building an application, service, or tool that integrates with GitHub?": "GitHub と連携するアプリケーション、サービス、ツールを構築していますか？",
		"Join the GitHub Developer Program": "GitHub 開発者プログラムに参加",
		// リンクの後の断片はカンマで始まる。実機では「…GitHub 開発者プログラムに参加、詳細についてはこちらの GitHub 開発者プログラム.」と連結される
		", or read more about it at our": "、または詳細についてはこちらのページをご覧ください：",
		"GitHub developer program": "GitHub 開発者プログラム",
		// —— 利用規約（Terms of Service）——
		"Terms of Service": "利用規約",
		"Standard": "標準",
		"Best for individuals wanting the freedom to move data and remain independent of a corporation.": "データを自由に移行し、企業から独立した立場を保ちたい個人に最適です。",
		"Read the Standard Terms of Service": "標準利用規約を読む",
		"Corporate": "企業向け",
		"Best for businesses that need to protect their intellectual property and secure visibility into their data.": "知的財産を保護し、自社データに対する可視性を確保する必要がある企業に最適です。",
		"Read the GitHub customer agreement": "GitHub カスタマーアグリーメントを読む",
		"Sign GitHub customer terms": "GitHub カスタマー規約に署名",
		// 同じ文字列が details-dialog の aria-label にも、ダイアログの h3 見出しにも使われている
		"Accept GitHub customer agreement": "GitHub カスタマーアグリーメントに同意",
		"Do you want to give ownership of your organization to your business?": "組織の所有権を企業に譲渡しますか？",
		"Yes, I want to sign the GitHub customer agreement on behalf of my business.": "はい。企業を代表して GitHub カスタマーアグリーメントに署名します。",
		"What is the name of the business that owns this account?": "このアカウントを所有する企業の名称は何ですか？",
		// 企業名入力欄の例のプレースホルダー（属性は完全一致のみ。キーは実機と同じ形を保つ）
		"e.g, Acme, Inc.": "例：Acme, Inc.",
		"The name of the company that owns this account": "このアカウントを所有する会社の名前",
		// `<span class="note">This business — not <strong>ユーザー名</strong> (your user account), will own…</span>`
		"This business — not": "この企業——",
		"(your user account), will own and/or control any content posted to the organization": "（あなたのユーザーアカウント）ではなく、組織に投稿されたあらゆるコンテンツを所有および/または管理します",
		"Accepting terms...": "規約に同意しています…",
		"Accept terms": "規約に同意",
		"By clicking “Accept terms”, you agree to the": "「規約に同意」をクリックすると、次に同意したことになります：",
		"GitHub customer agreement": "GitHub カスタマーアグリーメント",
		"and the": "および",
		"privacy statement": "プライバシーステートメント",
		// —— 顧客契約にある企業の請求情報フォーム ——
		// フィールドは pages/settings-billing の支払い情報ページと同源で、訳文はそちらの表現をそのまま踏襲
		//（「一部の国/地域では必須」「VAT/GST 番号」「（米国は 9 桁の ZIP コード）」など）。
		"GitHub's customer agreement requires you to transfer the ownership of your organization to your business. Enter your business details below to continue. You can change these at any time by accessing your organization’s billing information.": "GitHub のカスタマーアグリーメントでは、組織の所有権を企業に譲渡する必要があります。続行するには、以下に企業の詳細を入力してください。これらの内容は、組織の請求情報にアクセスすればいつでも変更できます。",
		"Business/Institution name": "企業/機関の名称",
		"VAT/GST ID": "VAT/GST 番号",
		"Address": "住所",
		"(Street, P.O. box)": "（番地、私書箱）",
		"Address line 2": "住所 2",
		"(Apartment, suite, unit)": "（アパート、スイート、部屋番号）",
		"City": "市区町村",
		"Country/Region": "国/地域",
		"Choose your country/region": "国/地域を選択してください",
		"State/Province": "都道府県/州",
		// 州 / 省ドロップダウンの先頭項目（米 / 加の 2 つの select に各 1 件）。選択肢の名前自体は収録しない
		"Select state": "州を選択",
		"Select province": "省を選択",
		"Required for certain countries": "一部の国/地域では必須",
		"Postal/Zip code": "郵便番号",
		"(9-digit zip code for US)": "（米国は 9 桁の ZIP コード）",
		"I agree to the": "以下に同意します：",
		"Corporate Terms of Service": "企業利用規約",
		// フォーム右側の reset ボタンの小文字原文。モジュールはこのルートでのみ有効なので、誤爆の範囲は組織設定ページに限られる
		"cancel": "キャンセル",
		// —— 危険な領域：名前変更 / アーカイブ / 削除の 3 つのダイアログ ——
		// 実機の描画は小文字の `Danger zone`（pages/settings の `Danger Zone` ではない）。キーは同じ形でなければならない。
		"Danger zone": "危険なゾーン",
		"Rename organization": "組織の名前を変更",
		// `<p>Renaming your organization can have <a>unintended side effects</a>.</p>`
		"Renaming your organization can have": "組織の名前を変更すると、",
		"unintended side effects": "意図しない副作用が生じる可能性があります。",
		"Rename your organization?": "組織の名前を変更しますか？",
		"Unexpected bad things will happen if you don’t read this!": "この内容を読まないと、予期しない問題が発生します！",
		// `<li>We <strong>will</strong> create redirects…</li>`：3 つのノードがそれぞれ一致する必要がある
		"We": "私たち",
		"will": "は",
		"create redirects for your repositories (web and git access).": "リポジトリ（Web と Git アクセス）のリダイレクトを作成します。",
		"You will need to update your local repositories to point to the new location.": "ローカルリポジトリを新しい場所を指すように更新する必要があります。",
		"Renaming may take a few minutes to complete.": "名前の変更が完了するまで数分かかる場合があります。",
		"Enter a new name": "新しい名前を入力",
		"Change organization’s name": "組織の名前を変更",
		// アーカイブのダイアログ：h1 見出しとボタンの文言は別々の原文
		"Archive organization": "組織をアーカイブ",
		"Archive this organization": "この組織をアーカイブ",
		"This organization will be archived.": "この組織はアーカイブされます。",
		"Modifying settings will be limited and creating new repositories will be blocked.": "設定の変更が制限され、新しいリポジトリの作成はブロックされます。",
		// `<p>All repositories will be <a>archived</a> and be read-only.</p>`
		"All repositories will be": "すべてのリポジトリは",
		"archived": "アーカイブ済み",
		"and be read-only.": "となり、読み取り専用になります。",
		"Before you archive, please consider:": "アーカイブする前に、次を検討してください：",
		"Updating any organization settings": "組織の設定を更新する",
		// `<li>Making a note in your <a>organization README</a></li>`
		"Making a note in your": "メモを残す：",
		"organization README": "組織の README",
