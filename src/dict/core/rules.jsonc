				{
					"id": "settings/gross-metered-usage-cross-jan-jun",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-jul",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-aug",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-sep",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-oct",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-nov",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/gross-metered-usage-cross-jan-dec",
					"pattern": "^Gross metered usage for January (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-jan",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-feb",
					"pattern": "^Included usage discounts for February (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-mar",
					"pattern": "^Included usage discounts for March (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-apr",
					"pattern": "^Included usage discounts for April (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-may",
					"pattern": "^Included usage discounts for May (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-jun",
					"pattern": "^Included usage discounts for June (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-jul",
					"pattern": "^Included usage discounts for July (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-aug",
					"pattern": "^Included usage discounts for August (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-sep",
					"pattern": "^Included usage discounts for September (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-oct",
					"pattern": "^Included usage discounts for October (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-nov",
					"pattern": "^Included usage discounts for November (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-same-month-dec",
					"pattern": "^Included usage discounts for December (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-feb",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-mar",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-apr",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-may",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-jun",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-jul",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-aug",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-sep",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-oct",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-nov",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-discounts-cross-jan-dec",
					"pattern": "^Included usage discounts for January (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})\\.$"
				},
				{
					"id": "settings/included-usage-reset-days",
					"pattern": "^Included usage limits reset in (?<days>\\d+) days?\\.$"
				},
				{
					"id": "settings/included-usage-reset-days-head",
					"pattern": "^Included usage limits reset in (?<days>\\d+)$"
				},
				{
					"id": "settings/included-usage-reset-days-tail",
					"pattern": "^(?<days>\\d+) days?\\.$"
				},
				{
					"id": "settings/included-usage-reset-days-word",
					"pattern": "^days?\\.$"
				},
				// —— 赞助订阅页（/settings/billing/subscriptions）——
				// 顶部「除此之外你还管理 N 个组织」：数字随组织数变化，只能做规则，$1 是组织数。
				// 实机 HTML 实证：整句是 `<div class="tmp-mb-4">` 的**首个文本节点**（带源码
				// 缩进），归一空白后是单行整句，故 ^…$ 锚定成立（节点原文见 settings/billing.test.ts）
				{
					"id": "settings/manage-organizations",
					"pattern": "^In addition to your personal account, you manage (\\d+) organizations?\\.$"
				},
				// 空态：实机 HTML 里是**直撇号**，字符类仍保留两种形态——GitHub 各页混用
				//（本模块的优惠券空态是直撇号 `don't`，付款信息 tooltip 是弯撇号 `We’ll`），
				// 改版也可能换字形；模板里不含撇号，不可能产出中英混杂的残句
				{
					"id": "settings/sponsoring-none",
					"pattern": "^You['’]re currently not sponsoring anyone\\.$"
				}
			]
		},
		{
			"name": "pages/repo-settings",
			"rules": [
				// “Sponsor” 的引号在 GitHub 文案中直弯混用，用字符类一并覆盖
				{
					"id": "repo-settings/sponsor-button",
					"pattern": "^Display a [\\u201C\"]Sponsor[\\u201D\"] button$"
				},
				// 推送限制说明的链接若拆成「链接 + 尾句」两个节点，尾句在此兜底
				{
					"id": "repo-settings/send-feedback",
					"pattern": "^, and send us your feedback\\.$"
				},
				// 动态计数
				{
					"id": "repo-settings/branch-protection-count",
					"pattern": "^([\\d,]+) branch protection rules?$"
				},
				{
					"id": "repo-settings/star-count",
					"pattern": "^([\\d,]+) star$"
				},
				{
					"id": "repo-settings/watcher-count",
					"pattern": "^([\\d,]+) watcher$"
				},
				// 带仓库名的动态标题（仅匹配 owner/repo 形态，避免泛化误伤）。
				// owner/repo 不含空白，故作否定字符类里加上 \s：否则规则集页的
				// `Delete include of <分支模式>` 会被它当成 owner/repo 抢先命中，
				// 译出「删除 include of release/*」这种中英混杂的残句（实测 2026-09-27）
				{
					"id": "repo-settings/delete-repo",
					"pattern": "^Delete ([^/\\s]+\\/[^/\\s]+)$"
				},
				{
					"id": "repo-settings/make-private",
					"pattern": "^Make ([^/\\s]+\\/[^/\\s]+) private$"
				},
				{
					"id": "repo-settings/settings-title",
					"pattern": "^Settings: (.+)$"
				},
				{
					"id": "repo-settings/add-people",
					"pattern": "^Add people to (.+)$"
				},
				// sudo 验证码提示（邮箱地址随账号变化，用规则捕获）
				{
					"id": "repo-settings/verification-code",
					"pattern": "^Enter the verification code sent to (.+)\\. If it doesn\\u2019t appear within a few minutes, check your spam folder\\.$"
				},
				// 直接访问 / 组织访问卡片：动态计数句（数量与单复数随数据变化）。
				// 数字在页面上是独立链接节点，句子会被切成「数字 + 尾段」，整句与尾段都收
				{
					"id": "repo-settings/entity-access-count",
					"pattern": "^(?<count>[\\d,]+) entit(?<plural>y|ies) (?:has|have) access to this repository\\.?$"
				},
				{
					"id": "repo-settings/entity-access",
					"pattern": "^entit(y|ies) (?:has|have) access to this repository\\.?$"
				},
				// 同一句的第三种切法（实测 2026-09-27）：`<strong>2 entities</strong>
				// have access to this repository.` —— 数量与名词被 <strong> 框在一起，
				// 动词短语单独成节点，上面两条整串规则都命中不了，故各补一条碎片规则
				{
					"id": "repo-settings/entity-count",
					"pattern": "^([\\d,]+) entit(?:y|ies)$"
				},
				{
					"id": "repo-settings/entity-access-tail",
					"pattern": "^(?:has|have) access to this repository\\.?$"
				},
				{
					"id": "repo-settings/user-team-access-count",
					"pattern": "^(?<users>[\\d,]+) users? and (?<teams>[\\d,]+) teams? can access this repository through the organization\\.?$"
				},
				{
					"id": "repo-settings/team-access",
					"pattern": "^teams? can access this repository through the organization\\.?$"
				},
				{
					"id": "repo-settings/access-through-org",
					"pattern": "^can access this repository through the organization\\.?$"
				},
				// 角色下拉按钮「Role: write」等，角色值小写、随当前权限变化
				{
					"id": "repo-settings/role-read",
					"pattern": "^Role: read$"
				},
				{
					"id": "repo-settings/role-triage",
					"pattern": "^Role: triage$"
				},
				{
					"id": "repo-settings/role-write",
					"pattern": "^Role: write$"
				},
				{
					"id": "repo-settings/role-maintain",
					"pattern": "^Role: maintain$"
				},
				{
					"id": "repo-settings/role-admin",
					"pattern": "^Role: admin$"
				},
				// 混合角色提示：经由组织所有权授予的 admin（组织名随页面变化）
				{
					"id": "repo-settings/admin-owner",
					"pattern": "^Admin as owner of the (.+) organization\\.?$"
				},
				{
					"id": "repo-settings/as-owner",
					"pattern": "^as owner of the (.+) organization\\.?$"
				},
				// —— 规则集（/owner/repo/settings/rules 与 /settings/rules/<id>）——
				// 证据：维护者 2026-09-27 的漏翻清单与列表页截图。规则集页的「含动态值」文案
				// 全是文本节点（不含属性——属性不走规则，故组合型 aria-label 在词条侧各收一条）。
				// 列表行计数：`8 branch rules • targeting 1 branch`。分隔符在实机是项目符号，
				// 但 GitHub 的标题类文案用中点（见 pages/repo-settings 的 Settings · GitHub Copilot · …），
				// 两种字形都收进字符类，免得改版时静默失效。
				{
					"id": "repo-settings/ruleset-branch-rules-count",
					"pattern": "^(\\d+) branch rules? [\\u2022\\u00B7] targeting (\\d+) branch(?:es)?$"
				},
				// 目标分支的计数（`1 target`）
				{
					"id": "repo-settings/ruleset-target-count",
					"pattern": "^(\\d+) targets?$"
				},
				// 文档标题（面包屑）：`Settings · Ruleset · <仓库名>` 与
				// `Settings · Rulesets · <仓库名>`，仓库名保留原文。
				// 实测 2026-09-27：新建页与详情页的 payload title 是**单数** Ruleset
				// （原始英文页 /Koishi-CE/koishi/settings/rules/new 的 title 即
				// `Settings · Ruleset · koishi`），列表页才是复数 Rulesets，
				// 故用 Rulesets? 同时覆盖两种形态
				{
					"id": "repo-settings/ruleset-breadcrumb",
					"pattern": "^Settings [\\u2022\\u00B7] Rulesets? [\\u2022\\u00B7] (.+)$"
				},
				// 绕过名单的类别筛选器：`Apps • <应用名>`，应用名是动态值
				{
					"id": "repo-settings/ruleset-actor-category",
					"pattern": "^Apps [\\u2022\\u00B7] (.+)$"
				},
				// 目标分支条件的删除按钮（sr-only）：`Delete include of <分支模式>`。
				// 默认分支那一条先命中，输出中文；自定义模式保留模式原文（模式是用户内容）
				{
					"id": "repo-settings/ruleset-delete-include-default",
					"pattern": "^Delete include of Default$"
				},
				{
					"id": "repo-settings/ruleset-delete-include",
					"pattern": "^Delete include of (.+)$"
				},
				// —— Actions 设置页（/owner/repo/settings/actions）——
				// 含组织名 / 仓库名的四条文案（组织名是动态值，实机形如 `Allow Oppenheymu …`）。
				// 「Allow <org>, and select non-<org>, …」必须排在「Allow <org> …」之前：
				// 后者的 (.+) 是贪婪的，会把前者的整段描述吞进去，首条命中生效的顺序决定成败
				{
					"id": "repo-settings/actions-allow-org-selective",
					"pattern": "^Allow (.+), and select non-.+, actions and reusable workflows$"
				},
				{
					"id": "repo-settings/actions-allow-org",
					"pattern": "^Allow (.+) actions and reusable workflows$"
				},
				{
					"id": "repo-settings/actions-org-workflow",
					"pattern": "^Any action or reusable workflow defined in a repository within (.+) can be used\\.$"
				},
				{
					"id": "repo-settings/actions-org-criteria",
					"pattern": "^Any action or reusable workflow that matches the specified criteria, plus those defined in a repository within (.+), can be used\\.$"
				},
				// 文档标题：`Actions settings · <owner>/<repo>`，仓库名保留原文
				{
					"id": "repo-settings/actions-settings-title",
					"pattern": "^Actions settings [\\u2022\\u00B7] (.+)$"
				},
				// 运行器两支的面包屑标题（仓库名保留原文）。侧栏那个单独的 `Runners`
				// 是另一条静态词条，不会命中这两条（它们都要求分隔符与仓库名）
				{
					"id": "repo-settings/runners-title",
					"pattern": "^Runners [\\u2022\\u00B7] (.+)$"
				},
				{
					"id": "repo-settings/runners-new-title",
					"pattern": "^Add new self-hosted runner [\\u2022\\u00B7] (.+)$"
				},
				// Actions 策略与策略洞察两支的面包屑标题（仓库名保留原文）。
				// 与既有的 repo-settings/settings-title（`^Settings: (.+)$`，带冒号）互不干扰
				{
					"id": "repo-settings/actions-policies-title",
					"pattern": "^Settings [\\u2022\\u00B7] Actions policies [\\u2022\\u00B7] (.+)$"
				},
				{
					"id": "repo-settings/insights-title",
					"pattern": "^Settings [\\u2022\\u00B7] Insights [\\u2022\\u00B7] (.+)$"
				},
				// —— 网络钩子页（/owner/repo/settings/hooks）——
				// 列表页那句说明的撇号在实机是直是弯尚未拿到 HTML 证实（新建页实测是直撇号
				// `We'll`，列表页大概率相同），故用字符类同时覆盖两种写法。
				// 新建页那句原本也靠规则兜底，2026-09-27 拿到**未装扩展**的实机 HTML 后
				// 已确认节点边界（两个 <code> 把句子切开五项），改为五条静态键，规则已删
				{
					"id": "repo-settings/webhooks-intro",
					"pattern": "^Webhooks allow external services to be notified when certain events happen\\. When the specified events happen, we['\\u2019]ll send a POST request to each of the URLs you provide\\. Learn more in our$"
				},
				// —— 安全分析子页（/owner/repo/settings/security_analysis）——
				// 页头说明句含 `you're`：实机是直撇号还是弯撇号尚无 HTML 逐字证实（粘贴文本
				// 里的撇号形态不可靠），故用字符类同时覆盖两种写法——这条是 2026-09 网络钩子
				// 那句的同一处理方式。
				{
					"id": "repo-settings/advanced-security-intro",
					"pattern": "^Advanced Security features help keep your repository secure and updated\\. By enabling these features, you['\\u2019]re granting us permission to perform read-only analysis on your repository\\.$"
				},
				// Dependabot 规则区块的「N rule(s) enabled」：数字随启用条数变化
				{
					"id": "repo-settings/dependabot-rules-enabled-count",
					"pattern": "^(?<count>[\\d,]+) rules? enabled$"
				},
				// CodeQL 默认配置弹层的「N of M languages selected」
				{
					"id": "repo-settings/languages-selected-count",
					"pattern": "^(?<count>\\d+) of (?<total>\\d+) languages? selected$"
				},
				// 安全分析页（组织仓库）Used by counter 的包菜单：
				// `NPM · 1 dependent repository` / `NPM · 4 dependent repositories`。
				// 注册表名（NPM / Docker…）由捕获组带回模板、保持英文；分隔符在实机是中点，
				// 但仍用字符类同时覆盖中点与项目符号（与既有规则同一处理方式）。
				{
					"id": "repo-settings/dependent-repositories-count",
					"pattern": "^(?<registry>\\S+) [\\u00b7\\u2022] (?<count>[\\d,]+) dependent repositor(?:y|ies)$"
				}
			]
		},
		{
			"name": "pages/org-settings",
			"rules": [
				// 组织设置页的 document.title：`Settings · Repository policies · Koishi-CE`。
				// 中段是页面名（英文：规则不递归，故原样带回）、末段是组织名（用户内容）。
				// 分隔符在实机是中点，仍用字符类同时覆盖中点与项目符号（与既有规则一致）。
				// 与 repo-settings 的 `^Settings: (.+)$`（带冒号）互不干扰。
				{
					"id": "org-settings/page-title",
					"pattern": "^Settings [\\u00b7\\u2022] (?<page>.+) [\\u00b7\\u2022] (?<org>.+)$"
				}
			]
		},
		{
			"name": "pages/actions",
			"rules": [
				// 运行时长：12s / 3m 40s / 1h 2m 3s（长格式在前，首条命中生效）
				{
					"id": "actions/duration-hms",
					"pattern": "^(?<hours>[\\d,]+)h (?<minutes>[\\d,]+)m (?<seconds>[\\d,]+)s$"
				},
				{
					"id": "actions/duration-hm",
					"pattern": "^(?<hours>[\\d,]+)h (?<minutes>[\\d,]+)m$"
				},
				{
					"id": "actions/duration-ms",
					"pattern": "^(?<minutes>[\\d,]+)m (?<seconds>[\\d,]+)s$"
				},
				{
					"id": "actions/duration-s",
					"pattern": "^([\\d,]+)s$"
				},
				// 运行行菜单「查看」链接与 sr-only 页头标题
				{
					"id": "actions/view-number",
					"pattern": "^View #(\\d+)$"
				},
				{
					"id": "actions/page-title",
					"pattern": "^Actions: ([^/]+\\/[^/]+)$"
				},
				// 运行计数与带仓库名的页头标题
				{
					"id": "actions/workflow-runs-count-plus",
					"pattern": "^([\\d,]+)\\+ workflow runs?$"
				},
				{
					"id": "actions/workflow-runs-count",
					"pattern": "^([\\d,]+) workflow runs?$"
				},
				{
					"id": "actions/workflow-runs-title",
					"pattern": "^Workflow runs \\u00B7 (.+)$"
				},
				// 运行行「opened by <用户>」片段：内部空白随 JSX 渲染浮动，用 \s+ 容错
				{
					"id": "actions/opened-by",
					"pattern": "^opened\\s+by$"
				}
			]
		},
		{
			"name": "pages/agents",
			"rules": [
				// 会话计数与带仓库名的页头标题
				{
					"id": "agents/sessions-count",
					"pattern": "^([\\d,]+) sessions?$"
				},
				{
					"id": "agents/page-title",
					"pattern": "^Agents \\u00B7 (.+)$"
				}
			]
		},
		{
			"name": "pages/dashboard",
			"rules": [
				// 首页问候语：时段 + 用户名。用户名是用户内容，捕获后原样保留
				// （`\\S+` 只吃到逗号为止，用户名里的空格不会误匹配）。
				// **三个时段各一条 pattern**（而不是一条 `(morning|afternoon|evening)` +
				// 模板里换位）：替换模板只能搬运捕获组原文，无法把 `afternoon` 映射成「下午」，
				// 一条规则写出来会渲染成「afternoon好，…」。三条 pattern 同模块内互不相同。
				{
					"id": "dashboard/greeting-morning",
					"pattern": "^Good morning, (\\S+)!$"
				},
				{
					"id": "dashboard/greeting-afternoon",
					"pattern": "^Good afternoon, (\\S+)!$"
				},
				{
					"id": "dashboard/greeting-evening",
					"pattern": "^Good evening, (\\S+)!$"
				},
				// 「按 … 优化」档位按钮：档位名由 GitHub 自己译出，实机节点是**半中半英**的
				// 「Optimized for: 均衡」。它能走到本规则，靠的是 filters 的
				// isTranslatableText 放行「含拉丁字母的混合节点」（见该函数说明）——
				// 只收 `.+` 会让规则在整段上命中而模板不引用捕获组，故用 `\\s*` 只吃前缀，
				// 档位名原样留在译文里。
				{
					"id": "dashboard/optimized-for",
					"pattern": "^Optimized for:\\s*"
				}
			]
		},
		{
			"name": "pages/commits",
			"rules": [
				// 标签行「…」按钮的悬浮提示（tool-tip 文本节点，含标签名）
				{
					"id": "commits/toggle-commit-message",
					"pattern": "^Toggle (.+)'s commit message$"
				},
				// 差异统计的读屏文本（含行数，单复数通吃）
				{
					"id": "commits/lines-changed",
					"pattern": "^Lines changed: (?<additions>\\d+) additions? & (?<deletions>\\d+) deletions?$"
				},
				// 提交行 SHA 复制按钮的悬浮提示（tool-tip 文本节点，含短哈希）
				{
					"id": "commits/copy-sha",
					"pattern": "^Copy full SHA for ([0-9a-f]+)$"
				},
				// 提交行「…」展开按钮的悬浮提示（tool-tip 文本节点，含短哈希）
				{
					"id": "commits/show-description",
					"pattern": "^Show description for ([0-9a-f]+)$"
				},
				// 提交列表按日期分组的标题（月份缩写逐月映射，同 global.jsonc）
				{
					"id": "commits/on-jan",
					"pattern": "^Commits on Jan (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-feb",
					"pattern": "^Commits on Feb (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-mar",
					"pattern": "^Commits on Mar (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-apr",
					"pattern": "^Commits on Apr (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-may",
					"pattern": "^Commits on May (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-jun",
					"pattern": "^Commits on Jun (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-jul",
					"pattern": "^Commits on Jul (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-aug",
					"pattern": "^Commits on Aug (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-sep",
					"pattern": "^Commits on Sep (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-oct",
					"pattern": "^Commits on Oct (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-nov",
					"pattern": "^Commits on Nov (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "commits/on-dec",
					"pattern": "^Commits on Dec (?<day>\\d{1,2}), (?<year>\\d{4})$"
				}
			]
		},
		{
			"name": "pages/wiki",
			"rules": [
				// 页脚编辑记录（用户名原样保留）
				{
					"id": "wiki/edited-page",
					"pattern": "^(.+) edited this page$"
				},
				// 页脚修订计数（单复数通吃）
				{
					"id": "wiki/revisions-count",
					"pattern": "^([\\d,]+) revisions?$"
				},
				// 侧栏展开剩余页面的按钮
				{
					"id": "wiki/more-pages",
					"pattern": "^Show (\\d+) more pages\\u2026$"
				},
				// 标签页标题（页面名与仓库名原样保留）
				{
					"id": "wiki/page-title",
					"pattern": "^(?<title>.+) \\u00B7 (?<repo>[^/]+\\/[^/]+) Wiki \\u00B7 GitHub$"
				}
			]
		},
		{
			"name": "pages/insights",
			"rules": [
				// 复刻行 Created 后的裸时长与 Period 选项（无 ago 后缀，
				// 与 global 的「N units ago」规则区分）
				{
					"id": "insights/hours",
					"pattern": "^(\\d+) hours?$"
				},
				{
					"id": "insights/days",
					"pattern": "^(\\d+) days?$"
				},
				{
					"id": "insights/weeks",
					"pattern": "^(\\d+) weeks?$"
				},
				{
					"id": "insights/months",
					"pattern": "^(\\d+) months?$"
				},
				{
					"id": "insights/years",
					"pattern": "^(\\d+) years?$"
				},
				// 页标题与区块标题（Insights / 页面名译出，仓库名属内容原样保留）
				{
					"id": "insights/page-title",
					"pattern": "^Insights: (.+)$"
				},
				{
					"id": "insights/contributors-title",
					"pattern": "^Contributors to (.+) \\u00B7 GitHub$"
				},
				{
					"id": "insights/security-title",
					"pattern": "^Security: (.+)$"
				},
				{
					"id": "insights/forks-title",
					"pattern": "^Forks \\u00B7 (.+) \\u00B7 GitHub$"
				},
				{
					"id": "insights/projects-title",
					"pattern": "^Projects \\u00B7 (.+) \\u00B7 GitHub$"
				},
				{
					"id": "insights/pulse-title",
					"pattern": "^Pulse \\u00B7 (.+) \\u00B7 GitHub$"
				},
				{
					"id": "insights/overview-title",
					"pattern": "^Overview \\u00B7 (.+) \\u00B7 GitHub$"
				},
				// Pulse 周期区间（全月名同月区间；跨月区间不命中保持原文）
				{
					"id": "insights/range-long-january",
					"pattern": "^January (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 January (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-february",
					"pattern": "^February (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 February (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-march",
					"pattern": "^March (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 March (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-april",
					"pattern": "^April (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 April (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-may",
					"pattern": "^May (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 May (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-june",
					"pattern": "^June (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 June (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-july",
					"pattern": "^July (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 July (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-august",
					"pattern": "^August (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 August (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-september",
					"pattern": "^September (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 September (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-october",
					"pattern": "^October (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 October (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-november",
					"pattern": "^November (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 November (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				{
					"id": "insights/range-long-december",
					"pattern": "^December (?<startDay>\\d{1,2}), (?<startYear>\\d{4}) \\u2013 December (?<endDay>\\d{1,2}), (?<endYear>\\d{4})$"
				},
				// 图表轴刻度：年月（Aug 2026 → 2026 年 8 月）
				{
					"id": "insights/month-year-jan",
					"pattern": "^Jan (\\d{4})$"
				},
				{
					"id": "insights/month-year-feb",
					"pattern": "^Feb (\\d{4})$"
				},
				{
					"id": "insights/month-year-mar",
					"pattern": "^Mar (\\d{4})$"
				},
				{
					"id": "insights/month-year-apr",
					"pattern": "^Apr (\\d{4})$"
				},
				{
					"id": "insights/month-year-may",
					"pattern": "^May (\\d{4})$"
				},
				{
					"id": "insights/month-year-jun",
					"pattern": "^Jun (\\d{4})$"
				},
				{
					"id": "insights/month-year-jul",
					"pattern": "^Jul (\\d{4})$"
				},
				{
					"id": "insights/month-year-aug",
					"pattern": "^Aug (\\d{4})$"
				},
				{
					"id": "insights/month-year-sep",
					"pattern": "^Sep (\\d{4})$"
				},
				{
					"id": "insights/month-year-oct",
					"pattern": "^Oct (\\d{4})$"
				},
				{
					"id": "insights/month-year-nov",
					"pattern": "^Nov (\\d{4})$"
				},
				{
					"id": "insights/month-year-dec",
					"pattern": "^Dec (\\d{4})$"
				},
				// 图表轴刻度：月日（Aug 10 → 8 月 10 日）
				{
					"id": "insights/month-day-jan",
					"pattern": "^Jan (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-feb",
					"pattern": "^Feb (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-mar",
					"pattern": "^Mar (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-apr",
					"pattern": "^Apr (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-may",
					"pattern": "^May (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-jun",
					"pattern": "^Jun (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-jul",
					"pattern": "^Jul (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-aug",
					"pattern": "^Aug (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-sep",
					"pattern": "^Sep (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-oct",
					"pattern": "^Oct (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-nov",
					"pattern": "^Nov (\\d{1,2})$"
				},
				{
					"id": "insights/month-day-dec",
					"pattern": "^Dec (\\d{1,2})$"
				},
				// Highcharts 图表无障碍描述（轴名随图表固定，直接译入句中；
				// 双空格键经引擎空白归一后按单空格匹配）
				{
					"id": "insights/chart-x-axis-time",
					"pattern": "^The chart has (?<axisCount>\\d+) X ax(?:is|es) displaying Time\\. Data ranges from (?<from>.+) to (?<to>.+)\\.$"
				},
				{
					"id": "insights/chart-x-axis-navigator",
					"pattern": "^The chart has (\\d+) X axes displaying Time, and navigator-x-axis\\.$"
				},
				{
					"id": "insights/chart-y-axis-contributions",
					"pattern": "^The chart has (?<axisCount>\\d+) Y ax(?:is|es) displaying Contributions\\. Data ranges from (?<from>-?[\\d.]+) to (?<to>-?[\\d.]+)\\.$"
				},
				{
					"id": "insights/chart-y-axis-navigator",
					"pattern": "^The chart has (\\d+) Y axes displaying Contributions, and navigator-y-axis\\.$"
				},
				{
					"id": "insights/chart-combination-series",
					"pattern": "^Combination chart with (\\d+) data series\\.$"
				},
				// Pulse 统计缩写计数（1k → 1 千）
				{
					"id": "insights/k-suffix",
					"pattern": "^([\\d.]+)k$"
				},
				// Highcharts 无障碍文案（数字随图表变化）
				{
					"id": "insights/chart-bar",
					"pattern": "^Bar chart with (\\d+) bars?\\.$"
				},
				{
					"id": "insights/highcharts-credit",
					"pattern": "^Created with Highcharts ([\\d.]+)$"
				},
				{
					"id": "insights/chart-navigator-series",
					"pattern": "^Navigator (?<navigator>\\d+), series (?<series>\\d+) of (?<seriesCount>\\d+) with (?<points>[\\d,]+) data points\\. Y axis, (?<yAxis>.+)\\. X axis, (?<xAxis>.+)\\.$"
				}
			]
		},
		{
			"name": "pages/search",
			"rules": [
				// 主题页排序下拉里按子主题过滤的选项标题（主题名保留原文）
				{
					"id": "search/topic",
					"pattern": "^Topic: (.+)$"
				},
				{
					"id": "search/users-starred-count",
					"pattern": "^([\\d,]+) users? starred this repository$"
				},
				{
					"id": "search/stars-count",
					"pattern": "^([\\d,]+) stars?$"
				},
				{
					"id": "search/results-count",
					"pattern": "^([\\d,]+) results?$"
				},
				// 「Updated on <日期>」的日期段，月份缩写保留原文
				{
					"id": "search/on-date",
					"pattern": "^on ([A-Z][a-z]{2} \\d{1,2}(?:, \\d{4})?)$"
				},
				// 主题页导语：数量动态，查询键已把连续空白折叠为单空格
				{
					"id": "search/topic-repos-count",
					"pattern": "^Here are ([\\d,]+) public repositor(?:y|ies) matching this topic\\.\\.\\.$"
				}
			]
		},
		{
			"name": "pages/profile",
			"rules": [
				// 组织 / 用户仓库列表的提交动态说明（仓库名为用户内容，捕获保留）
				{
					"id": "profile/commit-activity-year",
					"pattern": "^([\\w.-]+\\/[\\w.-]+)['\\u2019]s past year of commit activity$"
				},
				// 仓库卡片的「需要帮助」议题计数（单复数折叠）
				{
					"id": "profile/issues-needing-help",
					"pattern": "^\\(([\\d,]+) issues? needs? help\\)$"
				},
				// 屏蔽 / 举报对话框标题带用户名（捕获保留；固定文案走静态词条）
				{
					"id": "profile/block-or-report",
					"pattern": "^Block or report ([\\w.-]+)$"
				},
				// 仓库列表分页说明
				{
					"id": "profile/showing-of-repos",
					"pattern": "^Showing (?<count>\\d+) of (?<total>[\\d,]+) repositor(?:y|ies)$"
				},
				// 结果摘要的计数节点（`5` 被 <strong> 单独包住，故数字自成一个节点）
				{
					"id": "profile/repo-results-count",
					"pattern": "^([\\d,]+) results?$"
				},
				// 摘要里数字之后的那半句；带类型筛选时它被 <strong> 截断，只剩到 "for" 为止。
				// 2026-10-02 起 pattern 同时接受**带计数**的形态（`5 results for`）：
				// 同一段文字在实机上两种边界都出现过（数字被 <strong> 拆出去 / 留在一起），
				// 模板用可空引用 `$<count:>` 同时覆盖——计数缺席时它展开成空串。
				// 量词归这条译文（「个结果，」）：数字在它**前面紧邻**的节点里，
				// 拼接顺序天然正确，见 locales/zh-CN/pages/profile.jsonc 的两条片段硬规则。
				{
					"id": "profile/repo-results-filtered",
					"pattern": "^(?:(?<count>[\\d,]+) )?results? for$"
				},
				// 被截断的后半句（筛选类型嵌在中间：`source` 是独立节点）。
				// **不含量词**：`5` 数的是结果、不是仓库；「个仓库」是凭空多出来的量词。
				{
					"id": "profile/repo-results-repos",
					"pattern": "^repositor(?:y|ies) sorted by$"
				},
				// 贡献日历标题：计数与年份在同一节点（「2,546 contributions in 2026」）
				{
					"id": "profile/contributions-in-year",
					"pattern": "^(?<count>[\\d,]+) contributions? in (?<year>\\d{4})$"
				},
				// 计数若在独立节点里（加粗数字），剩下的半句只带年份
				{
					"id": "profile/contributions-of-year",
					"pattern": "^contributions in (\\d{4})$"
				},
				// 私有贡献摘要：实机 HTML 是 `<span>1 contribution in private repositories</span>`
				// 一个节点（单复数折叠）。计数若被自己的 span 拆成独立节点，计数节点由
				// global 的 global/contributions-count 接手；半句**刻意不收静态词条**——收了
				// 它就会先于本规则命中剩下的整段文本，把它压成「次贡献，来自私有仓库」
				//（见 content/walker.ts 的查表顺序：静态词典 → 规则）。
				{
					"id": "profile/contributions-private",
					"pattern": "^(?<count>[\\d,]+) contributions? in private repositories$"
				},
				// 置顶项编辑器的剩余可选数量（整句成节点时命中；数字独立成节点则走静态词条）
				{
					"id": "profile/pins-remaining",
					"pattern": "^(\\d+) remaining$"
				},
				// 贡献动态时间线的分类折叠汇总：计数与仓库数都动态、单复数折叠。
				// 节点内换行缩进在匹配前已折叠为单空格（见 content/walker.ts 的 normalizeKey），
				// 故 pattern 按单空格书写。
				{
					"id": "profile/created-commits",
					"pattern": "^Created (?<count>[\\d,]+) commits? in (?<repos>[\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "profile/created-repositories",
					"pattern": "^Created ([\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "profile/opened-other-pulls",
					"pattern": "^Opened (?<count>[\\d,]+) other pull requests? in (?<repos>[\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "profile/opened-other-issues",
					"pattern": "^Opened (?<count>[\\d,]+) other issues? in (?<repos>[\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "profile/reviewed-pulls",
					"pattern": "^Reviewed (?<count>[\\d,]+) pull requests? in (?<repos>[\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "profile/started-discussions",
					"pattern": "^Started (?<count>[\\d,]+) discussions? in (?<repos>[\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "profile/answered-discussions",
					"pattern": "^Answered (?<count>[\\d,]+) discussions? in (?<repos>[\\d,]+) repositor(?:y|ies)$"
				},
				// 亮点区尾段：「…, <仓库链接> and 32 other repositories」（独立节点，计数动态）
				{
					"id": "profile/and-other-repositories",
					"pattern": "^and ([\\d,]+) other repositor(?:y|ies)$"
				},
				// 时间线条目被仓库链接拆开后的后半句：「…<仓库链接> that received 4 comments」
				{
					"id": "profile/that-received-comments",
					"pattern": "^that received ([\\d,]+) comments?$"
				},
				// 登录态若把整句渲染成单个节点（没有链接拆分的形态），用整句规则兜底：
				// 与上面两条「碎片路径」互斥，命中其一即止，两条路径都不至于漏翻
				{
					"id": "profile/created-pull-request",
					"pattern": "^Created a pull request in ([\\w.-]+\\/[\\w.-]+) that received ([\\d,]+) comments?$"
				},
				{
					"id": "profile/created-issue",
					"pattern": "^Created an issue in ([\\w.-]+\\/[\\w.-]+) that received ([\\d,]+) comments?$"
				},
				// 组织动态：「Joined the <组织链接> organization」同样可能整句成节点
				{
					"id": "profile/joined-organization",
					"pattern": "^Joined the (\\S+) organization$"
				},
				// 时间线日期（月份缩写 + 日；个别条目带 "on " 前缀）。
				// 带年份的日期（「Sep 25, 2025」）由 global 的 short-date-* 规则接手。
				{
					"id": "profile/short-date-jan",
					"pattern": "^(?:on )?Jan (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-feb",
					"pattern": "^(?:on )?Feb (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-mar",
					"pattern": "^(?:on )?Mar (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-apr",
					"pattern": "^(?:on )?Apr (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-may",
					"pattern": "^(?:on )?May (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-jun",
					"pattern": "^(?:on )?Jun (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-jul",
					"pattern": "^(?:on )?Jul (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-aug",
					"pattern": "^(?:on )?Aug (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-sep",
					"pattern": "^(?:on )?Sep (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-oct",
					"pattern": "^(?:on )?Oct (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-nov",
					"pattern": "^(?:on )?Nov (\\d{1,2})$"
				},
				{
					"id": "profile/short-date-dec",
					"pattern": "^(?:on )?Dec (\\d{1,2})$"
				}
			]
		},
		{
			"name": "pages/repo",
			"rules": [
				{
					"id": "repo/commits-count",
					"pattern": "^([\\d,]+) Commits$"
				},
				{
					"id": "repo/reactions-count",
					"pattern": "^(\\d+) reactions?$"
				},
				{
					"id": "repo/people-reacted",
					"pattern": "^([\\d,]+) people reacted$"
				},
				// 仓库侧栏的三个计数（星标 / 关注 / 复刻）：实机是「数字 + 单位」的单个节点，
				// 数字会随仓库变化（也会出现 4.1k 这类缩写形态，故 `[\\d.,k]+` 一并收）
				{
					"id": "repo/stars-count",
					"pattern": "^([\\d.,k]+) stars?$"
				},
				{
					"id": "repo/watchers-count",
					"pattern": "^([\\d.,k]+) watching$"
				},
				{
					"id": "repo/forks-count",
					"pattern": "^([\\d.,k]+) forks?$"
				}
			]
		},
		{
			"name": "global",
			"rules": [
				// 跨页面通用正则规则：相对时间与计数等动态文本
				// 语义：pattern 对整段已 trim 文本 test，命中即 replace（首条命中生效）
				// 硬性约束：模板（locales/<语言>/rules.jsonc）必须含目标语言的文字系统（防观察器翻译循环）；
				// 规则无 flags 字段，故 g / y 不可能出现
				// JSONC 转义：正则 \d 在此写作 \\d（写漏一层 Bun 直接报 Syntax Error，不会静默变义）
				// 全站通用规则集合（global 兜底，页面模块规则先于它生效）
				// 相对时间：<relative-time> 渲染的英文文本，单复数通吃
				{
					"id": "global/now",
					"pattern": "^now$"
				},
				{
					"id": "global/yesterday",
					"pattern": "^yesterday$"
				},
				{
					"id": "global/seconds-ago",
					"pattern": "^(\\d+) seconds? ago$"
				},
				{
					"id": "global/minutes-ago",
					"pattern": "^(\\d+) minutes? ago$"
				},
				{
					"id": "global/hours-ago",
					"pattern": "^(\\d+) hours? ago$"
				},
				{
					"id": "global/days-ago",
					"pattern": "^(\\d+) days? ago$"
				},
				{
					"id": "global/weeks-ago",
					"pattern": "^(\\d+) weeks? ago$"
				},
				{
					"id": "global/months-ago",
					"pattern": "^(\\d+) months? ago$"
				},
				{
					"id": "global/years-ago",
					"pattern": "^(\\d+) years? ago$"
				},
				{
					"id": "global/in-seconds",
					"pattern": "^in (\\d+) seconds?$"
				},
				{
					"id": "global/in-minutes",
					"pattern": "^in (\\d+) minutes?$"
				},
				{
					"id": "global/in-hours",
					"pattern": "^in (\\d+) hours?$"
				},
				{
					"id": "global/in-days",
					"pattern": "^in (\\d+) days?$"
				},
				{
					"id": "global/in-weeks",
					"pattern": "^in (\\d+) weeks?$"
				},
				{
					"id": "global/in-months",
					"pattern": "^in (\\d+) months?$"
				},
				{
					"id": "global/in-years",
					"pattern": "^in (\\d+) years?$"
				},
				// 计数与统计；带修饰语的条目必须排在泛化条目之前（首条命中生效）
				{
					"id": "global/open-count",
					"pattern": "^([\\d,]+) Open$"
				},
				{
					"id": "global/closed-count",
					"pattern": "^([\\d,]+) Closed$"
				},
				{
					"id": "global/contributions-last-year",
					"pattern": "^([\\d,]+) contributions in the last year$"
				},
				{
					"id": "global/contributions-count",
					"pattern": "^([\\d,]+) contributions?$"
				},
				{
					"id": "global/public-repos-count",
					"pattern": "^([\\d,]+) public repositor(?:y|ies)$"
				},
				{
					"id": "global/private-repos-count",
					"pattern": "^([\\d,]+) private repositor(?:y|ies)$"
				},
				{
					"id": "global/repos-count",
					"pattern": "^([\\d,]+) repositor(?:y|ies)$"
				},
				{
					"id": "global/commits-count",
					"pattern": "^([\\d,]+) commits?$"
				},
				{
					"id": "global/contributors-count",
					"pattern": "^([\\d,]+) contributors?$"
				},
				{
					"id": "global/members-count",
					"pattern": "^([\\d,]+) members?$"
				},
				{
					"id": "global/files-changed",
					"pattern": "^([\\d,]+) files? changed$"
				},
				// 状态编辑对话框的输入提示（2026-10 实机）：剩余字数与上限都带动态数字，
				// 且同一句在可视区与 aria 描述里各渲染一次，故走规则而不是静态词条。
				{
					"id": "global/status-characters-remaining",
					"pattern": "^(?<count>[\\d,]+) characters? remaining$"
				},
				{
					"id": "global/status-characters-limit",
					"pattern": "^You can enter up to (?<count>[\\d,]+) characters$"
				},
				// emoji 选择按钮的 tooltip：`:dart:` 是上游的 emoji 别名（专名，原样保留）
				{
					"id": "global/status-emoji-tooltip",
					"pattern": "^Select an emoji: (?<alias>:[a-z0-9_+-]+:)$"
				},
				// 全站专属规则：绝对日期、回应记录与零散计数（commonRules 兜底之外的补充）
				// 绝对日期（月份缩写）：Sep 25, 2026 → 2026 年 9 月 25 日
				{
					"id": "global/short-date-jan",
					"pattern": "^Jan (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-feb",
					"pattern": "^Feb (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-mar",
					"pattern": "^Mar (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-apr",
					"pattern": "^Apr (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-may",
					"pattern": "^May (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-jun",
					"pattern": "^Jun (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-jul",
					"pattern": "^Jul (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-aug",
					"pattern": "^Aug (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-sep",
					"pattern": "^Sep (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-oct",
					"pattern": "^Oct (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-nov",
					"pattern": "^Nov (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/short-date-dec",
					"pattern": "^Dec (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				// 绝对日期（月份全称，不带时刻）：October 5, 2026 → 2026 年 10 月 5 日
				// （May 全称与缩写同形，沿用上方规则）
				{
					"id": "global/long-date-january",
					"pattern": "^January (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-february",
					"pattern": "^February (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-march",
					"pattern": "^March (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-april",
					"pattern": "^April (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-june",
					"pattern": "^June (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-july",
					"pattern": "^July (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-august",
					"pattern": "^August (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-september",
					"pattern": "^September (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-october",
					"pattern": "^October (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-november",
					"pattern": "^November (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				{
					"id": "global/long-date-december",
					"pattern": "^December (?<day>\\d{1,2}), (?<year>\\d{4})$"
				},
				// 绝对日期（月份全称 + 时刻）：November 27, 2014 16:57 → 2014 年 11 月 27 日 16:57
				{
					"id": "global/long-date-time-january",
					"pattern": "^January (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-february",
					"pattern": "^February (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-march",
					"pattern": "^March (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-april",
					"pattern": "^April (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-may",
					"pattern": "^May (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-june",
					"pattern": "^June (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-july",
					"pattern": "^July (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-august",
					"pattern": "^August (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-september",
					"pattern": "^September (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-october",
					"pattern": "^October (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-november",
					"pattern": "^November (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				{
					"id": "global/long-date-time-december",
					"pattern": "^December (?<day>\\d{1,2}), (?<year>\\d{4}) (?<time>\\d\\d:\\d\\d)$"
				},
				// 回应记录：用户名原样保留，多人以 and 连接由贪婪匹配一并覆盖
				{
					"id": "global/reaction-heart",
					"pattern": "^(.+) reacted with heart emoji$"
				},
				{
					"id": "global/reaction-rocket",
					"pattern": "^(.+) reacted with rocket emoji$"
				},
				{
					"id": "global/reaction-thumbs-up",
					"pattern": "^(.+) reacted with thumbs up emoji$"
				},
				{
					"id": "global/reaction-eyes",
					"pattern": "^(.+) reacted with eyes emoji$"
				},
				{
					"id": "global/reaction-laugh",
					"pattern": "^(.+) reacted with laugh emoji$"
				},
				{
					"id": "global/reaction-hooray",
					"pattern": "^(.+) reacted with hooray emoji$"
				},
				// 零散计数
				{
					"id": "global/tasks-count",
					"pattern": "^(\\d+) tasks?$"
				},
				{
					"id": "global/files-count",
					"pattern": "^(\\d+) files?$"
				},
				{
					"id": "global/forks-count",
					"pattern": "^([\\d,]+) forks?$"
				},
				{
					"id": "global/comments-count",
					"pattern": "^([\\d,]+) comments?$"
				},
				// 页脚版权年份
				{
					"id": "global/copyright-year",
					"pattern": "^\\u00A9 (\\d{4}) GitHub, Inc\\.$"
				},
				// —— 相对时间的「数量 + 单位」变体（2026-10-02 维护者在 /Oppenheymu?tab=repositories
				// 报「2 minutes ago 没翻译」时顺带排查出的缺口）——
				// 上面的 global/{unit}s-ago 只覆盖 `N units ago`。GitHub 的 <relative-time>
				// 由 Intl.RelativeTimeFormat 驱动，同一语义还会渲染出下列形态（在 Node 里直接跑
				// Intl 枚举出来的英文集合，见 docs/guides/development.md 的采集流程）：
				//   数量带小数：1.5 hours ago（git blame / 提交日期上真会这样渲染）
				//   冠词代替数字：a minute ago / less than a minute ago
				//   模糊限定词：about / over / almost + a|N units ago
				// 这一组与 `in-*` 组一样是**整段锚定**的，只吃完整的相对时间节点，
				// 不会误伤正文（如「about 3 minutes ago」这种散文短语不会出现整段相等的情形）。
				{
					"id": "global/fractional-seconds-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) seconds? ago$"
				},
				{
					"id": "global/fractional-minutes-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) minutes? ago$"
				},
				{
					"id": "global/fractional-hours-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) hours? ago$"
				},
				{
					"id": "global/fractional-days-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) days? ago$"
				},
				{
					"id": "global/fractional-weeks-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) weeks? ago$"
				},
				{
					"id": "global/fractional-months-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) months? ago$"
				},
				{
					"id": "global/fractional-years-ago",
					"pattern": "^(\\d+(?:\\.\\d+)?) years? ago$"
				},
				// 冠词形态（a / an 都出现，an 只用于 hour）。捕获组**可选**，故模板用
				// `$<count:...>` 形式的默认值引用补上数字（模板不能做值映射，见 shared/types.ts）。
				// 冠词形态（a / an 都出现，an 只用于 hour）。捕获组只收数字，
				// 冠词由 `(?:an? )` 吃掉，于是 `a minute ago` 与 `an hour ago` 都靠模板的
				// `$<count:1>` 默认值补出「1」——模板不能做 a→1 的值映射，
				// 把冠词排除在捕获组之外是唯一无需映射的写法（见 shared/types.ts 的说明）。
				{
					"id": "global/a-second-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )seconds? ago$"
				},
				{
					"id": "global/a-minute-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )minutes? ago$"
				},
				{
					"id": "global/a-hour-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )hours? ago$"
				},
				{
					"id": "global/a-day-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )days? ago$"
				},
				{
					"id": "global/a-week-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )weeks? ago$"
				},
				{
					"id": "global/a-month-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )months? ago$"
				},
				{
					"id": "global/a-year-ago",
					"pattern": "^(?:an? |(?<count>\\d+(?:\\.\\d+)?) )years? ago$"
				},
				// 「不到」形态：数量可省，也可写成冠词
				// （less than a minute ago / less than 2 minutes ago）
				{
					"id": "global/less-than-seconds-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?seconds? ago$"
				},
				{
					"id": "global/less-than-minutes-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?minutes? ago$"
				},
				{
					"id": "global/less-than-hours-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?hours? ago$"
				},
				{
					"id": "global/less-than-days-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?days? ago$"
				},
				{
					"id": "global/less-than-weeks-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?weeks? ago$"
				},
				{
					"id": "global/less-than-months-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?months? ago$"
				},
				{
					"id": "global/less-than-years-ago",
					"pattern": "^less than (?:an? |(?<count>\\d+) )?years? ago$"
				},
				// 「大约」形态：数量可省、可带小数
				{
					"id": "global/about-seconds-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?seconds? ago$"
				},
				{
					"id": "global/about-minutes-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?minutes? ago$"
				},
				{
					"id": "global/about-hours-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?hours? ago$"
				},
				{
					"id": "global/about-days-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?days? ago$"
				},
				{
					"id": "global/about-weeks-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?weeks? ago$"
				},
				{
					"id": "global/about-months-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?months? ago$"
				},
				{
					"id": "global/about-years-ago",
					"pattern": "^about (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?years? ago$"
				},
				// 「超过」形态
				{
					"id": "global/over-seconds-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?seconds? ago$"
				},
				{
					"id": "global/over-minutes-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?minutes? ago$"
				},
				{
					"id": "global/over-hours-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?hours? ago$"
				},
				{
					"id": "global/over-days-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?days? ago$"
				},
				{
					"id": "global/over-weeks-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?weeks? ago$"
				},
				{
					"id": "global/over-months-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?months? ago$"
				},
				{
					"id": "global/over-years-ago",
					"pattern": "^over (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?years? ago$"
				},
				// 「快满」形态
				{
					"id": "global/almost-seconds-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?seconds? ago$"
				},
				{
					"id": "global/almost-minutes-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?minutes? ago$"
				},
				{
					"id": "global/almost-hours-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?hours? ago$"
				},
				{
					"id": "global/almost-days-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?days? ago$"
				},
				{
					"id": "global/almost-weeks-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?weeks? ago$"
				},
				{
					"id": "global/almost-months-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?months? ago$"
				},
				{
					"id": "global/almost-years-ago",
					"pattern": "^almost (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?years? ago$"
				},
				// 「半」形态（half a minute ago / half an hour ago）
				{
					"id": "global/half-seconds-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?seconds? ago$"
				},
				{
					"id": "global/half-minutes-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?minutes? ago$"
				},
				{
					"id": "global/half-hours-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?hours? ago$"
				},
				{
					"id": "global/half-days-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?days? ago$"
				},
				{
					"id": "global/half-weeks-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?weeks? ago$"
				},
				{
					"id": "global/half-months-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?months? ago$"
				},
				{
					"id": "global/half-years-ago",
					"pattern": "^half (?:an? |(?<count>\\d+(?:\\.\\d+)?) )?years? ago$"
				},
				// 未来方向的同类变体：`in 2 hours` / `in a minute` / `in less than a minute`
				// 与 `in about 2 hours` 都是同一族（数量可省、可带小数），故只留 7 条；
				// 模板用 `$<count:1>` 补上省略的数量。
				{
					"id": "global/in-a-second",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )seconds?$"
				},
				{
					"id": "global/in-a-minute",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )minutes?$"
				},
				{
					"id": "global/in-a-hour",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )hours?$"
				},
				{
					"id": "global/in-a-day",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )days?$"
				},
				{
					"id": "global/in-a-week",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )weeks?$"
				},
				{
					"id": "global/in-a-month",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )months?$"
				},
				{
					"id": "global/in-a-year",
					"pattern": "^in (?:less than |about )?(?:an? |(?<count>\\d+(?:\\.\\d+)?) )years?$"
				}
			]
		}
	]
}
