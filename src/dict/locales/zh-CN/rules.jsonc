		"settings/timeframe-last-12-months": "时间范围：近 12 个月",
		// AI 用量页的账期选择器「月份 年份」；单组保持 $1，不命名
		"settings/month-year-jan": "$1 年 1 月",
		"settings/month-year-feb": "$1 年 2 月",
		"settings/month-year-mar": "$1 年 3 月",
		"settings/month-year-apr": "$1 年 4 月",
		"settings/month-year-may": "$1 年 5 月",
