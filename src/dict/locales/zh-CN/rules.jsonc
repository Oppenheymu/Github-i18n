		// —— 「More details」弹窗（所含用量与点数明细，模块 pages/settings-billing）——
		// 行是「<数量> included <产品> <资源>」，数量随额度变化，故按资源逐条锚定
		"settings/included-actions-minutes": "包含 $<count> 分钟 Actions 用量",
		"settings/included-actions-storage": "包含 $<count> $<unit> Actions 存储",
		"settings/included-git-lfs-bandwidth": "包含 $<count> $<unit> Git LFS 带宽",
		"settings/included-git-lfs-storage": "包含 $<count> $<unit> Git LFS 存储",
		"settings/included-packages-transfer": "包含 $<count> $<unit> Packages 数据传输",
		"settings/included-packages-storage": "包含 $<count> $<unit> Packages 存储",
		"settings/included-codespaces-storage": "包含 $<count> $<unit> 代码空间存储",
		"settings/included-codespaces-core-hours": "包含 $<count> 个代码空间核心小时",
		// 折扣列：金额原样保留（不带 $，保留原有呈现），只译 off；带「~」的形态另有一条。
		// 模板刻意写成「约 $<amount> 抵扣」而不是「约抵扣 $<amount>」——后者需要字面量 $
		// 紧跟捕获组（`$$<amount>`），而 `$$` 会被引擎折叠、导致组引用原样输出（实测）
		"settings/discount-approx": "约 $<amount> 抵扣",
		"settings/discount-exact": "$<amount> 抵扣",
		// —— 用量页（模块 pages/settings-billing）——
		// 图表卡片副标题的短月份账期：「Sep 1 - Sep 30, 2026」→「2026 年 9 月 1 日 – 30 日」。
		// 同月只写一次月份（与长月份那组的写法一致）；跨月形态暂未收（见 core/rules.jsonc 的说明）
		"settings/usage-range-short-same-month-jan": "$<year> 年 1 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-feb": "$<year> 年 2 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-mar": "$<year> 年 3 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-apr": "$<year> 年 4 月 $<startDay> 日 – $<endDay> 日",
		// 5 月没有 short 那条：缩写与全称同形，用 settings/usage-range-same-month-may 那条
		"settings/usage-range-short-same-month-jun": "$<year> 年 6 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-jul": "$<year> 年 7 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-aug": "$<year> 年 8 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-sep": "$<year> 年 9 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-oct": "$<year> 年 10 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-nov": "$<year> 年 11 月 $<startDay> 日 – $<endDay> 日",
		"settings/usage-range-short-same-month-dec": "$<year> 年 12 月 $<startDay> 日 – $<endDay> 日",
		// 用量明细说明句的前缀（整节点里带着区间，句点在节点内，故模板收尾要写「。」）
		"settings/usage-hint-same-month-jan": "用量统计：$<year> 年 1 月 $<startDay> 日 – $<endDay> 日。",
		"settings/usage-hint-same-month-feb": "用量统计：$<year> 年 2 月 $<startDay> 日 – $<endDay> 日。",
