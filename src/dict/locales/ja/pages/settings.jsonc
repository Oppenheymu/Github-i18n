// 日本語・モジュール pages/settings：/settings/** と /account/billing/** のアカウント設定。
// プロフィール、タイムゾーン、外観、アクセシビリティ、通知、メール、セッション、SSH / GPG、
// 認証情報・開発者設定、ブロックしたユーザー、インタラクション制限、コードスペース、Copilot、
// セキュリティ分析、アプリの認可、監査ログまでを覆う。請求・ライセンスは pages/settings-billing。
// 鍵は core/canonical.jsonc の pages/settings と同一（ノード境界と根拠は zh-CN 側を参照）。
// タイムゾーン名は pages/profile の既訳と同一（同じ選択肢が両ページに現れるため）。
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Public profile": "公開プロフィール",
		"Account": "アカウント",
		"Appearance": "外観",
		"Accessibility": "アクセシビリティ",
		"Emails": "メール",
		"Password and authentication": "パスワードと認証",
		"Two-factor authentication": "2 要素認証",
		"SSH and GPG keys": "SSH と GPG キー",
		"Saved replies": "保存済みの返信",
		"Billing and plans": "請求とプラン",
		"Developer settings": "開発者設定",
		"Danger Zone": "危険な領域",
		"Update profile": "プロフィールを更新",
		// —— 公開プロフィールのフォーム（/settings/profile）——
		"Name": "名前",
		"Your name may appear around GitHub where you contribute or are mentioned. You can remove it at any time.": "GitHub 上でコントリビュートした場所やメンションされた場所に、あなたの名前が表示されることがあります。いつでも削除できます。",
		"Public email": "公開メールアドレス",
		"You can manage verified email addresses in your email settings": "確認済みのメールアドレスはメール設定で管理できます。",
		// 「email settings」はリンク → 分割時はリンク前の断片だけが残る。訳文は「：」で終え、リンクテキストにつなげる
		"You can manage verified email addresses in your": "確認済みのメールアドレスはこちらの設定で管理できます：",
		"Bio": "自己紹介",
		// 自己紹介入力欄の placeholder / aria-label
		"Add a bio": "自己紹介を追加",
		"Pronouns": "代名詞",
		"Don't specify": "指定しない",
		// 代名詞ドロップダウンの「カスタム」項目
		"Custom": "カスタム",
		"URL": "ウェブサイト",
		// 上流でプロフィールの URL フィールドが Website に改名された。訳文は旧キー URL と同一（組織プロフィールページは旧キーのまま）
		"Website": "ウェブサイト",
		"Social accounts": "ソーシャルアカウント",
		// ソーシャルアカウント行のフォールバックアイコン（svg の <title> / aria-label）。pages/org-settings と同じ訳
		"Social account": "ソーシャルアカウント",
		// 属性項目（aria-label）：ソーシャルアカウント入力欄に番号ごとに 1 つずつある
		"Link to social profile 1": "ソーシャルプロフィールへのリンク 1",
		"Link to social profile 2": "ソーシャルプロフィールへのリンク 2",
		"Link to social profile 3": "ソーシャルプロフィールへのリンク 3",
		"Link to social profile 4": "ソーシャルプロフィールへのリンク 4",
		// `<strong>@mention</strong>` による分割：You can / @mention / 残り；
		// 3 番目の断片はソースの改行インデントを含むため、まとめて 1 項目にする（@mention 自体は英語のまま）。
		// 訳文の末尾に**空白を入れない**：walker は元ノードの先頭空白を保持するため、空白を付けると二重になる
		"You can": "あなたは",
		"other users and organizations to link to them.": "で他のユーザーや組織をリンクできます。",
		"You can @mention other users and organizations to link to them.": "あなたは @メンションで他のユーザーや組織をリンクできます。",
		"Company": "会社",
		// 会社のヒント文も `<strong>@mention</strong>` で分割される（You can / @mention / 末尾）。
		// 末尾の訳文は「あなたは @mention 」の直後からそのまま読めるようにする——walker は元ノードの先頭空白を保持するので、
		// 実機では「あなたは @mention で会社の GitHub 組織をリンクできます。」と連結される。
		"You can @mention your company’s GitHub organization to link it.": "あなたは @メンションで会社の GitHub 組織をリンクできます。",
		"your company’s GitHub organization to link it.": "で会社の GitHub 組織をリンクできます。",
		"Location": "場所",
		"Display current local time": "現在の現地時刻を表示",
		"Other users will see the time difference from their local time.": "他のユーザーには、自分の現地時刻との時差が表示されます。",
		"Time zone": "タイムゾーン",
		// —— タイムゾーンドロップダウンの全オプション ——
		// キーは実機 HTML の `<option>` テキストから逐字転記。GMT オフセットの接頭辞はそのまま残し、
