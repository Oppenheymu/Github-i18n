// 日本語・モジュール pages/insights：/owner/repo 配下のインサイトとツール系サブページ専用エントリ。
// 対象は pulse / graphs / forks / security / projects の各サブツリー。
// 注：ユーザー名 / リポジトリ名 / GHSA 番号 / アドバイザリのタイトルは内容なので収録しない。
// 絶対日付（Sep 23, 2026 など）は全サイト共通の動的書式で、全サイト規則が扱う。
// チャート軸の目盛り（Aug 2026 / Aug 10）と同月の期間表記はインサイトのチャート専用書式。
// ページタイトルのリポジトリ名と読み上げ属性のユーザー名も原文のまま残す。
// 鍵は core/canonical.jsonc にある英語原文との完全一致（綴り違いは門禁が弾く）。
// 値には日本語の文字体系（漢字 / ひらがな / カタカナ）が必要。
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— Pulse 動的ページ ——
		// 小文字の `merged` は global の状態バッジ群へ移した（ページをまたぐ共用ラベル）ため、
		// 本モジュールでは重複登録しない。
		"Period:": "期間：",
		"Open pull requests": "オープンなプルリクエスト",
		"commits": "コミット",
		// —— インサイトのサイドバー ——
		"Code frequency": "コード頻度",
		"Community standards": "コミュニティ基準",
		// —— Forks フォーク一覧 ——
		"Created": "作成日",
		"Recently updated": "最近更新された",
		"Most starred": "スターが多い順",
		"Open issues": "オープンなイシュー",
		"Starred": "スター付き",
		"Sort:": "並べ替え：",
		"Filter by period": "期間で絞り込む",
		"Filter by repository type": "リポジトリの種類で絞り込む",
		"Repository type:": "リポジトリの種類：",
		"Archived repositories": "アーカイブ済みリポジトリ",
		"Forks of other forks": "他のフォークのフォーク",
		"Inactive": "非アクティブ",
		"Repositories with push activity": "プッシュのアクティビティがあるリポジトリ",
		"Repositories with no push activity": "プッシュのアクティビティがないリポジトリ",
		"Repositories with at least 1 star": "1 つ以上のスターがあるリポジトリ",
		"Switch to tree view": "ツリー表示に切り替え",
		// 鍵は normalizeKey 後の単一空格の形で書く（実機の改行とインデントは
		// エンジンが畳み込むため、鍵に改行を入れると永久に命中しない）
		"Any repository that has not been created or updated during this period will be excluded.": "この期間中に作成も更新もされていないリポジトリは除外されます。",
		// —— graphs のチャート（contributors など）——
		"Contributions": "コントリビューション",
		"Period": "期間",
		"Last 3 months": "過去 3 か月",
		"Crunching the latest data, just for you. Hang tight…": "最新のデータを準備しています。しばらくお待ちください…",
		"End of interactive chart.": "インタラクティブチャートの終わりです。",
		"View as data table, Chart": "データテーブルとして表示、チャート",
		"Interactive chart": "インタラクティブチャート",
		"Interactive chart.": "インタラクティブチャート。",
		// 直後にブランチ名のノードが続く断片
		"Contributions per week to": "週あたりのコントリビューション：",
		", line counts have been omitted because commit count exceeds 10,000.": "、コミット数が 10,000 を超えるため行数の表示は省略されています。",
		"Chart": "チャート",
		"Chart options": "チャートのオプション",
		"Customization settings": "カスタマイズ設定",
		"commit": "コミット",
		// 実機ではユーザー名ノードの直後にある所有格の断片
		"'s Commits": "のコミット",
		// 直後に日付のノードが続く断片
		"Weekly from": "週次、開始日：",
		"over time": "の推移",
		// —— チャートの読み上げ属性（属性は文字列全体の完全一致のみで、規則は効かない）——
		"Axis zoom": "軸のズーム",
		"Start, percent": "開始、パーセント",
		"End, percent": "終了、パーセント",
		"Commits over time Axis zoom": "コミットの推移 軸のズーム",
		// —— Security セキュリティアドバイザリ ——
		"published": "公開",
		"Published advisory": "公開済みのアドバイザリ",
		"GitHub Advisory Database": "GitHub アドバイザリデータベース",
		"High": "高",
		"Moderate": "中",
		"Critical": "重大",
		"Severity: high": "重要度：高",
		"Severity: moderate": "重要度：中",
		"Severity: critical": "重要度：重大",
		// 実機では 3 ノードに分かれる（"… related to" + パッケージ名 + "in the" + DB 名 + "."）。
		// 前段を「に関連する…詳細は、」、後段を「に掲載されています」にして語順を保つ
		"Learn more about advisories related to": "に関連するアドバイザリの詳細は、",
		"in the": "に掲載されています",
		// —— Security 概要ページ（/owner/repo/security）——
		// 上部バナーは pages/repo-settings の Code scanning バナーと同文・同訳（あちらはこの
		// ルートに命中しないため、本モジュールにも 1 件ずつ収録し訳文を揃える）。
		// 見出しノードの内部に中黒 `•` が含まれるため、訳文でもそのまま残す
		// （描画は「セキュリティポリシー • 有効」）。`View alerts` のような短いリンク文は
		// 独立したノードなので、説明文とは別のエントリにする。
		"Code scanning: one or more analysis tools are reporting problems": "コードスキャン：1 つ以上の分析ツールが問題を報告しています",
		"Scorecard is reporting warnings. Check the": "Scorecard が警告を報告しています。",
		"status page": "ステータスページ",
		"for help.": "をご確認ください。",
		"Security policy •": "セキュリティポリシー •",
		"Enabled": "有効",
		"View how to securely report security vulnerabilities for this repository": "このリポジトリのセキュリティ脆弱性を安全に報告する方法を表示",
		"View security policy": "セキュリティポリシーを表示",
		"Security advisories •": "セキュリティアドバイザリ •",
		"View or disclose security advisories for this repository": "このリポジトリのセキュリティアドバイザリを表示または公開",
		"View security advisories": "セキュリティアドバイザリを表示",
		"Private vulnerability reporting •": "プライベートな脆弱性レポート •",
		"Allow users to privately report potential security vulnerabilities": "ユーザーが潜在的なセキュリティ脆弱性を非公開で報告できるようにする",
		"See reported vulnerabilities": "報告された脆弱性を表示",
		"Dependabot alerts •": "Dependabot アラート •",
		"Get notified when one of your dependencies has a vulnerability": "依存関係のいずれかに脆弱性があると通知を受け取る",
		"View Dependabot alerts": "Dependabot アラートを表示",
		"Code scanning alerts •": "コードスキャンアラート •",
		"Automatically detect common vulnerability and coding errors": "一般的な脆弱性とコーディングエラーを自動的に検出",
		"View alerts": "アラートを表示",
		"Secret scanning alerts •": "シークレットスキャンアラート •",
		"Get notified when a secret is pushed to this repository": "シークレットがこのリポジトリにプッシュされると通知を受け取る",
		"View detected secrets": "検出されたシークレットを表示",
		"Code quality findings •": "コード品質の検出結果 •",
		"Disabled": "無効",
		"Automatically detect code quality issues in your codebase": "コードベースのコード品質の問題を自動的に検出",
		"Enable code quality": "コード品質を有効にする",
		// —— Projects プロジェクト ——
		"Templates": "テンプレート",
		"Repository projects": "リポジトリのプロジェクト",
		"Filter projects by state": "状態でプロジェクトを絞り込む",
		"Loading projects": "プロジェクトを読み込み中",
		"Search projects": "プロジェクトを検索",
		"Search by name…": "名前で検索…",
		"updated": "更新日",
		// —— パルス / グラフ / トラフィックの残り ——
		"Excluding merges,": "マージコミットを除くと、",
		"authors": "人の作者が",
		"have pushed": "プッシュしたのは",
		"to all branches.": "もすべてのブランチにプッシュしました。",
		"files": "ファイルが",
		"have changed and there have been": "変更され、",
		"additions": "行が追加され",
		"and": "、さらに",
		"deletions": "行が削除されました。",
		"to": "、プッシュ先は",
		"On": "ブランチ",
		"pull requests": "件のプルリクエスト",
		"pull request": "件のプルリクエスト",
		"merged by": "をマージしたのは",
		"people": "人",
		"person": "人",
		"pull requests merged by": "件のプルリクエストをマージしたのは",
		"pull request merged by": "件のプルリクエストをマージしたのは",
		"Active issues": "アクティブなイシュー",
		"Closed issues": "クローズされたイシュー",
		"New issues": "新しいイシュー",
		"Active pull requests": "アクティブなプルリクエスト",
		"Merged pull requests": "マージされたプルリクエスト",
		"View merged pull requests": "マージされたプルリクエストを表示",
		"Traffic": "トラフィック",
		"People": "メンバー",
		"Dependency graph": "依存関係グラフ",
		"Network": "ネットワーク",
		"Admin insights": "管理者向けインサイト",
		"Actions performance metrics": "Actions パフォーマンス指標",
		"Actions usage metrics": "Actions 使用量指標",
		"Contributions:": "コントリビューション：",
		"Top committers": "コミット数の多いコントリビューター",
		"Commits over time. Interactive chart.": "コミットの推移。インタラクティブチャート。",
		"Top committers. Interactive chart.": "コミット数の多いコントリビューター。インタラクティブチャート。",
		"Start of selected range": "選択範囲の開始",
		"End of selected range": "選択範囲の終了",
		"The chart has 1 X axis displaying categories.": "チャートには 1 本の X 軸があり、カテゴリを表示します。",
		// —— Pulse サマリー文の新ノード分割（2026-10-29 実証）——
		// 上流は「 have pushed 」を have + pushed に分割した。日本語は authors /
		// files の既存テンプレート（「人の作者が」「ファイルが」）が助詞を担うため、
		// have は insights/have-word ルールで空文字（ノードごと消える）、pushed が
		// 旧キーの「プッシュしたのは」を引き継ぐ。
		"pushed": "プッシュしたのは",
		"changed and there have been": "変更され、",
		// コントリビューター概要カードの右上リンクの aria-label
		"View open pull requests": "オープンなプルリクエストを表示",
		// —— /forks の空状態と説明文 ——
		// 説明文は 4 ノード（前段 + リンク + 中段 + 末尾ノード）。末尾の
		//「pull request」は既存キー「件のプルリクエスト」が命中するため、
		// 中段の日本語テンプレートは助数詞に必要な「1」を末尾に担う
		"No one has forked this repository yet": "まだこのリポジトリをフォークした人はいません",
		"Forks are a great way to contribute to a repository. After": "フォークはリポジトリへの貢献に最適な方法です。",
		"forking a repository": "リポジトリをフォーク",
		", you can send the original author a": "した後、オリジナルの作者に 1",
		// ネットワークグラフ区块（/network の同串は pages/repo に同訳あり）
		"Network graph": "ネットワークグラフ",
		"Network graph of recent commits. Use the Chart options menu to view as a table.": "最近のコミットのネットワークグラフ。チャートのオプションメニューからテーブルとして表示できます。",
		"The network graph is also available as a data table.": "ネットワークグラフはデータテーブルでも表示できます。",
		"Timeline of the most recent commits to this repository and its network ordered by most recently pushed to and updated daily.": "このリポジトリとそのネットワークへの最近のコミットのタイムライン。最新のプッシュ順に並び、毎日更新されます。",
		// —— グラフページ（code-frequency / commit-activity / contributors / traffic）——
		// カード説明文：前段 + strong リポジトリ名ノード（原文のまま）、コロンで受ける
		"Number of commits per week": "週ごとのコミット数",
		"Additions and deletions per week": "週ごとの追加行と削除行",
		"Code frequency over the history of": "これまでの履歴におけるコード頻度：",
		"Commits over the last year of": "過去 1 年間のコミット：",
		"Code frequency. Interactive chart.": "コード頻度。インタラクティブチャート。",
		"Commits. Interactive chart.": "コミット。インタラクティブチャート。",
		"Frequency": "頻度",
		"Additions": "追加",
		"Deletions": "削除",
		"Show Additions": "追加を表示",
		"Show Deletions": "削除を表示",
		"Toggle series visibility, Chart": "系列の表示を切り替え、チャート",
		// SVG 軸目盛りの月略称
		"Jan": "1月",
		"Feb": "2月",
		"Mar": "3月",
		"Apr": "4月",
		"May": "5月",
		"Jun": "6月",
		"Jul": "7月",
		"Aug": "8月",
		"Sep": "9月",
		"Oct": "10月",
		"Nov": "11月",
		"Dec": "12月",
		// —— traffic ——
		"Git clones": "Git クローン",
		"Popular content": "人気のコンテンツ",
		"Referring sites": "参照サイト",
		"Visitors": "訪問者",
		"Clones in last 14 days": "直近 14 日間のクローン",
		"Unique cloners in last 14 days": "直近 14 日間のクローン元ユーザー",
		"Total views in last 14 days": "直近 14 日間の総閲覧数",
		"Unique visitors in last 14 days": "直近 14 日間のユニーク訪問者",
		"Clones in last 14 days. Interactive chart.": "直近 14 日間のクローン。インタラクティブチャート。",
		"Unique cloners in last 14 days. Interactive chart.": "直近 14 日間のクローン元ユーザー。インタラクティブチャート。",
		"Total views in last 14 days. Interactive chart.": "直近 14 日間の総閲覧数。インタラクティブチャート。",
		"Unique visitors in last 14 days. Interactive chart.": "直近 14 日間のユニーク訪問者。インタラクティブチャート。",
		"Cloners": "クローン元",
		"Clones": "クローン",
		"Total views": "総閲覧数",
		"Unique visitors": "ユニーク訪問者",
		"Views": "閲覧数",
		"Unique Visitors": "ユニーク訪問者",
		"Total": "合計",
		"Unique": "ユニーク",
		"Content": "コンテンツ",
		"Site": "サイト",
		// —— contributors ——
		"Last month": "先月"
	}
}
