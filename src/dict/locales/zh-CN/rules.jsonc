		"settings/two-factor-deadline-october": "启用双因素认证作为额外的安全措施。你在 GitHub 上的活动使你被纳入此要求。你需要在 $<year> 年 10 月 $<day> 日前重新为你的账户启用双因素认证，否则你的账户将在该日期受到限制。",
		"settings/two-factor-deadline-november": "启用双因素认证作为额外的安全措施。你在 GitHub 上的活动使你被纳入此要求。你需要在 $<year> 年 11 月 $<day> 日前重新为你的账户启用双因素认证，否则你的账户将在该日期受到限制。",
		"settings/two-factor-deadline-december": "启用双因素认证作为额外的安全措施。你在 GitHub 上的活动使你被纳入此要求。你需要在 $<year> 年 12 月 $<day> 日前重新为你的账户启用双因素认证，否则你的账户将在该日期受到限制。",
		"settings/export-available": "导出数据将在 $1 天内可用。",
		"settings/owner-organizations": "你的账户目前是以下组织的所有者：$1",
		// 会话卡「曾出现地区」：国家码是动态值，按原样带回
		"settings/session-seen-in": "曾出现于 $1",
		// —— 凭据 / 开发者设置一族（/settings/credentials、tokens 等五页）——
		// 卡片计数行：数字按原样带回，量词由模板给
		"settings/credentials-keys-count": "$1 个密钥",
		"settings/credentials-tokens-count": "$1 个令牌",
		"settings/credentials-oauth-apps-count": "$1 个 OAuth 应用",
		"settings/credentials-github-apps-count": "$1 个 GitHub 应用",
		// 令牌过期日期（"on Fri, Nov 27 2026"）：周几按约定不体现，月份写死在模板里
		"settings/expires-on-jan": "$<year> 年 1 月 $<day> 日",
		"settings/expires-on-feb": "$<year> 年 2 月 $<day> 日",
		"settings/expires-on-mar": "$<year> 年 3 月 $<day> 日",
		"settings/expires-on-apr": "$<year> 年 4 月 $<day> 日",
