// 规范键清单（仅门禁使用，不进 content 包）：当前 GitHub 真实渲染的英文原文全集，
// 按模块分组、顺序与 core/modules.jsonc 一致，分组注释与词条顺序沿用迁移前的词典。
//
// 三处用途：
// 1. 覆盖率分母——各语言缺哪些键，bun run check:dict 直接算得出来；
// 2. 拼错即报——某语言词条的键不在本清单里即报错（旧结构下拼错键只会静默不翻）；
// 3. 防循环门禁的「键集合」——任何语言的译文不得等于其中任何一个键。
{
	"$schema": "../types/dict.schema.json",
	"modules": [
		{
			"name": "pages/issues",
			"keys": [
				// —— 列表行元信息（状态徽标与打开时间）——
				"opened",
				"Status: Open.",
				"Status: Closed (completed).",
				"More information available below.",
				"new release",
				// —— 侧栏导航与保存视图 ——
				"Assigned to me",
				"Created by me",
				"Mentioned",
				"Recent activity",
				"Views",
				"Types",
				"Open Issues sidebar navigation",
				"Issues sidebar navigation",
				"Collapse sidebar",
				// —— 搜索与筛选 ——
				"Search Issues",
				"Suggestions",
				"Issue filters",
				"Filter all issues",
				"Filter by author",
				"Filter by milestones",
				"Filter by projects",
				"Filter by assignees",
				"Filter by issue type",
				"Filter by labels",
				", descending",
				// —— 列表排序菜单与新建入口（既有词条，恢复保留）——
				"Newest",
				"Oldest",
				"Most commented",
				"Least commented",
				"Recently updated",
				"Least recently updated",
				"New label",
				"New milestone",
				// —— 详情页操作按钮（既有词条，恢复保留）——
				"Close issue",
				"Reopen issue",
				"Submit new issue",
				"Assign yourself",
				// —— 置顶议题与创建限制 ——
				"Issue creation is restricted in this repository",
				"Drag and drop pinned issues list.",
				// —— 标签描述（筛选列表 / 悬停提示展示）——
				"Request for new features or functionality",
				"Issue identified by VS Code Team member as probable bug",
				"Issues found in a recent release of VS Code",
				"VS Code keybinding issues",
				"Editor column selection issues",
				"Code quality issues",
				"Editor basic functionality",
				"General VS Code workbench layout issues",
				"General terminal issues that don't fall under another label",
				"Issue identified as 'upstream' component related (exists outside of VS Code)",
				"Issue is under discussion for relevance, priority, approach",
				"Issues and items related to Electron",
				"Issues concerning extensions",
				"Issues with VS Code on Linux",
				"Native OS integration issues",
				"This is an upstream issue that has been reported upstream",
				"VS Code installation and upgrade system issues",
				"VS Code on Windows issues",
				"Explorer widget issues",
				"File glob engine",
				"Issue requires more information from poster",
				"VS Code configuration, settings",
				"Editor Right-To-Left or Bi-Di issues",
				"Editor rendering issues",
				"File I/O",
				"Function, method and class parameter hint widget",
				"Issues regarding network proxies",
				"Multi-root (multiple folders) issues",
				"Remote system operations issues",
				"Typescript support issues",
				"VS Code editor tab issues",
				// —— 拖放辅助说明（键按引擎空白归一写为单空格形式）——
				"To pick up a draggable item, press the space bar. While dragging, use the arrow keys to move the item. Press space again to drop the item in its new position, or press escape to cancel."
			]
		},
		{
			"name": "pages/pulls",
			"keys": [
				"Conversation",
				"Checks",
				"Files changed",
				"Merge",
				"Squash and merge",
				"Rebase and merge",
				"Merge pull request",
				"Close pull request",
				"Reopen pull request",
				"Request changes",
				"Approve",
				"Approved",
				"Submit review",
				"Resolve conversation",
				"This branch has no conflicts with the base branch",
				// —— 列表页状态图标（aria-label）——
				"Open pull request",
				"Draft pull request",
				// —— 详情页头与合并横幅 ——
				"Pull request",
				"Commit message body",
				"from",
				"Copy head branch name to clipboard",
				// —— 时间线事件与侧栏 ——
				"mentioned this pull request",
				"added a commit that referenced this pull request",
				"deleted the",
				"This comment was marked as outdated.",
				"No reviews",
				"This user is the author of this pull request.",
				// —— 版式与窗格 ——
				"Draggable pane splitter",
				// —— 列表页筛选栏与排序（React 重写版工具栏）——
				"Search pull requests",
				"Pull request filters",
				"Pull requests display density",
				"Comfortable display density",
				"Compact display density",
				"Clear filter",
				"More items",
				"Newest",
				"descending",
				"Assignee",
				"Label",
				"Reviews",
				"Filter by assignee",
				"Filter by label",
				"Filter by reviews",
				"Filter by review: Review required",
				"Filter by review: Approved",
				"Sort by Newest descending",
				"Review required",
				"Review required before merging",
				// —— 详情页导航与关联议题 ——
				"Pull request navigation",
				"Link issues",
				"Successfully merging this pull request may close these issues.",
				// —— 建议应用提示（suggestion 横幅）——
				"Add this suggestion to a batch that can be applied as a single commit.",
				"Applying suggestions on deleted lines is not supported.",
				"Only one suggestion per line can be applied in a batch.",
				"Outdated suggestions cannot be applied.",
				"Suggestion cannot be applied right now. Please check back later.",
				"Suggestions cannot be applied from pending reviews.",
				"Suggestions cannot be applied on multi-line comments.",
				"Suggestions cannot be applied while the pull request is closed.",
				"Suggestions cannot be applied while the pull request is queued to merge.",
				"Suggestions cannot be applied while viewing a subset of changes.",
				"This suggestion has been applied or marked resolved.",
				"This suggestion is invalid because no changes were made to the code.",
				"You must change the existing code in this line in order to create a valid suggestion."
			]
		},
		{
			"name": "pages/settings-security",
			"keys": [
				// —— 账号安全页（/settings/security）——
				// 键逐字抄自开发者模式导出的漏翻清单（2026-09-26 该页会话，schema
				// github-zh-misses/1，path 全为 /settings/security，共 102 条）。
				// 该清单同时给出**节点原文**，因此下面每条的形态就是实机形态：
				// 长说明句多数是**单个带源码缩进的文本节点**（归一空白后等于本表的键），
				// 少数被 `<a>` / `<strong>` 切开（如「部分 GitHub 用户现在必须启用…」三段）。
				// 节点边界与拼接断言见 src/dict/__tests__/pages/settings/security.test.ts。
				//
				// 刻意**不收录**（同测试里的反例断言）：用户内容（`CanoKey Main` / `CanoKey
				// Backup` 这类用户自命名的通行密钥、`M. Oppenheymu` / `(Oppenheymu)` /
				// `@Oppenheymu`）与纯专名（`GitHub` / `Copilot` / `Apple` / `Google` /
				// `GitHub Mobile`——截图页与通知页的测试已反向断言它们保持英文）。
				// 含这些专名但整句可译的文案照收（如 `Show GitHub Mobile`）。
				//
				// 本页**动态文本**（通行密钥的「添加于 <日期> [|] 上次使用 <相对时间>」、
				// 每行末尾的计数、删除确认弹窗里的密钥名、2FA 强制要求的截止日）不进本表，
				// 一律走 core/rules.jsonc 的 pages/settings-security 规则（月份与相对时间
				// 无法用捕获组映射成中文，只能逐组合全展开）。
				// —— 密码 ——
				"Change password",
				"Old password",
				"New password",
				"Confirm new password",
				"Update password",
				"I forgot my password",
				// 密码强度提示被 `<strong>` 切成六段；实机原文（含节点间空白）拼起来是
				// `Make sure it's at least 15 characters OR at least 8 characters
				// including a number and a lowercase letter.`，故译文必须能逐段拼通
				"Make sure it's",
				"at least 15 characters",
				"OR",
				"at least 8 characters",
				"including a number",
				"and a lowercase letter",
				"Learn more about strong passwords",
				// 密码强度指示条的档位文案（实机采集到的是最低档；更高档位本次未出现，未命中即保留英文）
				"Less secure",
				// 密码输入框右侧的显示 / 隐藏切换（实机是两个节点的按钮文案）
				"Hide",
				"Show",
				// —— 通行密钥 ——
				"Passkeys",
				"Add passkey",
				"Passkey nickname",
				"Nickname:",
				"Edit passkey nickname",
				// 昵称编辑框两侧按钮的无障碍文案（aria-label，属性只走精确命中）
				"Cancel changes to passkey nickname",
				"Save changes to passkey nickname",
				"An error occurred while renaming your passkey.",
				"Seen from this browser",
				"Delete passkey?",
				"Note: You may continue to see this passkey as an option during sign-in until you also delete it from your browser, device or associated account's password management settings.",
				"You will no longer be able to use it to sign-in to your account.",
				"Passkeys should be used primarily for standalone, password-less authentication.",
				// 2FA 方法行的状态徽标与行末按钮
				"Configured",
				"Manage",
				// —— 双因素认证 ——
				"Two-factor authentication adds an additional layer of security to your account by requiring more than just a password to sign in.",
				"Are you sure you want to disable two-factor authentication?",
				"GitHub highly recommends that you keep two-factor authentication enabled on your account. If you need to change your configuration, or generate new recovery codes, you can do that in the settings below.",
				"Disable",
				"Two-factor methods",
				"Authenticator app",
				"Edit Authenticator app",
				"Use an authentication app or browser extension to get two-factor authentication codes when prompted.",
				"Viewed",
				"SMS/Text message",
				"Add SMS/Text message",
				"Get one-time codes sent to your phone via SMS to complete authentication requests. We strongly advise against using SMS because it is susceptible to interception, does not provide resistance against phishing attacks, and deliverability can be unreliable. It is recommended to use an Authenticator app instead of SMS.",
				"Security keys",
				"Edit Security keys",
				"Register new security key",
				"Security keys are webauthn credentials that can only be used as a second factor of authentication.",
				"Security key registration failed.",
				"This security key has already been registered.",
				"This browser doesn't support security keys yet.",
				"Try again",
				"Waiting for input from browser interaction...",
				// 安全密钥昵称输入框的 aria-label 与 placeholder（同一个值，词条只需一条）
				"Enter a nickname for this security key",
				"Show GitHub Mobile",
				"GitHub Mobile can be used for two-factor authentication by installing the GitHub Mobile app and signing in to your account.",
				"Add account",
				"Connect",
				"View",
				"Recovery codes",
				"View Recovery codes",
				"Recovery codes can be used to access your account in the event you lose access to your device and cannot receive two-factor authentication codes.",
				"Recovery options",
				// —— 首选 2FA 方式 ——
				"Preferred 2FA method",
				"Set your preferred method to use for two-factor authentication when signing into GitHub.",
				"Learn more about two-factor authentication",
				"Learn more about our two-factor authentication initiative",
				// —— 登录方式（社交账号登录）——
				"Sign in methods",
				"Sign in with your Apple account",
				"Google sign in method dropdown",
				// —— 强制启用 2FA 的提示横幅 ——
				// 实机节点边界：整段被 `<a>now required</a>` 切成三段——
				//   `Some GitHub users are` | <a> | ` to enable two-factor authentication as an
				//   additional security measure. … before April 30, 2026, … on that date.`
				// 第三段是**单个跨行节点且含动态截止日**，故只有它走规则
				// （settings/two-factor-deadline-*），前两段是静态词条
				"Because of your contributions on GitHub, two-factor authentication is required for your account. Thank you for helping keep the ecosystem safe!",
				"Some GitHub users are",
				"now required",
				// 页面级标题（左侧栏上方的当前页名）
				"Account security"
			]
		},
		{
			"name": "pages/settings",
			"keys": [
				"Public profile",
				"Account",
				"Appearance",
				"Accessibility",
				"Emails",
				"Password and authentication",
				"Two-factor authentication",
				"SSH and GPG keys",
				"Saved replies",
				"Billing and plans",
				"Developer settings",
				"Danger Zone",
				"Update profile",
				// —— 公开资料表单 ——
				"Name",
				"Your name may appear around GitHub where you contribute or are mentioned. You can remove it at any time.",
				"Public email",
				"You can manage verified email addresses in your email settings",
				// 「email settings」是链接 → 整句被拆开时只剩链接前片段，单独收录
				"You can manage verified email addresses in your",
				"Bio",
				"Pronouns",
				"Don't specify",
				// 社交账号列表：输入框的 aria-label 按序号各成一条（属性只走精确命中）
				"URL",
				"Social accounts",
				"Link to social profile 1",
				"Link to social profile 2",
				"Link to social profile 3",
				"Link to social profile 4",
				"You can @mention other users and organizations to link to them.",
				// `<strong>@mention</strong>` 把整句切成三段（You can / @mention / 其余）。
				// 第三段的真实原文是 "other users and\n<缩进>organizations to link to them."
				// ——片段之间隔着源码换行缩进，因此必须整段收录，拆更细的碎片永远对不上
				"You can",
				"other users and organizations to link to them.",
				"Company",
				"You can @mention your company’s GitHub organization to link it.",
				// 公司提示句的第三段（@mention 之后）。键不得含首尾空白——引擎匹配前会
				// normalizeKey（trim + 折叠空白），原节点的前导空格由 walker 保留拼接；
				// 源码换行缩进落在这段文本内部也会被折叠，故键只写折叠后的形态
				"your company’s GitHub organization to link it.",
				"Location",
				"Display current local time",
				"Other users will see the time difference from their local time.",
				"Time zone",
				"ORCID iD",
				"ORCID provides a persistent identifier - an ORCID iD - that distinguishes you from other researchers. Learn more at ORCID.org.",
				// 说明句里的链接会让 GitHub 把整句拆成多个文本节点，链接前的片段单独收录
				"ORCID provides a persistent identifier - an ORCID iD - that distinguishes you from other researchers. Learn more at",
				"All of the fields on this page are optional and can be deleted at any time, and by filling them out, you're giving us consent to share this data wherever your user profile appears. Please see our privacy statement to learn more about how we use this information.",
				"All of the fields on this page are optional and can be deleted at any time, and by filling them out, you're giving us consent to share this data wherever your user profile appears. Please see our",
				"privacy statement",
				// —— 头像与「贡献与动态」——
				"Profile picture",
				"Contributions & activity",
				"Make profile private and hide activity",
				"Enabling this will hide your contributions and activity from your GitHub profile and from social features like followers, stars, feeds, leaderboards and releases.",
				"Include private contributions on my profile",
				"Your contribution graph, achievements, and activity overview will show your private contributions without revealing any repository or organization information. Read more.",
				// 「Read more」若渲染成链接，整句同样按链接前的片段收录
				"Your contribution graph, achievements, and activity overview will show your private contributions without revealing any repository or organization information.",
				"Read more.",
				// —— 资料设置（成就展示）——
				"Profile settings",
				"Show Achievements on my profile",
				"Your achievements will be shown on your profile.",
				"Update preferences",
				// —— GitHub Developer Program ——
				"GitHub Developer Program",
				"Building an application, service, or tool that integrates with GitHub? Join the GitHub Developer Program, or read more about it at our GitHub developer program.",
				// 说明句被「GitHub Docs」链接拆成两个节点，链接前后各自成词条
				"GitHub Docs",
				"has guides, API and webhook references, information about creating GitHub Apps and other resources for building applications that integrate with GitHub. Make sure your contact information is up-to-date below. Thanks for being a member!",
				"Support email address",
				"An email address where GitHub users can contact you for support.",
				"Product or company website",
				"The URL for the product, company, or service that integrates with GitHub.",
				"Update contact information",
				"Leave the program",
				// 邮箱行尾的「移除」按钮（表单内通用动作）
				"Remove",
				// —— 求职资料与趋势偏好 ——
				"Jobs profile",
				"Available for hire",
				"Save jobs profile",
				"Trending settings",
				"Preferred spoken language",
				"Chinese",
				"We'll use this language preference to filter the trending repository lists on",
				"our Trending Repositories page",
				"Save Trending settings",
				// —— 本页右侧导航与账户区块（键同时存在于 pages/repo-settings，
				// 但那边路由只命中 /<owner>/<repo>/settings，本页永远不会生效，故此处各来一份）——
				"Your personal account",
				"Billing and licensing",
				"Payment information",
				"Payment history",
				"Budgets and alerts",
				"Additional billing details",
				"Sponsorship log",
				"Scheduled reminders",
				"Education benefits",
				"Blocked users",
				"Security log",
				"Applications",
				"Integrations",
				"Code, planning, and automation",
				"Interaction limits",
				"Code review limits",
				// 个人设置侧栏的「归档」（仓库设置里另有同键，两处都渲染）
				"Archives",
				// —— 页面级属性与菜单 ——
				"Settings menu",
				"Select settings context",
				// —— 头像上传与图片校验（文案与 pages/repo-settings 保持一致）——
				"Remove photo",
				"Please upload a picture smaller than 1 MB.",
				"We only support PNG, GIF, or JPG pictures.",
				"File contents don’t match the file extension.",
				"Please upload a picture smaller than 10,000x10,000.",
				"Something went really wrong and we can’t process that picture.",
				"This file is empty.",
				// —— 公开资料表单补充 ——
				"Select a verified email to display",
				"No Preference",
				"Connect your ORCID iD",
				// —— /settings/profile 的 ORCID 区块（**连接之后**才渲染的那部分）——
				// 证据强度：**实机截图 + 实机 HTML 实证**（2026-09-27 维护者提供）。
				// 该区块的上半部分（H2 `ORCID iD`、`Connect your ORCID iD` 与那句说明）
				// 早已有词条，这里只补连接成功后新增的内容。
				// **已连接提示的真实边界**（HTML 确证：两个值都被 `<strong>` 包住）：
				//   `You have a connected ORCID iD` + <strong>标识符</strong> +
				//   `for the account` + <strong>@账户</strong> + `.`
				// 即整句被切成四段以上、句号也独立成节点；上一轮按截图推断的
				// 「整句单节点」规则因此永不命中，已随这次修正删除（同 security-log 的先例）。
				// 标识符与 @账户都是动态值 / 用户内容，不收录。
				"You have a connected ORCID iD",
				"for the account",
				"Display your ORCID iD on your GitHub profile",
				"Disconnecting your ORCID iD may affect areas of your profile where your ORCID iD is displayed.",
				"Disconnect your ORCID iD",
				"Trending Repositories",
				// —— 说明句被链接拆开后单独成节点的片段（摘录自实机文本节点清单）——
				"email settings",
				"to learn more about how we use this information.",
				// —— 账号管理（/settings/admin）——
				// 实机节点边界（两种渲染都见过，故都收）：
				// a) `Changing your username can have` 一整个文本节点 + <a>unintended side effects</a> + `.`
				//    —— 链接锚在「unintended side effects」上，Change 不是链接（/settings/admin 现状）
				// b) `<a>Change</a> your username can have <a>unintended side effects</a>.`
				"Change username",
				"Changing your username can have",
				"Change",
				"your username can have",
				"unintended side effects",
				"Changing your username can have unintended side effects.",
				// 句中的「密码与身份验证」是链接 → 整句被拆开，链接前 / 链接后各一条
				// （链接文本 "Password and authentication" 已在上面的设置导航里收录）
				"Looking to manage account security settings? You can find them in the",
				"page.",
				// 「Patreon」是链接 → 说明句被拆开，链接前 / 链接后各成一条
				"Link Patreon account",
				"Connect a Patreon account for",
				"to sponsor maintainers with. Get recognition on GitHub for sponsorships made on Patreon when the sponsored person has linked Patreon and GitHub, too, and has a public GitHub Sponsors profile.",
				"Export account data",
				// 实机节点边界：`导出 [<strong>@用户名</strong>][.][<strong>][Exports will be available for 7 days.]`
				// ——句号属于用户名链接节点，故「可用天数」那句的节点值以 ". " 开头，
				// 走 pages/settings 的 export-available 规则（pattern 允许可选的前导 ". "）
				"Export all repositories and profile metadata for",
				"Exports will be available for 7 days.",
				"Successor settings",
				// 实机节点边界（192 字符节点 + <span> + 尾段节点，最后跟 <a>）：
				//   `By clicking "Add Successor" below, … to my GitHub Successor, ` | <span> |
				//   `, in the event of my death. … does not create a binding will.` | <a> | 空白
				// 即首句与次句被切开且都落在长节点里，故三条各按真实节点值逐字收录。
