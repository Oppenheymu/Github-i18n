// 个人与组织主页模块：单段路径（如 /torvalds、/microsoft）
// 营销页（/pricing 等）同为单段路径，但本模块词条不会在其上出现，无副作用
// Gist 列表页（gist.github.com 的 /、/starred、/用户名）同为单段路径，一并覆盖
// 注：仓库名 / 用户名 / 仓库描述为用户内容不收录；语言名专有名词不译；
// 属性（title/aria/alt）不应用规则（见 content/walker.ts），半动态计数
// 收静态词条仅解当前值（同 actions.jsonc 先例）
// 简体中文 · 模块 pages/profile（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Popular repositories": "热门仓库",
		"Customize your pins": "自定义置顶项",
		"Edit profile": "编辑资料",
		"Block or report": "屏蔽或举报",
		"Contribution activity": "贡献动态",
		// 侧栏热门仓库标题：与 pages/dashboard 同译（该模块只命中根路径，覆盖不到个人主页）
		"Top repositories": "热门仓库",
		// 私有贡献摘要「1 contribution in private repositories」不在此登记静态词条：
		// 整句由 profile/contributions-private 规则接手，计数单独成节点时由
		// global/contributions-count 接手——若把半句收成词条，它会先于规则命中
		// 剩下的整段文本，渲染结果被压成「次贡献，来自私有仓库」。
		// 「Set status」已下沉到 global（头像菜单的状态对话框属全站 UI），此处不再登记。
		"Send message": "发送消息",
		// —— 主页页签 ——
		"Projects": "项目",
		"Packages": "软件包",
		"People": "成员",
		"Sponsoring": "正在赞助",
		// —— 主页区块 ——
		"View all repositories": "查看所有仓库",
		"Most used topics": "最常用的主题",
		"Top languages": "主要语言",
		"Highlights": "亮点",
		"following": "正在关注",
		// —— 关注者与动态概览（计数在独立节点里，故这里只译名词）——
		"followers": "位关注者",
		"Activity overview": "活动概览",
		// 亮点区：「Contributed to <仓库链接>…」的前半句
		"Contributed to": "贡献于",
		"Learn how we count contributions": "了解我们如何统计贡献",
		// —— 贡献动态时间线：整句被仓库 / 组织链接拆开，链接前后各自成词条 ——
		"Created a pull request in": "创建了拉取请求：",
		"Created an issue in": "创建了议题：",
		"Joined the": "加入了",
		"organization": "组织",
		// —— 贡献动态底部的分页按钮与说明文案 ——
		// 说明句被链接拆开：「前半句」+「GitHub profile guide」+ 英文句点
		"Show more activity": "显示更多动态",
		"Seeing something unexpected? Take a look at the": "看到意料之外的内容？请查看",
		"GitHub profile guide": "GitHub 个人资料指南",
		// —— 贡献动态月份标题（月份与年份是两个节点，年份保持数字不译）——
		"January": "1 月",
		"February": "2 月",
		"March": "3 月",
		"April": "4 月",
		"May": "5 月",
		"June": "6 月",
		"July": "7 月",
		"August": "8 月",
		"September": "9 月",
		"October": "10 月",
		"November": "11 月",
		"December": "12 月",
		// 贡献日历的可见标签（月份缩写；May 与全称同形，用上面的词条）
		"Jan": "1 月",
		"Feb": "2 月",
		"Mar": "3 月",
		"Apr": "4 月",
		"Jun": "6 月",
		"Jul": "7 月",
		"Aug": "8 月",
		"Sep": "9 月",
		"Oct": "10 月",
		"Nov": "11 月",
		"Dec": "12 月",
		"Mon": "周一",
		"Wed": "周三",
		"Fri": "周五",
		// —— 贡献日历图例与「贡献设置」面板 ——
		"Less": "较少",
		"Contribution settings": "贡献设置",
		"Private contributions": "私有贡献",
		"Turning off private contributions will show only public activity on your profile.": "关闭私有贡献后，你的个人主页将只显示公开动态。",
		"Turning off the activity overview will hide the section on your profile.": "关闭活动概览后，个人主页将隐藏该区块。",
		// —— 置顶项编辑器对话框 ——
		"Edit pinned items": "编辑置顶项",
		"Select up to six public repositories or gists you'd like to show to anyone.": "最多可选择六个公开仓库或 Gist 展示给任何人。",
		"Filter repositories": "筛选仓库",
		// 数字独立成节点时只剩这个词（整句形态由 profile/pins-remaining 规则接手）
		"remaining": "个可选",
		// —— 仓库列表筛选（Type / Language / Order 下拉）——
		"Find a repository…": "查找仓库…",
		"Sources": "来源",
		"Mirrors": "镜像",
		// Type 菜单里上游**未**本地化的两项（实机 2026-09 截图 + 仓库列表摘要 HTML 实证）：
		// 其余选项 All / Public / Private / Archived / Forks 由 global 覆盖，此处不重复登记。
		// Templates 与 pages/insights 的同名键同译（「模板」），但键分属两个模块、互不冲突。
		"Templates": "模板",
		"Can be sponsored": "可被赞助",
		"Select language": "选择语言",
		"Select type": "选择类型",
		"Select order": "选择排序",
		"Last updated": "最近更新",
		// —— 仓库列表的结果摘要（五个节点，加粗的三段各被 <strong> 包住）——
		// 实机节点形态：`5` / `results for` / `source` / `repositories sorted by` / `last updated`，
		// 加粗的三段（`5` / `source` / `last updated`）各自是一个独立节点。
		//
		// 片段边界的两条硬规则（2026-10-02 维护者报「极其奇怪的翻译错乱」，实机渲染成
		// 「5 个结果，source 个仓库，按 上次更新。」后重排；同日再报「没有翻译成功」定稿）：
		//   1. **量词只跟着它修饰的数字走**。数字 `5` 是前一个节点（`<strong>5</strong>`，
		//      纯符号节点不进词典、也不会被改写），所以「个」属于数字之后紧邻的那条片段：
		//      `results for` → 「个结果，」拼出来正好是「5 个结果，」。
		//      反过来，「仓库」的计数在页面上**根本不存在**（`5` 数的是结果不是仓库），
		//      原先给 `repositories sorted by` 写的「个仓库」是凭空多出来的量词，
		//      实机上就表现成「source 个仓库」——已去掉。
		//   2. **连接词必须落在它连接的那一段之后**。英文的 `sorted by` 挂在名词短语上，
		//      中文却必须说「按…排序」（动词在宾语之后），所以「按」与「排序」都归末段
		//      `last updated` → 「按上次更新排序」，整句读作
		//      「5 个结果， source 仓库， 按上次更新排序」。
		// 两段译文各自的首尾空白由 walker 按**原文节点**保留，故拼装处的空格与原英文一致。
		"results for": "个结果，",
		"repositories sorted by": "仓库，",
		// 末段是独立节点（小写 "last updated"，与菜单项 "Last updated" 大小写不同、互不影响）。
		// 「按…排序」只能由它承载：这段之后就是容器末尾，动词没有别的落脚点。
		"last updated": "按上次更新排序",
		"Clear filter": "清除筛选",
		// —— 仓库卡片元信息与徽标 ——
		"Apache-2.0": "Apache-2.0 许可证",
		"Forked from": "复刻自",
		"Developer Program Member": "开发者计划成员",
		"GitHub Sponsor": "GitHub 赞助者",
		"Label: GitHub Sponsor": "标签：GitHub 赞助者",
		"Label: Verified": "标签：已验证",
		// —— Gist 列表页（/、/starred、/用户名）——
		"All gists": "全部 Gist",
		"Search Gists": "搜索 Gist",
		"Forked": "已复刻",
		"— forked from": "— 复刻自",
		// —— 组织认证横幅 ——
		"We've verified that the organization": "我们已验证该组织",
		"controls the domains:": "控制以下域名：",
		"Learn more about verified organizations": "进一步了解已验证的组织",
		// —— 屏蔽 / 举报对话框 ——
		"Block user": "屏蔽用户",
		"Report abuse": "举报滥用行为",
		"Block or report user": "屏蔽或举报用户",
		"blocking users": "屏蔽用户",
		"reporting abuse": "举报滥用行为",
		"You must be logged in to block users.": "你必须登录才能屏蔽用户。",
		// 长句键按归一化形式收录：节点内部连续空白在匹配前折叠为
		// 单空格（见 content/walker.ts 的 normalizeKey），漏翻日志里
		// 的换行缩进原文不能直接作键
		"Prevent this user from interacting with your repositories and sending you notifications. Learn more about": "阻止该用户与你的仓库互动并向你发送通知。进一步了解",
		"Contact GitHub support about this user’s behavior. Learn more about": "就该用户的行为联系 GitHub 支持团队。进一步了解",
		"Add an optional note": "添加可选备注",
		"Close all issues, pull requests, and discussions opened by this user": "关闭该用户开启的所有议题、拉取请求和讨论",
		"Content in all repositories owned by your account will be closed.": "你账户名下所有仓库中的内容都将被关闭。",
		"Maximum 250 characters. Please don’t include any personal information such as legal names or email addresses. Markdown is supported. This note will only be visible to you.": "最多 250 个字符。请不要包含法定姓名或电子邮箱地址等任何个人信息。支持 Markdown。此备注仅你可见。",
		// —— 属性词条（aria / alt）——
		"User profile": "用户个人资料",
		"Achievement: Arctic Code Vault Contributor": "成就：北极代码库贡献者",
		"Achievement: Pair Extraordinaire": "成就：结对编程大师",
		"Achievement: Starstruck": "成就：众星捧月",
		// —— 半动态属性：aria 计数，词条键含具体数字，仅解当前值
		// （属性不应用规则，见 content/walker.ts）——
		"0 issues": "0 个议题",
		"2 issues": "2 个议题",
		"23 issues": "23 个议题",
		"99 issues": "99 个议题",
		"0 stars": "0 个星标",
		"6 stars": "6 个星标",
		"19 stars": "19 个星标",
		"199 stars": "199 个星标",
		"0 forks": "0 个复刻",
		"2 forks": "2 个复刻",
		"28 forks": "28 个复刻",
		"88 forks": "88 个复刻",
		"5 pull requests": "5 个拉取请求",
		"6 pull requests": "6 个拉取请求",
		"20 pull requests": "20 个拉取请求",
		"26 pull requests": "26 个拉取请求",
		// （续）组织 / 用户主页仓库卡片的 aria 计数
		"20 issues": "20 个议题",
		"21 issues": "21 个议题",
		"39 issues": "39 个议题",
		"82 issues": "82 个议题",
		"84 issues": "84 个议题",
		"158 issues": "158 个议题",
		"1,331 issues": "1,331 个议题",
		"4,863 issues": "4,863 个议题",
		"1 star": "1 个星标",
		"31 stars": "31 个星标",
		"74 stars": "74 个星标",
		"176 stars": "176 个星标",
		"196 stars": "196 个星标",
		"1022 stars": "1022 个星标",
		"1934 stars": "1934 个星标",
		"2563 stars": "2563 个星标",
		"11107 stars": "11107 个星标",
		"111197 stars": "111197 个星标",
		"30 forks": "30 个复刻",
		"35 forks": "35 个复刻",
		"40 forks": "40 个复刻",
		"89 forks": "89 个复刻",
		"167 forks": "167 个复刻",
		"456 forks": "456 个复刻",
		"680 forks": "680 个复刻",
		"9861 forks": "9861 个复刻",
		"14830 forks": "14830 个复刻",
		"0 pull requests": "0 个拉取请求",
		"1 pull request": "1 个拉取请求",
		"36 pull requests": "36 个拉取请求",
		"40 pull requests": "40 个拉取请求",
		"45 pull requests": "45 个拉取请求",
		"105 pull requests": "105 个拉取请求",
		"152 pull requests": "152 个拉取请求",
		"3,000 pull requests": "3,000 个拉取请求"
	}
}
