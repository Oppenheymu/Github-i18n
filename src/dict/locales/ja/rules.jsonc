// 日本語の置換テンプレート：鍵は core/rules.jsonc のルール id、値は置換テンプレート。
// pattern とキャプチャグループは core/rules.jsonc（言語非依存・順序が意味を持つ）にあり、ここは訳文だけ。
// $1 / $<name> は対応する pattern のキャプチャグループを参照する（日本語の語順に合わせて並べ替えてよい）。
// 値には日本語の文字体系（漢字 / ひらがな / カタカナ）が必要（門禁が強制、置換ループ防止）。
{
	"$schema": "../../types/dict.schema.json",
	"replacements": {
		// —— pages/issues（イシュー一覧）——
		"issues/in-repo": "$1 内；",
		"issues/page-title": "イシュー · $1 · GitHub",
		"issues/on-date": "$1 に",
		"issues/linked-prs-count": "$1 件の関連 PR",

		// —— pages/pulls（プルリクエスト一覧）——
		"pulls/merge-commits-into": "$1 件のコミットを以下にマージ",
		"pulls/hidden-items-count": "$1 件の非表示項目",
		"pulls/participants-count": "$1 人の参加者",
		"pulls/page-title": "プルリクエスト · $1 · GitHub",
		"pulls/pull-request-title-with-number": "$1 · プルリクエスト #$2 · $3 · GitHub",
		"pulls/pull-request-title-with-number-plain": "$1 · プルリクエスト #$2 · $3",

		// —— pages/settings-security（アカウントセキュリティ）——
		"settings/passkey-delete-confirm": "`$1` のパスキーを削除してもよろしいですか？",
		"settings/passkey-delete-cancel": "`$1` のパスキーの削除をキャンセル",
		"settings/passkey-delete-confirm-button": "`$1` のパスキーの削除を確定",
		"settings/passkey-delete-confirm-of": "`$1` のパスキーの削除を確定",
		"settings/passkey-delete-label": "`$1` のパスキーを削除",
		"settings/passkeys-configured-count": "$1 個のパスキーが設定済み",
		"settings/verified-emails-configured-count": "$1 件の確認済みメールアドレスが設定済み",
		"settings/connected-accounts-count": "$1 件のアカウントが接続済み",
		"settings/devices-count": "$1 台のデバイス",
		"settings/passkey-added-last-used-jan-now": "$<year>年1月$<day>日に追加 | 最終使用: たった今",
