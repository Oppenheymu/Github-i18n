// 模块清单（运行时）：模块名 + 路由，顺序即优先级——具体页在前，global 兜底在最后。
//
// 为什么路由是语言无关的、只存一份：上游改版改的是「哪个路径下的哪些英文原文」，
// 与译成哪种语言无关。译文按模块放在 locales/<语言>/ 下，键集合不必跨语言相同
// （引擎未命中即保留英文，缺键 = 尚未翻译，不是错误）。
//
// 词条键的权威清单在 core/canonical.jsonc（覆盖率分母 + 拼错即报）；本文件只管路由。
{
	"$schema": "../types/dict.schema.json",
	"modules": [
		{
			"name": "pages/issues",
			"route": "^/[^/]+/[^/]+/issues"
		},
		{
			"name": "pages/pulls",
			"route": "^/[^/]+/[^/]+/pull"
		},
		// 账号设置路由有**两支**（实测 2026-09，未登录即可复现状态码）：
		//   /settings/**        其余设置（/settings/profile 302 存活；/account/appearance 404，未迁）
		//   /account/billing/**  个人账单整支（/account/billing 302 存活；/settings/billing 404，
		//                        仅 /settings/billing/licensing 尚存，故旧路由仍需兼容）
		// 账单页沿用**同一套设置侧栏**，而侧栏词条（Public profile / Emails / Sessions /
		// Payment history…）全在 pages/settings 与 pages/settings-billing 里，因此两条路由
		// 都必须覆盖 /account/billing，否则在新账单路径上侧栏与正文整体保留英文——
		// 只剩 global 里零星几条命中，表现为「一半中文一半英文」的中英混杂。
		// 这里只精确覆盖 /account/billing 而不是整个 /account：未迁移的设置路径实测是 404，
		// 放宽会为不存在的页面注入整包设置词条。GitHub 后续若继续迁移，改这里并同步
		// tooling/checks/view.ts 的 PROBE_PATHS 与 tooling/fixtures 快照。
		// 账号安全页（/settings/security）：密码、通行密钥、双因素认证。
		// 为什么单独成模块而不是并进 pages/settings：本页有一批**只能靠规则**覆盖的动态文本
		// （每条通行密钥的「添加于 <日期> | 上次使用 <相对时间>」、2FA 强制要求的截止日长句），
		// 月份与相对时间都无法用捕获组映射成中文，只能逐组合全展开（见 core/rules.jsonc）。
		// 挂在 pages/settings 下会让 /settings 的其余几条探针各自背上一百多条永不使用的规则，
		// 把视图骨架快照淹掉。本模块在前、pages/settings 在后，两者都对 /settings/security 命中
		// ——词条逐键「先到先得」，故侧栏与通用设置词条仍由 pages/settings 兜底，
		// 本模块只放本页专属词条（不与 pages/settings 重复登记同一个键）。
		{
			"name": "pages/settings-security",
			"route": "^/settings/security"
		},
		{
			"name": "pages/settings",
			"route": "^/(?:settings|account/billing)"
		},
		{
			// 账单页的路由有**两支**（2026-10-03 实测确认组织账单页渲染的是同一套
			// billing-app 组件、文案逐字相同）：
			//   /settings/billing/**            个人账单旧地址（仅 licensing 尚存）
			//   /account/billing/**             个人账单新地址
			//   /organizations/<组织>/settings/billing/**   组织账单（本行新增）
			// 组织账单页挂在组织设置路由下，但它与 pages/org-settings 的侧栏 / 正文毫无重叠，
			// 整页都是账单组件（SummaryCardContainer / IncludedUsageTile / ProductUsage…）：
			// 「Current metered usage」「Gross metered usage for …」「Timeframe: Current month」
			// 等句子与个人账单页逐字一致（节点原文见实机 HTML 与 settings/billing.test.ts）。
			// 若不覆盖这一支，组织账单页只剩 global 的零星通用词条命中，整页保留英文。
			// 本模块排在 pages/org-settings **之前**，两模块同时命中组织账单页时逐键先到先得：
			// 账单词条与规则由本模块提供，组织设置外壳（侧栏等）由后者兜底。
			"name": "pages/settings-billing",
			"route": "^/(?:(?:settings|account)/billing|(?:organizations|orgs)/[^/]+/settings/billing)"
		},
		{
			"name": "pages/repo-settings",
			// 仓库设置有**两支**路由（实测 2026-09-27）：
			//   /owner/repo/settings/**       绝大多数设置页
			//   /owner/repo/reported_content  举报内容页——GitHub 把它挂在**仓库根**上，
			//                                 不含 settings 前缀。漏掉这一支时整包设置词条
			//                                 都不加载，只剩 pages/repo + global 的通用词条，
			//                                 实机表现为「一进这个页面翻译就消失」：
			//                                 侧栏 General / Webhooks / Moderation 与正文
			//                                 全部保留英文，只有「保存」这类 global 词条是中文。
			// 路由还要排除 /organizations/<组织>/settings 与 /orgs/<组织>/settings：
			// 组织设置页是**另一套**侧栏与正文（pages/org-settings），不排除的话整包仓库
			// 设置词条都会注入组织设置页。实机证据（2026-10-03 维护者用 popup 开发者模式
			// 采集的漏翻清单）：组织设置页的侧栏项被译成仓库设置的措辞
			//（如 `Actions` →「Actions 工作流」、`GitHub Apps` →「GitHub 应用」），
			// 而真正属于组织页的文案（Repository policies / Member privileges…）全部保留英文。
			"route": "^/(?!(?:organizations|orgs)/)[^/]+/[^/]+/(?:settings|reported_content)"
		},
		{
			// 组织设置：/organizations/<组织>/settings/** （另有 /orgs/<组织>/settings 一支，
			// 是同一页的旧地址，两条都要覆盖；不存在的路径不会渲染，多覆盖不会误注入）。
			// 为什么单独成模块：组织设置的侧栏与正文和仓库设置毫无重叠
			//（Profile / Member privileges / Repository policies / Authentication security…），
			// 挂进 pages/repo-settings 会让两边互相污染，见上一条的排除说明。
			// 本模块只放组织设置专属词条；`Organization` / `Menu` 这类外壳词条按页面实际
			// 渲染登记（它们与 pages/settings 同键但路径互斥，不会构成跨模块碰撞）。
			"name": "pages/org-settings",
			"route": "^/(?:organizations|orgs)/[^/]+/settings"
		},
		{
			"name": "pages/actions",
			"route": "^/[^/]+/[^/]+/actions"
		},
		{
			"name": "pages/agents",
			"route": "^/[^/]+/[^/]+/agents"
		},
		{
			// 登录后首页有**两个地址**：`/` 与 `/dashboard`（GitHub 的头像菜单与
			// 顶栏「Home」都指向后者）。早期只登记了 `^/$`，于是维护者从 /dashboard
			// 访问时整页 dashboard 词条都不加载——只吃 global 兜底，表现为「补了却没生效」。
			// 两条地址渲染的是同一页，故并成一条路由；`/dashboard` 是 GitHub 的保留
			// 顶层路径（已列在 pages/profile 与 pages/repo 的保留名单里），不会误注入别的页面。
			"name": "pages/dashboard",
			"route": "^/(?:dashboard)?/?$"
		},
		{
			"name": "pages/commits",
			"route": "^/[^/]+/[^/]+/(commits?|tags|branches|compare)"
		},
		{
			"name": "pages/discussions",
			"route": "^/[^/]+/[^/]+/discussions"
		},
		{
			"name": "pages/wiki",
			"route": "^/[^/]+/[^/]+/wiki"
		},
		{
			"name": "pages/insights",
			"route": "^/[^/]+/[^/]+/(pulse|graphs|forks|security|projects)"
		},
		{
			"name": "pages/search",
			"route": "^/(search|topics)"
		},
		{
			"name": "pages/marketing",
			"route": "^/(features|pricing)"
		},
		// 用户主页是**单段路径**（/octocat）。GitHub 的保留顶层路径不是用户名，不排除它们
		// 的话这一模块会把整包个人主页词条（Edit profile / Block or report / Contribution
		// activity…）注入 /search、/features、/pricing、/notifications 等页面——与 pages/repo
		// 注入 /settings 是同一类越界，只是注入量更大。新增保留路径要同步这里与 pages/repo。
		{
			"name": "pages/profile",
			"route": "^/(?!(?:settings|account|billing|sessions|login|logout|signup|join|search|explore|topics|trending|collections|marketplace|apps|sponsors|codespaces|notifications|dashboard|issues|pulls|discussions|stars|watching|new|organizations|orgs|users|enterprises|features|pricing|site|security|team|events|about|contact)(?:/|$))[^/]+$"
		},
		// 仓库页：/owner/repo 及其任意子路径。保留顶层路径必须排除——`^/[^/]+/[^/]+` 会命中
		// /settings/profile、/settings/appearance 等**用户账号设置页**，把仓库专属词条
		// （Code / Clone / Blame / Raw / Release…）注入进去。实测口径：本模块共 86 条词条，
		// 其中 84 条在 /settings/profile 上真的会生效（另 2 条 Actions / Name 与 pages/settings
		// 同键，被它压过）；实机确认设置页上的 Code / Clone / Download ZIP 确实会被译成中文。
		// 保留清单与 pages/profile 保持同一份；新增保留路径要同步。
		{
			"name": "pages/repo",
			"route": "^/(?!(?:settings|account|billing|sessions|login|logout|signup|join|search|explore|topics|trending|collections|marketplace|apps|sponsors|codespaces|notifications|dashboard|issues|pulls|discussions|stars|watching|new|organizations|orgs|users|enterprises|features|pricing|site|security|team|events|about|contact)(?:/|$))[^/]+/[^/]+"
		},
		{
			"name": "global",
			"route": "^/"
		}
	]
}
