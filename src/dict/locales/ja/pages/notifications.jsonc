// 通知ページモジュール：/notifications
// 日本語 · モジュール pages/notifications（ルートは core/modules.jsonc、キーのグループ注釈は core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Notification settings": "通知の設定",
		// watch 系の用語は global に準拠（Watch=ウォッチ / Watching=ウォッチ中）
		"Watched repositories": "ウォッチ中のリポジトリ",
		// pages/settings、pages/settings-billing の同名列と同じ訳
		"Subscriptions": "サブスクリプション",
		"Manage notifications": "通知を管理",
		// ページ下部の ProTip 表示：<strong>ProTip!</strong> と説明文は兄弟ノード；
		// ProTip! は search / settings の同名キーと同じ訳、説明文の句点はノード内なので日本語の句点に
		"ProTip!": "プロのヒント！",
		"Create custom filters to quickly access your most important notifications.": "カスタムフィルターを作成して、最も重要な通知にすばやくアクセスしましょう。"
	}
}
