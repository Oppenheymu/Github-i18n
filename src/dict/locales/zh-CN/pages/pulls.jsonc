// 拉取请求模块：/owner/repo/pull 与 /pulls（列表与详情页）专属词条
// 路由同时覆盖详情页（/pull/<编号>）与列表页（/pulls）
// 简体中文 · 模块 pages/pulls（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Conversation": "对话",
		"Checks": "检查",
		"Files changed": "文件变更",
		"Merge": "合并",
		"Squash and merge": "压缩合并",
		"Rebase and merge": "变基合并",
		"Merge pull request": "合并拉取请求",
		"Close pull request": "关闭拉取请求",
		"Reopen pull request": "重新打开拉取请求",
		"Request changes": "请求修改",
		"Approve": "批准",
		"Approved": "已批准",
		"Submit review": "提交审查",
		"Resolve conversation": "解决对话",
		"This branch has no conflicts with the base branch": "此分支与基线分支没有冲突",
		// —— 列表页状态图标（aria-label）——
		"Open pull request": "打开的拉取请求",
		"Draft pull request": "草稿拉取请求",
		// —— 详情页头与合并横幅 ——
		"Pull request": "拉取请求",
		"Commit message body": "提交信息正文",
		"from": "来自",
		"Copy head branch name to clipboard": "复制源分支名到剪贴板",
		// —— 时间线事件与侧栏 ——
		"mentioned this pull request": "提及了此拉取请求",
		"added a commit that referenced this pull request": "添加了引用此拉取请求的提交",
		"deleted the": "删除了",
		"This comment was marked as outdated.": "此评论已被标记为过时。",
		"No reviews": "暂无审查",
		"This user is the author of this pull request.": "此用户是此拉取请求的作者。",
		// —— 版式与窗格 ——
		"Draggable pane splitter": "可拖动的面板分隔条",
		// —— 列表页筛选栏与排序（React 重写版工具栏）——
		"Search pull requests": "搜索拉取请求",
		"Pull request filters": "拉取请求筛选器",
		"Pull requests display density": "拉取请求显示密度",
		"Comfortable display density": "宽松显示密度",
		"Compact display density": "紧凑显示密度",
		"Clear filter": "清除筛选",
		"More items": "更多条目",
		"Newest": "最新",
		"descending": "降序",
		"Assignee": "指派人",
		"Label": "标签",
		"Reviews": "审查",
		"Filter by assignee": "按指派人筛选",
		"Filter by label": "按标签筛选",
		"Filter by reviews": "按审查筛选",
		"Filter by review: Review required": "按审查筛选：需要审查",
		"Filter by review: Approved": "按审查筛选：已批准",
		"Sort by Newest descending": "按最新降序排序",
		"Review required": "需要审查",
		"Review required before merging": "合并前需要审查",
		// —— 列表页侧栏与空状态(2026-10-25 closed 态实机 HTML)——
		// 大半与 pages/issues 同键同译(侧栏是 issues/pulls 两族各自渲染的组件,
		// /pulls 路由吃不到 issues 的键);Authored by me 对应 issues 版 Created by me
		"Authored by me": "我创建的",
		"Assigned to me": "指派给我的",
		"Involves me": "与我相关",
		"Review requests": "审查请求",
		"Feedback": "反馈",
		"Collapse sidebar": "收起侧栏",
		// 静态键覆盖无尾随内容形态(issues 同译);带用户名的 aria-label 走规则
		"Filter by author": "按作者筛选",
		// PR 版空状态(issues 版是 No results matched your search)
		"No pull requests matched your search": "没有与你的搜索匹配的拉取请求",
		"Try a different search query.": "请尝试其他搜索查询。",
		"Learn more about searching and filtering pull requests.": "详细了解如何搜索和筛选拉取请求。",
		// —— 上一行帮助链接的新版拆节点形态（2026-10-25 实机：链接内拆成三段，
		// 句号是独立纯符号节点不收录）。前段与 issues 模块的同名键同译；拼接结果
		// 「详细了解如何搜索和筛选拉取请求.」（前段尾随空格由引擎保留，句点保持英文）；
		// 整句键保留给旧版渲染。「pull requests」仅本模块生效，与 insights 计数场景
		// 的同名键（个拉取请求）路由互斥互不共存 ——
		"Learn more about searching and filtering": "详细了解如何搜索和筛选",
		"pull requests": "拉取请求",
		// —— 结果行动词碎片(「by <作者> was merged <相对时间>」,作者名用户内容不收)——
		"by": "由",
		"was merged": "合并于",
		// —— 详情页导航与关联议题 ——
		"Pull request navigation": "拉取请求导航",
		"Link issues": "关联议题",
		"Successfully merging this pull request may close these issues.": "成功合并此拉取请求后可能会关闭这些议题。",
		// —— 建议应用提示（suggestion 横幅）——
		"Add this suggestion to a batch that can be applied as a single commit.": "将此建议添加到可作为一个提交应用的批次中。",
		"Applying suggestions on deleted lines is not supported.": "不支持在已删除的行上应用建议。",
		"Only one suggestion per line can be applied in a batch.": "一个批次中每行只能应用一个建议。",
		"Outdated suggestions cannot be applied.": "过时的建议无法应用。",
		"Suggestion cannot be applied right now. Please check back later.": "暂时无法应用此建议，请稍后再试。",
		"Suggestions cannot be applied from pending reviews.": "无法从待提交的审查中应用建议。",
		"Suggestions cannot be applied on multi-line comments.": "无法在多行评论上应用建议。",
		"Suggestions cannot be applied while the pull request is closed.": "拉取请求已关闭时无法应用建议。",
		"Suggestions cannot be applied while the pull request is queued to merge.": "拉取请求已排队等待合并时无法应用建议。",
		"Suggestions cannot be applied while viewing a subset of changes.": "查看部分变更时无法应用建议。",
		"This suggestion has been applied or marked resolved.": "此建议已被应用或标记为已解决。",
		"This suggestion is invalid because no changes were made to the code.": "此建议无效，因为没有对代码做出任何更改。",
		"You must change the existing code in this line in order to create a valid suggestion.": "必须更改此行中的现有代码才能创建有效的建议。",
		// —— 合并区与各下拉（2026-10-31 实机 HTML + 截图）——
		// 快捷键提示五节点：`Press ` + <kbd>h</kbd> + ` to cycle through filters, `
		// + <br> + ` even when the dropdown is closed`——三段碎片各自查表，kbd 内
		// 文本排除，<br> 保留；拼接成「按 h 循环切换筛选器，即使下拉菜单处于关闭状态」
		"Press": "按",
		"to cycle through filters,": "循环切换筛选器，",
		"even when the dropdown is closed": "即使下拉菜单处于关闭状态",
		// 筛选下拉的显示档位（维护者 2026-10-31 同批截图）
		"Show all activities": "显示全部动态",
		"Hide events": "隐藏事件",
		"Hide events, bots, collapsed comments": "隐藏事件、机器人、折叠的评论",
		// 绕过合并（红字选项与按钮；squash 是合并方式专有名词保留）
		"Merge without waiting for requirements to be met (bypass rules)": "无需等待满足条件即可合并（绕过规则）",
		"Bypass rules and merge (squash)": "绕过规则并合并（squash）",
		// —— Update branch 下拉 ——
		"Update branch": "更新分支",
		"Update with merge commit": "用合并提交更新",
		"The merge commit will be associated with your account.": "合并提交将关联到你的帐户。",
		"Update with rebase": "用变基更新",
		"This pull request will be rebased on top of the latest changes and then force pushed.": "此拉取请求将变基到最新更改之上，然后强制推送。",
		// —— 代码下拉与 Merge status 按钮 ——
		"Merge status": "合并状态",
		"Checkout with GitHub CLI": "使用 GitHub CLI 检出",
		"Work fast with our official CLI.": "用我们的官方 CLI 快速工作。",
		"Open in GitHub Copilot app": "在 GitHub Copilot 应用中打开",
		"Checkout with GitHub Desktop": "使用 GitHub Desktop 检出",
		// —— 通知 shelf 顶栏（issues 详情同栏，先收本页）——
		"Mark as unread": "标记为未读",
		"Mark as read": "标记为已读",
		// —— merge 区与右侧栏 ——
		"Merge when ready": "就绪后合并",
		"Merging is blocked": "合并被阻止",
		"At least 1 approving review is required by reviewers with write access.": "需要至少 1 名具有写权限的审查者批准。",
		// em dash 在节点内
		"No reviews—at least 1 approving review is required.": "暂无审查——至少需要 1 个批准审查。",
		// 「Still in progress? Convert to draft」：问号在碎片节点内，链接独立
		"Still in progress?": "仍在进行中？",
		"Convert to draft": "转换为草稿",
		"Lock conversation": "锁定对话",
		"Archive pull request": "归档拉取请求",
		// 评论框 placeholder
		"Add your comment here, be kind": "在这里添加你的评论，请友善",
		// 通知订阅说明
		"You're receiving notifications because you're watching this repository.": "你正在接收通知，因为你正在关注此仓库。",
		// —— 合并后横幅、合并队列提示与时间线事件（2026-10-31 第二批实机）——
		// 合并成功横幅
		"Pull request successfully merged and closed": "拉取请求已成功合并并关闭",
		// em dash 在节点内
		"You're all set — the branch has been merged.": "一切就绪——分支已合并。",
		// 合并队列提示五节点拼装：「本仓库使用 合并队列 来完成对 main 分支的所有合并。」
		// —— main 是分支名用户内容不收；末节点句号随节点译出
		"This repository uses the": "本仓库使用",
		"merge queue": "合并队列",
		"for all merges into the": "来完成对",
		"branch.": "分支的所有合并。",
		// 命令行提示
		"You can also merge this with the command line.": "也可以通过命令行合并。",
		"View command line instructions.": "查看命令行说明。",
		// 时间线事件碎片（用户名、哈希、徽章、分支名是用户内容不收）：
		// 「<user> merged commit <sha> into <base>」等
		"merged commit": "合并了提交",
		"into": "至",
		"assigned": "指派了",
		"added": "添加了",
		"labels": "标签",
		"branch": "分支",
		// 检查摘要数字动态走 rules 的 pulls/checks-passed（「13 checks passed」实机截图）
		// —— 侧栏下拉（assignees / labels 弹层；issues 页 this issue 形态命中再姊妹登记）
		"Assign up to 10 people to this pull request": "最多可将 10 人指派给此拉取请求",
		"Clear assignees": "清除指派人",
		"Apply labels to this pull request": "为此拉取请求应用标签",
		// 绕过合并的确认按钮
		"Confirm bypass rules and merge (squash)": "确认绕过规则并合并（squash）",
		// —— 评论框页脚（拆节点：说明句 + 三条链接；逗号与句号是独立纯符号节点不收，
		// ", and" 是第二、三条链接间的连接节点）与 protip 行（「Pro tip!」GitHub 已自译）——
		"Remember, contributions to this repository should follow its": "请记住，对本仓库的贡献应遵循其",
		"contributing guidelines": "贡献指南",
		"security policy": "安全策略",
		"code of conduct": "行为准则",
		", and": "和",
		"Add comments to specific lines under": "在以下位置对具体行添加评论："
	}
}
