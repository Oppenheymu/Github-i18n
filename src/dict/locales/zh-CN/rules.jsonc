		"settings/month-year-nov": "$1 年 11 月",
		"settings/month-year-dec": "$1 年 12 月",
		// AI 用量页的 AI 点数单价脚注：金额（含美元符号）由捕获组带出，模板里不再另写 $
		"settings/ai-credit-cost": "每个 GitHub AI 点数费用为 $<amount>。",
		// 预算与提醒页的标题行计数与预算行金额（金额含美元符号，见上一条的说明）
		"settings/budget-count": "$<count> 条账户预算",
		"settings/budget-amount-spent": "已支出 $<amount>",
		"settings/budget-amount-limit": "$<amount> 预算",
		// 许可页「包含」清单里带数量的四条：数值与单位原样保留，只把英文结构换成中文语序
		"settings/licensing-actions-minutes-per-month": "$<count> 分钟 Actions/月",
		"settings/licensing-packages-storage": "$<count>$<unit> Packages 存储",
		"settings/licensing-codespaces-compute": "每位开发者 $<count> 个代码空间核心小时",
		"settings/licensing-codespaces-storage": "每位开发者 $<count>$<unit> 代码空间存储",
		// 赞助订阅页（/settings/billing/subscriptions）：$1 是组织数（动态）
		"settings/manage-organizations": "除个人账户外，你还管理 $1 个组织。",
		// 空态：模板里不含撇号，因此与 pattern 的直/弯撇号字符类互不干扰
		"settings/sponsoring-none": "你目前没有赞助任何人。"
	}
}
