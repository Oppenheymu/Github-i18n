// 拉取请求模块：/owner/repo/pull 与 /pulls（列表与详情页）专属词条
// 路由同时覆盖详情页（/pull/<编号>）与列表页（/pulls）
// 简体中文 · 模块 pages/pulls（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Conversation": "对话",
		"Checks": "检查",
		"Files changed": "文件变更",
		"Merge": "合并",
		"Squash and merge": "压缩合并",
		"Rebase and merge": "变基合并",
		"Merge pull request": "合并拉取请求",
		"Close pull request": "关闭拉取请求",
		"Reopen pull request": "重新打开拉取请求",
		"Request changes": "请求修改",
		"Approve": "批准",
		"Approved": "已批准",
		"Submit review": "提交审查",
		"Resolve conversation": "解决对话",
		"This branch has no conflicts with the base branch": "此分支与基线分支没有冲突",
		// —— 列表页状态图标（aria-label）——
		"Open pull request": "打开的拉取请求",
		"Draft pull request": "草稿拉取请求",
		// —— 详情页头与合并横幅 ——
		"Pull request": "拉取请求",
		"Commit message body": "提交信息正文",
		"from": "来自",
		"Copy head branch name to clipboard": "复制源分支名到剪贴板",
		// —— 时间线事件与侧栏 ——
		"mentioned this pull request": "提及了此拉取请求",
		"added a commit that referenced this pull request": "添加了引用此拉取请求的提交",
		"deleted the": "删除了",
		"This comment was marked as outdated.": "此评论已被标记为过时。",
		"No reviews": "暂无审查",
		"This user is the author of this pull request.": "此用户是此拉取请求的作者。",
		// —— 版式与窗格 ——
		"Draggable pane splitter": "可拖动的面板分隔条",
		// —— 列表页筛选栏与排序（React 重写版工具栏）——
		"Search pull requests": "搜索拉取请求",
		"Pull request filters": "拉取请求筛选器",
		"Pull requests display density": "拉取请求显示密度",
		"Comfortable display density": "宽松显示密度",
		"Compact display density": "紧凑显示密度",
		"Clear filter": "清除筛选",
		"More items": "更多条目",
		"Newest": "最新",
		"descending": "降序",
		"Assignee": "指派人",
		"Label": "标签",
		"Reviews": "审查",
		"Filter by assignee": "按指派人筛选",
		"Filter by label": "按标签筛选",
		"Filter by reviews": "按审查筛选",
		"Filter by review: Review required": "按审查筛选：需要审查",
		"Filter by review: Approved": "按审查筛选：已批准",
		"Sort by Newest descending": "按最新降序排序",
		"Review required": "需要审查",
		"Review required before merging": "合并前需要审查",
		// —— 列表页侧栏与空状态(2026-10-25 closed 态实机 HTML)——
		// 大半与 pages/issues 同键同译(侧栏是 issues/pulls 两族各自渲染的组件,
		// /pulls 路由吃不到 issues 的键);Authored by me 对应 issues 版 Created by me
		"Authored by me": "我创建的",
		"Assigned to me": "指派给我的",
		"Involves me": "与我相关",
		"Review requests": "审查请求",
		"Feedback": "反馈",
		"Collapse sidebar": "收起侧栏",
		// 静态键覆盖无尾随内容形态(issues 同译);带用户名的 aria-label 走规则
		"Filter by author": "按作者筛选",
		// PR 版空状态(issues 版是 No results matched your search)
		"No pull requests matched your search": "没有与你的搜索匹配的拉取请求",
		"Try a different search query.": "请尝试其他搜索查询。",
		"Learn more about searching and filtering pull requests.": "详细了解如何搜索和筛选拉取请求。",
		// —— 上一行帮助链接的新版拆节点形态（2026-10-25 实机：链接内拆成三段，
		// 句号是独立纯符号节点不收录）。前段与 issues 模块的同名键同译；拼接结果
		// 「详细了解如何搜索和筛选拉取请求.」（前段尾随空格由引擎保留，句点保持英文）；
		// 整句键保留给旧版渲染。「pull requests」仅本模块生效，与 insights 计数场景
		// 的同名键（个拉取请求）路由互斥互不共存 ——
		"Learn more about searching and filtering": "详细了解如何搜索和筛选",
		"pull requests": "拉取请求",
		// —— 结果行动词碎片(「by <作者> was merged <相对时间>」,作者名用户内容不收)——
		"by": "由",
		"was merged": "合并于",
		// —— 详情页导航与关联议题 ——
		"Pull request navigation": "拉取请求导航",
		"Link issues": "关联议题",
		"Successfully merging this pull request may close these issues.": "成功合并此拉取请求后可能会关闭这些议题。",
		// —— 建议应用提示（suggestion 横幅）——
		"Add this suggestion to a batch that can be applied as a single commit.": "将此建议添加到可作为一个提交应用的批次中。",
		"Applying suggestions on deleted lines is not supported.": "不支持在已删除的行上应用建议。",
		"Only one suggestion per line can be applied in a batch.": "一个批次中每行只能应用一个建议。",
		"Outdated suggestions cannot be applied.": "过时的建议无法应用。",
		"Suggestion cannot be applied right now. Please check back later.": "暂时无法应用此建议，请稍后再试。",
		"Suggestions cannot be applied from pending reviews.": "无法从待提交的审查中应用建议。",
		"Suggestions cannot be applied on multi-line comments.": "无法在多行评论上应用建议。",
		"Suggestions cannot be applied while the pull request is closed.": "拉取请求已关闭时无法应用建议。",
		"Suggestions cannot be applied while the pull request is queued to merge.": "拉取请求已排队等待合并时无法应用建议。",
		"Suggestions cannot be applied while viewing a subset of changes.": "查看部分变更时无法应用建议。",
		"This suggestion has been applied or marked resolved.": "此建议已被应用或标记为已解决。",
		"This suggestion is invalid because no changes were made to the code.": "此建议无效，因为没有对代码做出任何更改。",
		"You must change the existing code in this line in order to create a valid suggestion.": "必须更改此行中的现有代码才能创建有效的建议。"
	}
}
