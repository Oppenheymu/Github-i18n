// 日本語・モジュール pages/pulls：/owner/repo/pull と /pulls（一覧・詳細）の専用エントリ。
// ルートは詳細ページ（/pull/<番号>）と一覧ページ（/pulls）の両方を覆う。
// 鍵は core/canonical.jsonc にある英語原文との完全一致（綴り違いは門禁が弾く）。
// 値には日本語の文字体系（漢字 / ひらがな / カタカナ）が必要。
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Conversation": "会話",
		"Checks": "チェック",
		"Files changed": "ファイルの変更",
		"Merge": "マージ",
		"Squash and merge": "スカッシュしてマージ",
		"Rebase and merge": "リベースしてマージ",
		"Merge pull request": "プルリクエストをマージ",
		"Close pull request": "プルリクエストをクローズ",
		"Reopen pull request": "プルリクエストを再オープン",
		"Request changes": "変更をリクエスト",
		"Approve": "承認",
		"Approved": "承認済み",
		"Submit review": "レビューを送信",
		"Resolve conversation": "会話を解決",
		"This branch has no conflicts with the base branch": "このブランチはベースブランチと競合していません",
		// —— 一覧ページのステータスアイコン（aria-label）——
		"Open pull request": "オープンなプルリクエスト",
		"Draft pull request": "下書きのプルリクエスト",
		// —— 詳細ページのヘッダーとマージバナー ——
		"Pull request": "プルリクエスト",
		"Commit message body": "コミットメッセージの本文",
		"from": "から",
		"Copy head branch name to clipboard": "ヘッドブランチ名をクリップボードにコピー",
		// —— タイムラインのイベントとサイドバー ——
		"mentioned this pull request": "このプルリクエストに言及しました",
		"added a commit that referenced this pull request": "このプルリクエストを参照するコミットを追加しました",
		"deleted the": "削除しました",
		"This comment was marked as outdated.": "このコメントは古いものとしてマークされました。",
		"No reviews": "レビューはありません",
		"This user is the author of this pull request.": "このユーザーはこのプルリクエストの作成者です。",
		// —— レイアウトとペイン ——
		"Draggable pane splitter": "ドラッグ可能なペインスプリッター",
		// —— 一覧ページの絞り込みバーと並べ替え（React 版ツールバー）——
		"Search pull requests": "プルリクエストを検索",
		"Pull request filters": "プルリクエストのフィルター",
		"Pull requests display density": "プルリクエストの表示密度",
		"Comfortable display density": "ゆったりした表示密度",
		"Compact display density": "コンパクトな表示密度",
		"Clear filter": "フィルターをクリア",
		"More items": "その他の項目",
		"Newest": "新しい順",
		"descending": "降順",
		"Assignee": "担当者",
		"Label": "ラベル",
		"Reviews": "レビュー",
		"Filter by assignee": "担当者で絞り込む",
		"Filter by label": "ラベルで絞り込む",
		"Filter by reviews": "レビューで絞り込む",
		"Filter by review: Review required": "レビューで絞り込む：レビューが必要",
		"Filter by review: Approved": "レビューで絞り込む：承認済み",
		"Sort by Newest descending": "新しい順（降順）で並べ替え",
		"Review required": "レビューが必要",
		"Review required before merging": "マージ前にレビューが必要",
		// —— リストページのサイドバーと空状態(2026-10-25 closed 状態の実機 HTML)——
		// 大半は pages/issues の同名キーと同じ訳(サイドバーは issues/pulls それぞれで
		// 描画されるコンポーネントで、/pulls ルートでは issues のキーに届かない);
		// Authored by me は issues 版 Created by me に対応し同じ訳
		"Authored by me": "自分が作成",
		"Assigned to me": "自分に割り当て",
		"Involves me": "自分が関与",
		"Review requests": "レビューリクエスト",
		"Feedback": "フィードバック",
		"Collapse sidebar": "サイドバーを折りたたむ",
		// 静的キーは末尾内容なしの形を担う(issues と同じ訳);ユーザー名付き aria-label はルールで
		"Filter by author": "作成者で絞り込む",
		// PR 版の空状態(issues 版は No results matched your search)
		"No pull requests matched your search": "検索に一致するプルリクエストがありません",
		"Try a different search query.": "別の検索クエリを試してください。",
		"Learn more about searching and filtering pull requests.": "プルリクエストの検索と絞り込みについて詳しく見る",
		// —— 上の行のヘルプリンクの新版分割ノード形態（2026-10-25 実機：リンク内が 3 ノードに
		// 分割、句点「.」は独立した記号ノードとして収録しない）。前段は issues モジュールの
		// 同名キーと同一訳。日本語は語順の都合上、「詳しくは、」を前ノードに置き、結合結果は
		// 「詳しくは、 プルリクエストの検索と絞り込み.」になる。整文キーは旧版描画用に残す ——
		"Learn more about searching and filtering": "詳しくは、",
		"pull requests": "プルリクエストの検索と絞り込み",
		// —— 結果行の動詞断片(「by <作成者> was merged <相対時刻>」,作成者名はユーザー内容につき未収録)——
		"by": "実行者:",
		"was merged": "がマージ済み",
		// —— 詳細ページのナビゲーションと関連イシュー ——
		"Pull request navigation": "プルリクエストのナビゲーション",
		"Link issues": "イシューをリンク",
		"Successfully merging this pull request may close these issues.": "このプルリクエストを正常にマージすると、これらのイシューがクローズされる場合があります。",
		// —— 提案の適用に関するヒント（suggestion バナー）——
		"Add this suggestion to a batch that can be applied as a single commit.": "この提案を、1 つのコミットとしてまとめて適用できるバッチに追加します。",
		"Applying suggestions on deleted lines is not supported.": "削除された行への提案の適用はサポートされていません。",
		"Only one suggestion per line can be applied in a batch.": "バッチで適用できる提案は 1 行につき 1 件だけです。",
		"Outdated suggestions cannot be applied.": "古い提案は適用できません。",
		"Suggestion cannot be applied right now. Please check back later.": "現在この提案は適用できません。しばらくしてからもう一度お試しください。",
		"Suggestions cannot be applied from pending reviews.": "保留中のレビューからは提案を適用できません。",
		"Suggestions cannot be applied on multi-line comments.": "複数行のコメントには提案を適用できません。",
		"Suggestions cannot be applied while the pull request is closed.": "プルリクエストがクローズされている間は提案を適用できません。",
		"Suggestions cannot be applied while the pull request is queued to merge.": "プルリクエストがマージ待ちの間は提案を適用できません。",
		"Suggestions cannot be applied while viewing a subset of changes.": "変更の一部を表示している間は提案を適用できません。",
		"This suggestion has been applied or marked resolved.": "この提案は適用済みか、解決済みとしてマークされています。",
		"This suggestion is invalid because no changes were made to the code.": "コードに変更がないため、この提案は無効です。",
		"You must change the existing code in this line in order to create a valid suggestion.": "有効な提案を作成するには、この行の既存のコードを変更する必要があります。",
		// —— マージ領域と各ドロップダウン（2026-10-31 実機 HTML + スクリーンショット）——
		// ショートカット説明は 5 ノード構造：`Press ` + <kbd>h</kbd> +
		// ` to cycle through filters, ` + <br> + ` even when the dropdown is closed`。
		// ja は語序の都合で端点に「次のキーを押すと…同様です」の枠を置き、
		// 「次のキーを押すと h でフィルターを順に切り替えられ、ドロップダウンが
		// 閉じていても同様です」と繋ぐ
		"Press": "次のキーを押すと ",
		"to cycle through filters,": "でフィルターを順に切り替えられ、",
		"even when the dropdown is closed": "ドロップダウンが閉じていても同様です",
		// 絞り込みドロップダウンの表示段階
		"Show all activities": "すべてのアクティビティを表示",
		"Hide events": "イベントを非表示",
		"Hide events, bots, collapsed comments": "イベント、ボット、折りたたまれたコメントを非表示",
		// バイパス マージ（赤字の選択肢とボタン；squash はマージ方式の固有名詞なのでそのまま）
		"Merge without waiting for requirements to be met (bypass rules)": "要件が満たされるのを待たずにマージする（ルールをバイパス）",
		"Bypass rules and merge (squash)": "ルールをバイパスしてマージ（squash）",
		// —— ブランチを更新ドロップダウン ——
		"Update branch": "ブランチを更新",
		"Update with merge commit": "マージコミットで更新",
		"The merge commit will be associated with your account.": "マージコミットはあなたのアカウントに関連付けられます。",
		"Update with rebase": "リベースで更新",
		"This pull request will be rebased on top of the latest changes and then force pushed.": "このプルリクエストは最新の変更の上にリベースされ、その後強制プッシュされます。",
		// —— コードドロップダウンと Merge status ボタン ——
		"Merge status": "マージステータス",
		"Checkout with GitHub CLI": "GitHub CLI でチェックアウト",
		"Work fast with our official CLI.": "公式 CLI で素早く作業できます。",
		"Open in GitHub Copilot app": "GitHub Copilot アプリで開く",
		"Checkout with GitHub Desktop": "GitHub Desktop でチェックアウト",
		// —— 通知シェルフの上部バー（issues 詳細も同じバー、まず本ページに収録）——
		"Mark as unread": "未読としてマーク",
		"Mark as read": "既読としてマーク",
		// —— マージ領域と右サイドバー ——
		"Merge when ready": "準備ができたらマージ",
		"Merging is blocked": "マージがブロックされています",
		"At least 1 approving review is required by reviewers with write access.": "書き込み権限を持つレビュアーによる承認レビューが少なくとも 1 件必要です。",
		// em dash はノード内
		"No reviews—at least 1 approving review is required.": "レビューなし——承認レビューが少なくとも 1 件必要です。",
		// 「Still in progress? Convert to draft」：疑問符は断片ノード内、リンクは独立
		"Still in progress?": "まだ進行中ですか？",
		"Convert to draft": "ドラフトに変換",
		"Lock conversation": "会話をロック",
		"Archive pull request": "プルリクエストをアーカイブ",
		// コメント欄のプレースホルダー
		"Add your comment here, be kind": "ここにコメントを追加してください。丁寧に",
		// 通知購読の説明
		"You're receiving notifications because you're watching this repository.": "このリポジトリをウォッチしているため、通知が届いています。"
	}
}
