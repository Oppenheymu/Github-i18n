// 组织设置模块：/organizations/<组织>/settings/** （另有 /orgs/<组织>/settings 一支）
// 简体中文 · 模块 pages/org-settings（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
//
// 证据：① 2026-10-03 维护者用 popup 开发者模式导出的漏翻清单（途径 A），覆盖
// /organizations/Koishi-CE/settings/profile 与 …/policies/repositories 两页——
// 途径 A 只给文本与出现次数、不给节点边界，故那批只收**本身就是完整节点**的短标签；
// ② 同日维护者贴的两段实机 HTML（装了扩展后复制的 /settings/profile，中英混排）——
// 那两批按标签真实嵌套逐条登记，节点边界见
// src/dict/__tests__/pages/org-settings/profile.test.ts；
// ③ 同日维护者贴的 `Layout-sidebar` 实机 HTML（侧栏是所有子页共用的外壳），
// 补齐分组标题与第一批清单没覆盖到的条目，节点边界见同目录的 sidebar.test.ts；
// ④ 2026-10-09 维护者贴的整页截图：**组织主题页 `/orgs/<组织>/topics`**（路由的第四支，
// 不在 `/settings/` 前缀下）。它本身只有页头标题一条新键，证据价值在于证明
// 「同一套设置外壳也会挂在组织根路径上」——漏掉路由时整块侧栏保留英文，见
// src/dict/__tests__/pages/org-settings/topics.test.ts。
//
// `Pages` 一条是对 global 的**定点纠正**：global 把 GitHub Pages 的 `Pages` 收成了
// 「页码」，本模块在自己的路由上覆盖为「页面」；global 那条是否有别的页面证据尚不明确，
// 未动它（改动 global 影响全站，需要独立证据）。
//
// 刻意**不收录**（未命中即保留英文，这才是正确行为）：
//   - 产品名与缩写：Dependabot / Copilot / OIDC / GitHub Team；
//   - 国家与地区下拉的名称（Afghanistan…Åland，约 200 条）、州 / 省下拉的名称
//     （Alabama…Wyoming / Alberta…Yukon）：属用户可选的数据值，整节点精确匹配会误伤
//     同名的 location 文本与仓库名，维护者已明确暂不收录；
//   - 社交平台品牌名（Bluesky / Facebook / X / YouTube…）与组织名、用户名、头像 alt；
//   - 隐藏 span 上的 `data-wording="on behalf of"`（`data-*` 不在引擎翻译的六个属性里）。
//
// 已知取舍：危险区域对话框里 `We` / `will` / `archived` / `cancel`，以及设置范围
// 切换器里的 `settings`（小写）这类单词键本身是泛化词，只因为模块按路由限定在
// 组织设置页才敢收（同一页的仓库列表可能撞名，频率极低）；`settings` 一条另有
// pages/settings 的同句先例兜着。再遇到实机误伤就直接删词条，别加白名单。
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		// —— 设置外壳（侧栏、上下文切换器、组织导航）——
		"Organization settings": "组织设置",
		"Organization": "组织",
		"Organization navigation": "组织导航",
		"General Organization Settings": "常规组织设置",
		"Settings menu": "设置菜单",
		"Menu": "菜单",
		"Select settings context": "选择设置范围",
		"Switch": "切换",
		"context": "上下文",
		// 设置范围切换器：`切换 <span>settings </span>上下文`。小写泛化词，只因为
		// 模块按路由限定在组织设置页才收（pages/settings 在同一句里早就收了同一个键）
		"settings": "设置",
		"People": "成员",
		"Insights": "洞察",
		// —— 组织设置侧栏 ——
		"Member privileges": "成员权限",
		"Repository policies": "仓库策略",
		"Repository roles": "仓库角色",
		"Organization roles": "组织角色",
		"Role assignments": "角色分配",
		"Role management": "角色管理",
		"Repository properties": "仓库属性",
		"Custom properties": "自定义属性",
		"Projects": "项目",
		"Configurations": "配置",
		"Caches": "缓存",
		"Code review": "代码审查",
		"Issue fields": "议题字段",
		"Issue types": "议题类型",
		"Ruleset dashboard": "规则集仪表板",
		"Ruleset insights": "规则集洞察",
		"Runner groups": "运行器组",
		"Authentication security": "身份验证安全",
		"Compliance": "合规",
		"Moderators": "版主",
		"Logs": "日志",
		"Audit log": "审计日志",
		"Active tokens": "活跃令牌",
		"Pending requests": "待处理的请求",
		"Private registries": "私有注册表",
		"Deleted repositories": "已删除的仓库",
		"OAuth app policy": "OAuth 应用策略",
		"OAuth Apps": "OAuth 应用",
		"Personal access tokens": "个人访问令牌",
		"Third-party Access": "第三方访问",
		"GitHub Apps": "GitHub 应用",
		"Publisher Verification": "发布者验证",
		"Verified and approved domains": "已验证且已批准的域名",
		"Sandboxes": "沙盒",
		"Import/Export": "导入/导出",
		"Scheduled reminders": "定时提醒",
		"Global settings": "全局设置",
		"Billing and licensing": "账单与许可",
		"Payment information": "付款信息",
		"Payment history": "付款历史",
		"Additional billing details": "其他账单详情",
		"Budgets and alerts": "预算与提醒",
		"AI usage": "AI 用量",
		"Sponsorship log": "赞助记录",
		"Licensing": "许可",
		"Usage": "用量",
		"Blocked users": "已屏蔽用户",
		"Developer settings": "开发者设置",
		// —— 组织设置侧栏的分组标题与其余条目（证据：2026-10-03 维护者贴的 Layout-sidebar）——
		// 除 `Pages` 外全部沿用 pages/settings 与 pages/repo-settings 的既有措辞：
		// 同一批侧栏项在两个模块里都出现，改词必须一起改。
		"General": "常规",
		"Policies": "策略",
		"Access": "访问权限",
		"Moderation": "审核",
		"Interaction limits": "互动限制",
		"Code review limits": "代码审查限制",
		"Code, planning, and automation": "代码、规划与自动化",
		"Rulesets": "规则集",
		"Planning": "规划",
		"Cloud agent": "云端代理",
		"Internet access": "网络访问",
		"Runner type": "运行器类型",
		"Policy insights": "策略洞察",
		"Runners": "运行器",
		"Webhooks": "网络钩子",
		"Packages": "软件包",
		// global 把 GitHub Pages 的 `Pages` 收成了「页码」，本模块在自己的路由上纠正为「页面」
		"Pages": "页面",
		"Security and quality": "安全与质量",
		"Advanced Security": "高级安全",
		"Code quality": "代码质量",
		"Deploy keys": "部署密钥",
		"Secrets and variables": "机密与变量",
		"Agents": "代理",
		"Integrations": "集成",
		"Archive": "归档",
		// 组织页的 `Actions` 与仓库设置同措辞（同一批侧栏项），排除注入后由本模块自己提供
		"Actions": "Actions 工作流",
		// —— 组织资料表单 ——
		"Organization display name": "组织显示名称",
		"Email (will be public)": "电子邮箱（将公开）",
		"Location": "位置",
		"URL": "网址",
		"Social accounts": "社交账号",
		"Social account": "社交账号",
		// Location 搜索框的占位符（属性只走精确命中，保持半角省略号与键同形）
		"Find a location...": "查找位置...",
		"Link to social profile 1": "社交资料链接 1",
		"Link to social profile 2": "社交资料链接 2",
		"Link to social profile 3": "社交资料链接 3",
		"Link to social profile 4": "社交资料链接 4",
		"Feature Release Label: Preview": "功能发布标签：预览版",
		"Feature Release Label: Public preview": "功能发布标签：公开预览版",
		// —— 账单邮箱与头像区块（证据：2026-10-03 维护者贴的实机 HTML）——
		"Billing email": "账单邮箱",
		// `<small>(Private)</small>` 是独立节点，与标签文本分开
		"(Private)": "（私密）",
		// 说明句被 `<a>billing page</a>` 拆开：链接在「请前往」之后，链接外的句点是纯符号节点
		// （引擎翻不了），实机拼作「要添加更多账单邮箱收件人，请前往 账单页面 .」
		"Add more billing email recipients in the": "要添加更多账单邮箱收件人，请前往",
		"billing page": "账单页面",
		"Gravatar email": "Gravatar 邮箱",
		"Sponsors update email": "赞助更新邮箱",
		"The developers and organizations that your organization sponsors can send you updates to this email.": "你的组织所赞助的开发者和组织可以向此邮箱发送更新。",
		// 头像上传器（与 pages/settings 的同键译文保持一致；两模块路径互斥）
		"Update profile": "更新资料",
		"Profile picture": "头像",
		"Upload new picture": "上传新图片",
		"Uploading...": "上传中...",
		"Note: To apply for a publisher verification your organization's profile picture should not be irrelevant, abusive or vulgar. It should not be a default image provided by GitHub.": "注意：申请发布者验证时，你组织的资料图片不应与组织无关，也不应包含辱骂或低俗内容，并且不能使用 GitHub 提供的默认图片。",
		"This file is empty.": "文件为空。",
		"Please upload a picture smaller than 1 MB.": "请上传小于 1 MB 的图片。",
		"Please upload a picture smaller than 10,000x10,000.": "请上传小于 10,000×10,000 的图片。",
		"We only support PNG, GIF, or JPG pictures.": "仅支持 PNG、GIF 或 JPG 图片。",
		"Something went really wrong and we can’t process that picture.": "出了点严重的问题，无法处理这张图片。",
		"File contents don’t match the file extension.": "文件内容与扩展名不符。",
		"Clear Location": "清除位置",
		// —— 产品内消息（In-product messages）——
		// 证据：2026-10-03 维护者贴的下半页实机 HTML（装了扩展后的渲染结果，
		// 页面里仍是英文的节点才是待补项）。开关状态与 pages/settings 同措辞。
		"In-product messages": "产品内消息",
		"Promotions": "推广",
		"Notify account admins about exclusive GitHub products, services, offers, and events.": "向账户管理员通知 GitHub 专属的产品、服务、优惠与活动。",
		"Member requests": "成员请求",
		"Allow members in your organization to request access to products, budget, or features.": "允许组织成员申请使用产品、预算或功能。",
		"Tips": "提示",
		"Show your organization members tips about enabled products and features.": "向组织成员展示关于已启用产品与功能的提示。",
		"Customer Research": "客户调研",
		"Allow GitHub to contact members in your organization for research and feedback surveys.": "允许 GitHub 就调研与反馈问卷联系你组织中的成员。",
		"On": "开启",
		"Off": "关闭",
		// —— Patreon 与 GitHub Developer Program ——
		"Link Patreon account": "关联 Patreon 账户",
		"Connect with Patreon": "关联 Patreon",
		// 说明句被 `<strong>@组织名</strong>` 拆开：第一段只剩一个介词，
		// 组织名之后接第二段，拼起来读作「为 @组织名 关联一个 Patreon 账户，用于赞助维护者。…」
		"Connect a Patreon account for": "为",
		"to sponsor maintainers with. Get recognition on GitHub for sponsorships made on Patreon when the sponsored person has linked Patreon and GitHub, too, and has a public GitHub Sponsors profile.": "关联一个 Patreon 账户，用于赞助维护者。当被赞助者同时关联了 Patreon 与 GitHub、并拥有公开的 GitHub Sponsors 个人资料时，你在 Patreon 上进行的赞助也会在 GitHub 上获得认可。",
		"GitHub Developer Program": "GitHub 开发者计划",
		"Building an application, service, or tool that integrates with GitHub?": "正在构建与 GitHub 集成的应用、服务或工具？",
		"Join the GitHub Developer Program": "加入 GitHub 开发者计划",
		// 链接之后的片段以逗号开头，实机拼作「…加入 GitHub 开发者计划，更多信息请见我们的 GitHub 开发者计划.」
		", or read more about it at our": "，更多信息请见我们的",
		"GitHub developer program": "GitHub 开发者计划",
		// —— 服务条款（Terms of Service）——
		"Terms of Service": "服务条款",
		"Standard": "标准版",
		"Best for individuals wanting the freedom to move data and remain independent of a corporation.": "适合希望自由迁移数据、保持独立于企业之外的个人。",
		"Read the Standard Terms of Service": "阅读标准版服务条款",
		"Corporate": "企业版",
		"Best for businesses that need to protect their intellectual property and secure visibility into their data.": "适合需要保护知识产权、并确保对自身数据拥有可见性的企业。",
		"Read the GitHub customer agreement": "阅读 GitHub 客户协议",
		"Sign GitHub customer terms": "签署 GitHub 客户条款",
		// 同一串既挂在 details-dialog 的 aria-label 上，也是对话框的 h3 标题
		"Accept GitHub customer agreement": "接受 GitHub 客户协议",
		"Do you want to give ownership of your organization to your business?": "你想将组织的所有权交给你的企业吗？",
		"Yes, I want to sign the GitHub customer agreement on behalf of my business.": "是的，我想代表我的企业签署 GitHub 客户协议。",
		"What is the name of the business that owns this account?": "拥有此账户的企业名称是什么？",
		// 企业名输入框的示例占位符（属性只走精确命中，键保持与实机同形）
		"e.g, Acme, Inc.": "例如：Acme 公司",
		"The name of the company that owns this account": "拥有此账户的公司名称",
		// `<span class="note">This business — not <strong>用户名</strong> (your user account), will own…</span>`
		"This business — not": "该企业——而不是",
		"(your user account), will own and/or control any content posted to the organization": "（你的用户账户），将拥有和/或控制发布到该组织的任何内容",
		"Accepting terms...": "正在接受条款...",
		"Accept terms": "接受条款",
		"By clicking “Accept terms”, you agree to the": "点击“接受条款”即表示你同意",
		"GitHub customer agreement": "GitHub 客户协议",
		"and the": "以及",
		"privacy statement": "隐私声明",
		// —— 客户协议里的企业账单信息表单 ——
		// 字段与 pages/settings-billing 的付款信息页同源，译文逐字沿用那边的措辞
		//（「某些国家/地区必填」「增值税号（VAT/GST ID）」「（美国为 9 位 ZIP 码）」等）。
		"GitHub's customer agreement requires you to transfer the ownership of your organization to your business. Enter your business details below to continue. You can change these at any time by accessing your organization’s billing information.": "GitHub 的客户协议要求你将组织的所有权转移给你的企业。请在下方填写你的企业详细信息以继续。你随时可以通过访问组织的账单信息来更改这些内容。",
		"Business/Institution name": "企业/机构名称",
		"VAT/GST ID": "增值税号（VAT/GST ID）",
		"Address": "地址",
		"(Street, P.O. box)": "（街道、邮政信箱）",
		"Address line 2": "地址第二行",
		"(Apartment, suite, unit)": "（公寓、套房、单元）",
		"City": "城市",
		"Country/Region": "国家/地区",
		"Choose your country/region": "选择你的国家/地区",
		"State/Province": "州/省",
		// 州 / 省下拉的首项（美 / 加两份 select 各一条），选项名本身一律不收
		"Select state": "选择州",
		"Select province": "选择省",
		"Required for certain countries": "某些国家/地区必填",
		"Postal/Zip code": "邮政编码",
		"(9-digit zip code for US)": "（美国为 9 位 ZIP 码）",
		"I agree to the": "我同意",
		"Corporate Terms of Service": "企业服务条款",
		// 表单右侧 reset 按钮的小写原文；模块只在该路由生效，误伤面限于组织设置页
		"cancel": "取消",
		// —— 危险区域：重命名 / 归档 / 删除三个对话框 ——
		// 实机渲染是小写 `Danger zone`（不是 pages/settings 的 `Danger Zone`），键必须同形。
		"Danger zone": "危险区域",
		"Rename organization": "重命名组织",
		// `<p>Renaming your organization can have <a>unintended side effects</a>.</p>`
		"Renaming your organization can have": "重命名组织可能会带来",
		"unintended side effects": "意料之外的副作用",
		"Rename your organization?": "要重命名你的组织吗？",
		"Unexpected bad things will happen if you don’t read this!": "如果你没有读完这段内容，可能会发生意想不到的糟糕事情！",
		// `<li>We <strong>will</strong> create redirects…</li>`：三个节点必须分别命中
		"We": "我们",
		"will": "将",
		"create redirects for your repositories (web and git access).": "为你的仓库创建重定向（Web 与 Git 访问）。",
		"You will need to update your local repositories to point to the new location.": "你需要更新本地仓库，使其指向新的位置。",
		"Renaming may take a few minutes to complete.": "重命名可能需要几分钟才能完成。",
		"Enter a new name": "输入新名称",
		"Change organization’s name": "更改组织名称",
		// 归档对话框：h1 标题与按钮文案是两串不同的原文
		"Archive organization": "归档组织",
		"Archive this organization": "归档此组织",
		"This organization will be archived.": "此组织将被归档。",
		"Modifying settings will be limited and creating new repositories will be blocked.": "修改设置将受到限制，并且无法创建新仓库。",
		// `<p>All repositories will be <a>archived</a> and be read-only.</p>`
		"All repositories will be": "所有仓库都将被",
		"archived": "归档",
		"and be read-only.": "并变为只读。",
		"Before you archive, please consider:": "归档之前，请考虑：",
		"Updating any organization settings": "更新任何组织设置",
		// `<li>Making a note in your <a>organization README</a></li>`
		"Making a note in your": "在你的",
		"organization README": "组织 README",
		// `<p>Please type <strong>组织名</strong> to confirm.</p>`
		"Please type": "请输入",
		"to confirm.": "以确认。",
		"Type in the name of the organization to confirm that you want to archive this organization.": "输入组织名称，以确认你要归档此组织。",
		"I understand the consequences, archive this organization": "我了解相应后果，归档此组织",
		"Mark this organization and all its repositories as archived and read-only.": "将此组织及其所有仓库标记为已归档且只读。",
		// 删除对话框：按钮与小节标题同串；表单的 aria-label 是另一串
		"Delete this organization": "删除此组织",
		"Are you sure you want to delete this?": "你确定要删除此内容吗？",
		"Delete organization": "删除组织",
		// `<p>Deleting the <strong>组织名</strong> organization will delete… The <strong>组织名</strong> username will…</p>`
		"Deleting the": "删除",
		"organization will delete all of its repositories. The": "组织会同时删除其所有仓库，并且该",
		"username will be unavailable for 90 days.": "用户名将在 90 天内不可用。",
		"Before proceeding, please be sure to review the": "在继续之前，请务必查阅",
		"regarding account deletion.": "有关账户删除的规定。",
		"Enter this organization’s name to confirm": "输入此组织的名称以确认",
		"Cancel plan and delete the organization": "取消方案并删除组织",
		"Once deleted, it will be gone forever. Please be certain.": "一旦删除，它将永远消失。请务必确认。",
		// —— 仓库策略页 ——
