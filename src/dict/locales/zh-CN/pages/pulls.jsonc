// 拉取请求模块：/owner/repo/pull 与 /pulls（列表与详情页）专属词条
// 路由同时覆盖详情页（/pull/<编号>）与列表页（/pulls）
// 简体中文 · 模块 pages/pulls（路由见 core/modules.jsonc，键的分组注释见 core/canonical.jsonc）
{
	"$schema": "../../../types/dict.schema.json",
	"entries": {
		"Conversation": "对话",
		"Checks": "检查",
		"Files changed": "文件变更",
